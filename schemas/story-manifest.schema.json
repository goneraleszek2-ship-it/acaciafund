{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcaciaFund Story Manifest",
  "type": "object",
  "required": [
    "manifest_type",
    "content_id",
    "pillar",
    "title",
    "date",
    "source_urls",
    "story_count",
    "signals",
    "bloom_levels",
    "questions_count",
    "flashcards_count",
    "assets",
    "lineage",
    "created_at",
    "published_at",
    "version",
    "quality_flags"
  ],
  "properties": {
    "manifest_type": {"const": "story"},
    "content_id": {"type": "string"},
    "pillar": {"type": "string"},
    "title": {"type": "string"},
    "date": {"type": "string"},
    "source_urls": {"type": "array"},
    "story_count": {"type": "integer"},
    "signals": {"type": "object"},
    "bloom_levels": {"type": "array"},
    "questions_count": {"type": "integer"},
    "flashcards_count": {"type": "integer"},
    "assets": {"type": "array"},
    "lineage": {"type": "object"},
    "created_at": {"type": "string"},
    "published_at": {"type": "string"},
    "version": {"type": "integer"},
    "quality_flags": {"type": "array"},
    "checksum": {"type": "string"},
    "source_breakdown": {
      "type": "object",
      "description": "Count of stories from each source (hn, arxiv, pubmed, etc.)",
      "additionalProperties": {"type": "integer"}
    },
    "quality_metrics": {
      "type": "object",
      "description": "Quality metrics for the content",
      "properties": {
        "avg_source_score": {"type": "number"},
        "source_diversity": {"type": "number"},
        "recency_score": {"type": "number"}
      }
    }
  }
}
