title: AcaciaFund System Architecture

flowchart TD
    subgraph Users["👤 Users"]
        U[Browser / Visitor]
    end

    subgraph CDN["🌐 Cloudflare"]
        CF[Cloudflare CDN]
    end

    subgraph Pipeline["⚙️ Build Pipeline"]
        GIT[GitHub Repository
          main branch] --> CFW[Cloudflare Pages]
        CFW --> BUILD[python3 generator.py]
        BUILD --> REG[registry.json
          Content Catalog]
        BUILD --> SCHEMA[schemas.py
          Validation]
        BUILD --> VIZ[core/visuals.py
          SVG Generation]
        BUILD --> TMPL[templates/*.j2
          Jinja2 Rendering]
        BUILD --> DIST[dist/ directory
          Static HTML]
    end

    subgraph Output["📄 Generated Output"]
        DIST --> PAGES[236 Static Pages]
        PAGES --> RESEARCH[33 Research Articles]
        PAGES --> LEARN[16 Learn Items]
        PAGES --> KNOWLEDGE[11 Knowledge Pages]
        PAGES --> TAGS[166 Tag Archives]
        PAGES --> SEARCH[Search Index]
        PAGES --> FEED[RSS Feed]
    end

    U --> CF
    CFW --> CF
    GIT --> CFW

    style U fill:#1e3a5f,stroke:#d97706
    style GIT fill:#1e293b,stroke:#64748b
