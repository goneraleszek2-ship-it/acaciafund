@startuml
subgraph Sources
        node HN: "HackerNews API"
        node ARXIV: "arXiv API"
        node PUBMED: "PubMed"
    end

    subgraph Curation
        node MANUAL: "Manual Curation"
        node SEED: "seed_articles.py"
        node NLP: "NLP Processing — Entities / Summaries"
    end

    subgraph Enrichment
        node BLOOM: "Bloom Taxonomy — Classification"
        node SQI: "Signal Quality Index — 0.0 — 1.0"
        node DIV: "Source Diversity — Score"
        node DOMAIN: "Domain Breakdown"
    end

    subgraph Registry
        node REG: "registry.json"
    end

    HN --> SEED
    ARXIV --> SEED
    PUBMED --> SEED
    SEED --> REG
    MANUAL --> REG
    REG --> NLP
    NLP --> BLOOM
    NLP --> SQI
    NLP --> DIV
    REG --> DOMAIN

    style HN fill:#1e3a5f,stroke:#d97706,color:#fff
    style ARXIV fill:#1e293b,stroke:#64748b,color:#fff
    style PUBMED fill:#1e293b,stroke:#64748b,color:#fff
    style REG fill:#0f172a,stroke:#22c55e,color:#fff
@enduml