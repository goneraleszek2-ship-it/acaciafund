title: Source Framework — Registry, Fetchers & Health

flowchart TD
    subgraph Config["Configuration"]
        TOML[etc/sources.toml — 14 sources configured]
    end

    subgraph Registry["Source Registry"]
        REG[SourceRegistry — singleton]
        LOAD[tomllib.load — lazy init]
        CACHE[cached per session]
    end

    subgraph Base["BaseFetcher ABC"]
        ABC[BaseFetcher]
        SC[SourceConfig — TOML to dataclass]
        FR[FetchResult]
        HR[HealthRecord]
    end

    subgraph Fetchers["Concrete Fetchers"]
        HN[HNFetcher — wraps fetch_hn_stories]
        ARXIV[ArxivFetcher — wraps fetch_arxiv]
        PUBMED[PubMedFetcher — wraps fetch_pubmed]
        SS[SemanticScholar — wraps fetch_semantic_scholar]
        RSS[RSSFetcher — xml.etree / Atom + RSS]
    end

    subgraph Observability["Observability"]
        HEALTH[source-health.json — last 100 records/source]
        DLQ[Dead Letter Queue — failed fetches persisted]
    end

    subgraph Admin["Admin Panel"]
        SOURCES_PAGE[/admin/sources — health dashboard]
        API_REFRESH[/admin/api/{name}/refresh — POST live fetch]
        API_HEALTH[/admin/api/{name}/health — GET history]
    end

    TOML --> REG
    REG --> LOAD
    LOAD --> ABC
    ABC --> SC
    ABC --> HN
    ABC --> ARXIV
    ABC --> PUBMED
    ABC --> SS
    ABC --> RSS
    HN --> DLQ
    ARXIV --> DLQ
    PUBMED --> DLQ
    SS --> DLQ
    RSS --> DLQ
    HN --> HEALTH
    ARXIV --> HEALTH
    PUBMED --> HEALTH
    SS --> HEALTH
    RSS --> HEALTH
    HEALTH --> SOURCES_PAGE
    DLQ --> API_REFRESH
    HEALTH --> API_HEALTH
    REG --> CACHE

    style TOML fill:#0f172a,stroke:#d97706
    style REG fill:#1e3a5f,stroke:#22c55e
    style ABC fill:#1e293b,stroke:#64748b
