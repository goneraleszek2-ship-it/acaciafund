@startuml
subgraph Config
        node TOML: "etc/sources.toml — 14 sources configured"
    end

    subgraph Registry
        node REG: "SourceRegistry — singleton"
        node LOAD: "tomllib.load — lazy init"
        node CACHE: "cached per session"
    end

    subgraph Base
        node ABC: "BaseFetcher"
        node SC: "SourceConfig — TOML → dataclass"
        node FR: "FetchResult"
        node HR: "HealthRecord"
    end

    subgraph Fetchers
        node HN: "HNFetcher — wraps fetch_hn_stories"
        node ARXIV: "ArxivFetcher — wraps fetch_arxiv"
        node PUBMED: "PubMedFetcher — wraps fetch_pubmed"
        node SS: "SemanticScholar — wraps fetch_semantic_scholar"
        node RSS: "RSSFetcher — xml.etree / Atom + RSS"
    end

    subgraph Observability
        node HEALTH: "source-health.json — last 100 records/source"
        node DLQ: "Dead Letter Queue — failed fetches persisted"
    end

    subgraph Admin
        node SOURCES_PAGE: "/admin/sources — health dashboard"
        node API_REFRESH: "/admin/api/{name}/refresh — POST live fetch"
        node API_HEALTH: "/admin/api/{name}/health — GET history"
    end

    TOML --> REG
    REG --> LOAD
    LOAD --> ABC
    ABC --> SC
    ABC --> HN
    ABC --> ARXIV
    ABC --> PUBMED
    ABC --> SS
    ABC --> RSS
    HN --> DLQ
    ARXIV --> DLQ
    PUBMED --> DLQ
    SS --> DLQ
    RSS --> DLQ
    HN --> HEALTH
    ARXIV --> HEALTH
    PUBMED --> HEALTH
    SS --> HEALTH
    RSS --> HEALTH
    HEALTH --> SOURCES_PAGE
    DLQ --> API_REFRESH
    HEALTH --> API_HEALTH
    REG --> CACHE

    style TOML fill:#0f172a,stroke:#d97706
    style REG fill:#1e3a5f,stroke:#22c55e
    style ABC fill:#1e293b,stroke:#64748b
    style HEALTH fill:#166534,stroke:#22c55e
    style DLQ fill:#7f1d1d,stroke:#ef4444
    style SOURCES_PAGE fill:#1e3a5f,stroke:#3b82f6
@enduml