# AcaciaFund API — Environment Variables
# Copy to .env or set in Railway dashboard

# Database path (SQLite file location)
# Railway: use a persistent volume path, e.g. /data/progress.db
ACACIA_DB_PATH=/data/progress.db

# CORS allowed origins (comma-separated)
# Add your production domain when deployed
ACACIA_CORS_ORIGINS=http://localhost:1313,http://127.0.0.1:1313,https://www.acaciafund.org

# Debug mode
ACACIA_DEBUG=false

# Host / port (usually not needed on Railway)
ACACIA_HOST=0.0.0.0
ACACIA_PORT=8000
