{
  "version": "1.0",
  "name": "AcaciaFund Analytics Dashboard",
  "description": "Comprehensive analytics dashboard for AcaciaFund content performance",
  "layout": {
    "type": "grid",
    "width": 12,
    "height": 8,
    "gutter": 16
  },
  "dataSources": {
    "articles": {
      "type": "dataset",
      "query": "SELECT slug, title, content_type, pillar, created_at FROM articles"
    },
    "signals": {
      "type": "dataset",
      "query": "SELECT avg_sqi, avg_score, count FROM signals"
    },
    "images": {
      "type": "dataset",
      "query": "SELECT source_api, relevance_score FROM section_images"
    }
  },
  "filters": [
    {
      "id": "pillar_filter",
      "type": "dropdown",
      "label": "Pillar",
      "options": [
        {"value": "all", "label": "All Pillars"},
        {"value": "stock", "label": "Stock"},
        {"value": "aml", "label": "AML"},
        {"value": "data-engineering", "label": "Data Engineering"}
      ],
      "default": "all",
      "binding": {
        "dataset": "articles",
        "column": "pillar",
        "operator": "equals"
      }
    },
    {
      "id": "content_type_filter",
      "type": "dropdown",
      "label": "Content Type",
      "options": [
        {"value": "all", "label": "All Types"},
        {"value": "research", "label": "Research"},
        {"value": "learn", "label": "Learn"},
        {"value": "knowledge", "label": "Knowledge"}
      ],
      "default": "all",
      "binding": {
        "dataset": "articles",
        "column": "content_type",
        "operator": "equals"
      }
    },
    {
      "id": "date_range_filter",
      "type": "date_range",
      "label": "Date Range",
      "default": {
        "start": "30_days_ago",
        "end": "today"
      },
      "binding": {
        "dataset": "articles",
        "column": "created_at",
        "operator": "between"
      }
    },
    {
      "id": "sqi_bucket_filter",
      "type": "dropdown",
      "label": "SQI Bucket",
      "options": [
        {"value": "all", "label": "All Buckets"},
        {"value": "high", "label": "High (0.6-1.0)"},
        {"value": "medium", "label": "Medium (0.3-0.6)"},
        {"value": "low", "label": "Low (0.0-0.3)"}
      ],
      "default": "all",
      "binding": {
        "dataset": "signals",
        "column": "avg_sqi",
        "operator": "between",
        "buckets": [
          {"name": "high", "min": 0.6, "max": 1.0},
          {"name": "medium", "min": 0.3, "max": 0.6},
          {"name": "low", "min": 0.0, "max": 0.3}
        ]
      }
    }
  ],
  "cards": [
    {
      "id": "sqi_distribution",
      "type": "histogram",
      "title": "SQI Distribution",
      "position": {"x": 0, "y": 0, "width": 4, "height": 3},
      "dataBinding": {
        "dataset": "signals",
        "xAxis": "avg_sqi",
        "yAxis": "count",
        "binSize": 0.1
      },
      "options": {
        "color": "#4F46E5",
        "showAverage": true,
        "bins": 10
      }
    },
    {
      "id": "cross_pillar_heatmap",
      "type": "heatmap",
      "title": "Cross-Pillar Heatmap",
      "position": {"x": 4, "y": 0, "width": 4, "height": 3},
      "dataBinding": {
        "dataset": "articles",
        "rows": "pillar",
        "columns": "content_type",
        "measure": "count"
      },
      "options": {
        "colorScale": "blue-red",
        "showValues": true,
        "sortBy": "total"
      }
    },
    {
      "id": "source_quality",
      "type": "scatter_plot",
      "title": "Source Quality",
      "position": {"x": 8, "y": 0, "width": 4, "height": 3},
      "dataBinding": {
        "dataset": "images",
        "xAxis": "source_api",
        "yAxis": "relevance_score",
        "size": "count"
      },
      "options": {
        "color": "#059669",
        "showTrendLine": true
      }
    },
    {
      "id": "content_growth",
      "type": "time_series",
      "title": "Content Growth",
      "position": {"x": 0, "y": 3, "width": 6, "height": 3},
      "dataBinding": {
        "dataset": "articles",
        "timeColumn": "created_at",
        "metrics": [
          {"field": "count", "label": "Articles Created"},
          {"field": "distinct_pillars", "label": "Active Pillars"}
        ],
        "aggregation": "day"
      },
      "options": {
        "stacked": false,
        "showMovingAverage": true,
        "movingAveragePeriods": 7
      }
    },
    {
      "id": "high_quality_articles",
      "type": "table",
      "title": "High-Quality Articles (SQI >= 0.6)",
      "position": {"x": 6, "y": 3, "width": 6, "height": 3},
      "dataBinding": {
        "dataset": "articles",
        "join": "signals",
        "on": "slug",
        "filter": "avg_sqi >= 0.6",
        "columns": ["slug", "title", "pillar", "content_type", "avg_sqi", "created_at"],
        "orderBy": "avg_sqi DESC",
        "limit": 10
      },
      "options": {
        "sortable": true,
        "searchable": true,
        "drilldown": {
          "enabled": true,
          "levels": [
            {"field": "slug", "target": "article_details"},
            {"field": "pillar", "target": "section_images"},
            {"field": "content_type", "target": "related_content"}
          ]
        }
      }
    }
  ],
  "interactions": {
    "drilldown": {
      "enabled": true,
      "maxDepth": 3,
      "paths": {
        "article": {
          "slug": "article_details",
          "parent": null
        },
        "section": {
          "pillar": "section_images",
          "parent": "article"
        },
        "image": {
          "source_api": "image_details",
          "parent": "section"
        }
      }
    },
    "crossFiltering": {
      "enabled": true,
      "autoApply": false,
      "clearOnReset": true
    }
  },
  "exportOptions": {
    "includeFilters": true,
    "includeTimeRange": true,
    "csvDelimiter": ",",
    "maxRows": 10000
  }
}
