{
  "include": ["."],
  "exclude": [
    "**/scripts/archive",
    "venv",
    ".venv-test",
    ".git",
    ".pytest_cache",
    ".ruff_cache",
    "dist",
    "node_modules",
    "static",
    "registry",
    "content",
    "docs",
    "data",
    "etc",
    ".registry_versions",
    ".registry-archive",
    ".registry_backups",
    ".cache"
  ],
  "venvPath": "/root/acaciafund",
  "venv": "venv",
  "extraPaths": ["/root/services", "services"],
  "reportMissingImports": "none",
  "typeCheckingMode": "standard"
}
