{% extends "layout.j2" %}
{% block main_content %}
<nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="hover-accent transition">Home</a></li>
    <li aria-hidden="true">/</li>
    <li aria-current="page">Review Dashboard</li>
  </ol>
</nav>

<header class="mb-8">
  <h1 class="text-3xl font-extrabold text-default">Review Dashboard</h1>
  <p class="mt-2 text-sm text-muted">Spaced repetition tracking for flashcards and ontology concepts across all pillars.</p>
</header>

<div class="flex gap-1 mb-6 p-1 rounded-lg bg-bg border-default" role="tablist" aria-label="Review mode">
  <button class="review-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="true" data-tab="all" style="background:var(--color-surface);color:var(--color-text)">All</button>
  <button class="review-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="false" data-tab="flashcards" style="color:var(--color-text-muted)">Flashcards</button>
  <button class="review-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="false" data-tab="concepts" style="color:var(--color-text-muted)">Concepts</button>
  <button class="review-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="false" data-tab="feynman" style="color:var(--color-text-muted)">Feynman</button>
</div>

<div id="review-flashcard-section">
  <div class="grid gap-6 sm:grid-cols-3 mb-8 entrance-stagger" data-reveal>
  <div class="ghost-card p-6 text-center">
    <div id="stat-due" class="text-4xl font-bold text-accent">0</div>
    <div class="text-xs font-meta mt-1 text-muted">Cards Due</div>
  </div>
  <div class="ghost-card p-6 text-center">
    <div id="stat-streak" class="text-4xl font-bold" style="color:#22c55e">0</div>
    <div class="text-xs font-meta mt-1 text-muted">Day Streak</div>
  </div>
  <div class="ghost-card p-6 text-center">
    <div id="stat-mastered" class="text-4xl font-bold" style="color:#3b82f6">0</div>
    <div class="text-xs font-meta mt-1 text-muted">Mastered</div>
  </div>
</div>

<section class="mb-8">
  <h2 class="text-lg font-semibold mb-4 text-default">Activity (last 90 days)</h2>
  <div id="heatmap" class="flex flex-wrap gap-1" role="img" aria-label="Review activity heatmap"></div>
</section>

<section class="mb-8">
  <h2 class="text-lg font-semibold mb-4 text-default">Due by Pillar</h2>
  <div class="grid gap-4 sm:grid-cols-3" id="pillar-due">
    <div class="ghost-card p-4 text-center">
      <div class="text-2xl font-bold" style="color:#ef4444">0</div>
      <div class="text-xs text-muted">Compliance</div>
    </div>
    <div class="ghost-card p-4 text-center">
      <div class="text-2xl font-bold" style="color:#f59e0b">0</div>
      <div class="text-xs text-muted">Markets</div>
    </div>
    <div class="ghost-card p-4 text-center">
      <div class="text-2xl font-bold" style="color:#3b82f6">0</div>
      <div class="text-xs text-muted">Data Engineering</div>
    </div>
  </div>
</section>

<div class="text-center">
  <a href="/review/queue/" class="btn btn-primary inline-flex items-center gap-2">
    <svg class="icon-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
    Start Review
  </a>
</div>
</div>

<hr class="my-8 border-muted">

<div id="review-concept-section">
<section>
  <h2 class="text-xl font-extrabold mb-2 text-default">Concept Mastery</h2>
  <p class="text-sm mb-6 text-muted">Track retention of all 70+ ontology concepts across pillars. Includes gap detection and interleaved practice.</p>
  <div id="concept-mastery-dashboard"></div>
</section>
</div>

<div id="review-path-section">
<section>
  <h2 class="text-xl font-extrabold mb-2 text-default">My Learning Path</h2>
  <p class="text-sm mb-6 text-muted">Concepts you have saved from concept pages, with review status from your mastery data.</p>
  <div id="my-path-list"></div>
</section>
</div>

<div id="review-feynman-section" style="display:none">
<section>
  <h2 class="text-xl font-extrabold mb-2 text-default">Feynman Technique</h2>
  <p class="text-sm mb-6 text-muted">Deepen understanding by explaining concepts in your own words — ELI5, teach-back, analogies, gap-finding, and build exercises. Self-assess after each attempt.</p>
  <div id="feynman-mode-selector" class="flex flex-wrap gap-2 mb-6">
    <button data-feynman-mode="eli5" class="feynman-mode-btn px-4 py-2 text-xs font-semibold rounded-lg transition" style="background:#22c55e;color:#fff">Explain Like I'm 5</button>
    <button data-feynman-mode="teach_back" class="feynman-mode-btn px-4 py-2 text-xs font-semibold rounded-lg transition" style="background:#3b82f6;color:#fff">Teach Back</button>
    <button data-feynman-mode="analogy_map" class="feynman-mode-btn px-4 py-2 text-xs font-semibold rounded-lg transition" style="background:#f59e0b;color:#fff">New Analogy</button>
    <button data-feynman-mode="gap_find" class="feynman-mode-btn px-4 py-2 text-xs font-semibold rounded-lg transition" style="background:#ef4444;color:#fff">Find Gaps</button>
    <button data-feynman-mode="build_it" class="feynman-mode-btn px-4 py-2 text-xs font-semibold rounded-lg transition" style="background:#8b5cf6;color:#fff">Build It</button>
  </div>
  <div id="feynman-mastery-bars" class="mb-6">
    <h3 class="text-sm font-semibold mb-3 text-default">Feynman Mastery (SM-2 + mode completion bonus)</h3>
    <div id="feynman-mastery-container" class="space-y-3"></div>
  </div>
  <div class="text-center">
    <button id="start-feynman-session" class="btn btn-primary inline-flex items-center gap-2">
    <svg class="icon-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
      Start Feynman Practice
    </button>
  </div>
</section>
</div>

<script src="{{ 'js/retention.js' | asset }}" defer></script>
<script>
(function() {
  const cards = {{ flashcard_cards | safe }};
  const SM2_KEY = 'acacia_sm2';
  const HIST_KEY = 'acacia_review_history';

  let sm2 = {};
  try { sm2 = JSON.parse(localStorage.getItem(SM2_KEY) || '{}'); } catch(_) {}

  let hist = [];
  try { hist = JSON.parse(localStorage.getItem(HIST_KEY) || '[]'); } catch(_) {}

  const now = Date.now();
  let due = 0, learning = 0, mastered = 0;
  const pillarDue = { aml: 0, stock: 0, 'data-engineering': 0 };

  for (const c of cards) {
    const s = sm2[c.id] || { reps: 0, interval: 0, due: 0 };
    if (s.due <= now) {
      due++;
      pillarDue[c.pillar] = (pillarDue[c.pillar] || 0) + 1;
    } else if (s.reps > 0 && s.interval < 21) learning++;
    else if (s.reps > 0) mastered++;
  }

  document.getElementById('stat-due').textContent = due;
  document.getElementById('stat-mastered').textContent = mastered;

  let streak = 0;
  if (hist.length) {
    const today = new Date().toISOString().slice(0, 10);
    const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
    if (hist.includes(today) || hist.includes(yesterday)) {
      let d = hist.includes(today) ? new Date() : new Date(Date.now() - 86400000);
      while (hist.includes(d.toISOString().slice(0, 10))) {
        streak++;
        d = new Date(d.getTime() - 86400000);
      }
    }
  }
  document.getElementById('stat-streak').textContent = streak;

  const pillarCards = document.getElementById('pillar-due').children;
  const pkeys = ['aml', 'stock', 'data-engineering'];
  for (let i = 0; i < 3; i++) {
    pillarCards[i].querySelector('div:first-child').textContent = pillarDue[pkeys[i]] || 0;
  }

  const heatmap = document.getElementById('heatmap');
  const today = new Date();
  for (let i = 89; i >= 0; i--) {
    const d = new Date(today.getTime() - i * 86400000);
    const key = d.toISOString().slice(0, 10);
    const active = hist.includes(key);
    const cell = document.createElement('div');
    cell.title = key;
    cell.style.cssText = 'width:12px;height:12px;border-radius:2px;' +
      (active ? 'background:var(--color-accent)' : 'background:var(--color-border)');
    cell.setAttribute('aria-label', key + (active ? ' (reviewed)' : ''));
    heatmap.appendChild(cell);
  }
})();

document.addEventListener('DOMContentLoaded', function() {
  if (window.AcaciaRetention) {
    var feynmanEngine = new AcaciaRetention();
    feynmanEngine.loadConceptData().then(function() {
      var feynmanMasteryContainer = document.getElementById('feynman-mastery-container');
      if (feynmanMasteryContainer) {
        var breakdown = feynmanEngine.getPillarBreakdown();
        var feynmanHistory = JSON.parse(localStorage.getItem('acacia_feynman_history') || '[]');
        var html = '';
        for (var pKey in breakdown) {
          var p = breakdown[pKey];
          var pillarInfo = { aml: { label: 'Compliance', color: '#ef4444' }, stock: { label: 'Markets', color: '#f59e0b' }, 'data-engineering': { label: 'Data Engineering', color: '#3b82f6' } }[pKey] || { label: pKey, color: '#6366f1' };
          var masteredCount = p.mastered || 0;
          var pct = p.total ? Math.round((masteredCount / p.total) * 100) : 0;
          html += '<div class="ghost-card p-3"><div class="flex items-center justify-between mb-1"><span class="text-xs font-semibold" style="color:' + pillarInfo.color + '">' + pillarInfo.label + '</span><span class="text-xs" style="color:var(--color-text-muted)">' + feynmanHistory.filter(function(h) { return h.quality >= 3; }).length + ' quality attempts</span></div><div class="h-2 rounded-full overflow-hidden" style="background:color-mix(in srgb, ' + pillarInfo.color + ' 15%, transparent)"><div class="h-full rounded-full transition-all" style="width:' + pct + '%;background:' + pillarInfo.color + '"></div></div><div class="flex justify-between mt-1"><span class="text-[10px]" style="color:var(--color-text-muted)">Feynman mode mastery</span><span class="text-[10px]" style="color:' + pillarInfo.color + '">' + pct + '%</span></div></div>';
        }
        feynmanMasteryContainer.innerHTML = html;
      }

      document.getElementById('start-feynman-session').addEventListener('click', function() {
        var selectedMode = document.querySelector('.feynman-mode-btn.active')?.dataset.feynmanMode || null;
        var items = [];
        var concepts = feynmanEngine.concepts;
        var feynmanHistory = JSON.parse(localStorage.getItem('acacia_feynman_history') || '[]');
        if (selectedMode) {
          for (var i = 0; i < concepts.length; i++) {
            var feynmanItems = feynmanEngine.generateFeynmanReviewItems(concepts[i]);
            for (var j = 0; j < feynmanItems.length; j++) {
              if (feynmanItems[j].mode === selectedMode) items.push(feynmanItems[j]);
            }
          }
          feynmanEngine.startFeynmanSession(items, 'Feynman: ' + selectedMode);
        } else {
          for (var i = 0; i < concepts.length; i++) {
            var mode = feynmanEngine.selectFeynmanMode(concepts[i], feynmanHistory);
            var feynmanItems = feynmanEngine.generateFeynmanReviewItems(concepts[i]);
            var match = null;
            for (var j = 0; j < feynmanItems.length; j++) {
              if (feynmanItems[j].mode === mode) { match = feynmanItems[j]; break; }
            }
            if (match) items.push(match);
          }
          feynmanEngine.startFeynmanSession(items, 'Adaptive Feynman');
        }
      });

      document.querySelectorAll('.feynman-mode-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.feynman-mode-btn').forEach(function(b) { b.classList.remove('active'); b.style.opacity = '0.6'; });
          this.classList.add('active');
          this.style.opacity = '1';
        });
      });
    });
  }
});

document.querySelectorAll('.review-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('.review-tab').forEach(function(t) {
      t.style.background = '';
      t.style.color = 'var(--color-text-muted)';
      t.setAttribute('aria-selected', 'false');
    });
    this.style.background = 'var(--color-surface)';
    this.style.color = 'var(--color-text)';
    this.setAttribute('aria-selected', 'true');
    var mode = this.dataset.tab;
    var flashcardSec = document.getElementById('review-flashcard-section');
    var conceptSec = document.getElementById('review-concept-section');
    var feynmanSec = document.getElementById('review-feynman-section');
    var pathSec = document.getElementById('review-path-section');
    if (mode === 'all') {
      flashcardSec.style.display = ''; conceptSec.style.display = ''; feynmanSec.style.display = ''; pathSec.style.display = '';
    } else if (mode === 'flashcards') {
      flashcardSec.style.display = ''; conceptSec.style.display = 'none'; feynmanSec.style.display = 'none'; pathSec.style.display = 'none';
    } else if (mode === 'concepts') {
      flashcardSec.style.display = 'none'; conceptSec.style.display = ''; feynmanSec.style.display = 'none'; pathSec.style.display = '';
    } else if (mode === 'feynman') {
      flashcardSec.style.display = 'none'; conceptSec.style.display = 'none'; feynmanSec.style.display = ''; pathSec.style.display = 'none';
    }
  });
});
</script>

{% include 'partials/newsletter.html' %}
{% endblock %}