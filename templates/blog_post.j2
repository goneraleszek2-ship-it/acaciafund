{% extends "layout.j2" %}
{% block main_content %}
<div id="reading-progress" style="position:fixed;top:0;left:0;height:3px;z-index:9999;width:0%;background:var(--color-accent)"></div>

<div class="flex gap-8 {% if toc_items %}lg:flex-row{% endif %} flex-col">
  {%- if toc_items %}
  <aside class="toc-sidebar shrink-0 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto lg:w-56">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-text-muted)">On this page</h2>
      <button id="focus-toggle" class="text-xs px-2 py-1 rounded" style="color:var(--color-text-muted);background:var(--color-bg)" title="Focus mode" aria-label="Toggle focus mode">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4h4M6 20h4M18 4h-4M18 20h-4M4 6v4M4 18v4M20 6v4M20 18v4"/></svg>
      </button>
    </div>
    <nav aria-label="Table of contents">
      <ul class="space-y-1 text-sm">
        {%- for item in toc_items %}
        <li>
          <a href="#{{ item.id }}" class="toc-link block py-1 {% if item.tag == 'h3' %}pl-4 text-xs{% endif %} rounded px-2 transition" style="color:var(--color-text-muted)">
            {{ item.text }}
          </a>
        </li>
        {%- endfor %}
      </ul>
    </nav>
  </aside>
  {%- endif %}

  <article class="min-w-0 flex-1">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs" style="color:var(--color-text-muted)">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-accent)] transition">Home</a></li>
        <li aria-hidden="true">/</li>
        {%- set pillar_key = content.pillar or "aml" %}
        {%- set pc = pillar_config.get(pillar_key, pillar_config["aml"]) %}
        <li><a href="/{{ pillar_key }}/" class="hover:text-[var(--color-accent)] transition">{{ pc.label }}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="truncate max-w-[200px]">{{ content.title | striptags }}</li>
      </ol>
    </nav>
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold rounded-full {{ pc.badge_color }}">
          {{ pc.emoji }} {{ pc.label }}
        </span>
        {%- if content.signals and content.signals.get("avg_sqi") is defined %}
        <span class="text-xs text-gray-400 font-mono" title="Signal Quality Index">
          SQI {{ "%.3f"|format(content.signals.get("avg_sqi", 0)) }}
        </span>
        {%- endif %}
        {%- if content.source_breakdown %}
        <span class="text-xs text-gray-400">
          {{ content.source_breakdown.get("hn", 0) }} HN
          {%- if content.source_breakdown.get("arxiv", 0) > 0 %} · {{ content.source_breakdown["arxiv"] }} arXiv{% endif %}
          {%- if content.source_breakdown.get("pubmed", 0) > 0 %} · {{ content.source_breakdown["pubmed"] }} PubMed{% endif %}
        </span>
        {%- endif %}
      </div>
      <h1 class="text-3xl font-extrabold text-gray-900 leading-tight">{{ content.title | striptags }}</h1>
      {%- if content.date_str %}
      <time class="mt-2 block text-sm text-gray-500" datetime="{{ content.date_str }}">{{ content.date_str }}
        {%- if content.body_html %} · {{ content.body_html | reading_time }} min read{% endif %}
      </time>
      {%- endif %}
      {%- if content.tags and content.tags | length > 0 %}
      <div class="mt-3 flex flex-wrap gap-2">
        {%- for tag in content.tags %}
        <span class="inline-block px-2 py-0.5 text-xs font-medium rounded bg-gray-100 text-gray-700">{{ tag }}</span>
        {%- endfor %}
      </div>
      {%- endif %}
    </header>

    {%- if content.quality_metrics and content.quality_metrics.get("avg_source_score") is defined %}
    <div class="mb-6 grid grid-cols-2 gap-2">
      <div class="rounded-lg p-2.5" style="background:var(--color-surface);border:1px solid var(--color-border)">
        <h3 class="text-[11px] font-semibold mb-1 text-center" style="color:var(--color-text-secondary)">Quality Radar</h3>
        <div class="flex justify-center">{{ chart_radar | safe }}</div>
      </div>
      <div class="rounded-lg p-2.5" style="background:var(--color-surface);border:1px solid var(--color-border)">
        <h3 class="text-[11px] font-semibold mb-1 text-center" style="color:var(--color-text-secondary)">Source Mix</h3>
        <div class="flex justify-center">{{ chart_donut | safe }}</div>
      </div>
      <div class="rounded-lg p-2.5" style="background:var(--color-surface);border:1px solid var(--color-border)">
        <h3 class="text-[11px] font-semibold mb-1 text-center" style="color:var(--color-text-secondary)">SQI Trend</h3>
        <div class="flex justify-center">{{ chart_sparkline | safe }}</div>
      </div>
      <div class="rounded-lg p-2.5" style="background:var(--color-surface);border:1px solid var(--color-border)">
        <h3 class="text-[11px] font-semibold mb-1 text-center" style="color:var(--color-text-secondary)">Quality Checks</h3>
        <div class="flex justify-center">{{ chart_heatmap | safe }}</div>
      </div>
    </div>
    {%- endif %}

    <div class="prose prose-lg prose-blue max-w-none">
      {{ content.body_html | safe }}
    </div>

    {%- if content.bloom_questions and content.bloom_questions | length > 0 %}
    <section class="mt-12 pt-8 border-t border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Bloom Taxonomy Questions</h2>
      <div class="mb-6 p-4 rounded-lg" style="background:var(--color-surface);border:1px solid var(--color-border)">
        <h3 class="text-xs font-semibold mb-2" style="color:var(--color-text-muted)">Distribution by Level</h3>
        {{ chart_bloom | safe }}
      </div>
      <div class="space-y-4">
        {%- for q in content.bloom_questions %}
        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded
            {%- if q.bloom_level == "remember" %} bg-blue-100 text-blue-700
            {%- elif q.bloom_level == "understand" %} bg-green-100 text-green-700
            {%- elif q.bloom_level == "apply" %} bg-amber-100 text-amber-700
            {%- elif q.bloom_level == "analyze" %} bg-purple-100 text-purple-700
            {%- elif q.bloom_level == "evaluate" %} bg-red-100 text-red-700
            {%- elif q.bloom_level == "create" %} bg-indigo-100 text-indigo-700
            {%- else %} bg-gray-100 text-gray-700{% endif %}">
            {{ q.bloom_level | capitalize }}
          </span>
          <p class="mt-2 text-gray-800">{{ q.question }}</p>
        </div>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if content.flashcards and content.flashcards | length > 0 %}
    <section class="mt-12 pt-8 border-t border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Flashcards</h2>
      <div class="flashcard-grid">
        {%- for fc in content.flashcards[:12] %}
        <div class="flashcard-card">
          <div class="font-semibold text-gray-900 text-sm">{{ fc.term }}</div>
          <div class="mt-1 text-xs text-gray-600">{{ fc.definition[:120] }}</div>
        </div>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if content.signals %}
    <section class="mt-12 pt-8 border-t border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Signal Analysis</h2>
      {%- if content.source_breakdown %}
      <div class="mb-6">
        <h3 class="text-sm font-semibold mb-2" style="color:var(--color-text-muted)">Source Breakdown</h3>
        <div class="flex flex-wrap gap-6 items-center">
          <div>{{ chart_source_bar | safe }}</div>
        </div>
      </div>
      {%- endif %}
      {%- set s = content.signals %}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div class="bg-white rounded-lg border p-3">
          <div class="text-xl font-bold text-gray-900">{{ s.get("count", 0) }}</div>
          <div class="text-xs text-gray-500">Articles</div>
        </div>
        <div class="bg-white rounded-lg border p-3">
          <div class="text-xl font-bold text-gray-900">{{ s.get("total_score", 0) }}</div>
          <div class="text-xs text-gray-500">Total Points</div>
        </div>
        <div class="bg-white rounded-lg border p-3">
          <div class="text-xl font-bold text-gray-900">{{ "%.2f"|format(s.get("avg_score", 0)) }}</div>
          <div class="text-xs text-gray-500">Avg Points</div>
        </div>
        <div class="bg-white rounded-lg border p-3">
          <div class="text-xl font-bold text-gray-900">{{ s.get("domain_diversity", 0) }}</div>
          <div class="text-xs text-gray-500">Domains</div>
        </div>
      </div>
      {%- if s.get("top_entities") %}
      <div class="mt-4">
        <span class="text-sm font-medium text-gray-700">Entities:</span>
        <div class="mt-1 flex flex-wrap gap-2">
          {%- for e in s["top_entities"] %}
          <span class="inline-block px-2 py-0.5 text-xs font-mono bg-gray-100 text-gray-700 rounded">{{ e }}</span>
          {%- endfor %}
        </div>
      </div>
      {%- endif %}
    </section>
    {%- endif %}

    {%- if related_posts %}
    <section class="mt-12 pt-8 border-t border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Related</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {%- for rp in related_posts %}
        {%- set rpillar = rp.pillar or "aml" %}
        {%- set rpc = pillar_config.get(rpillar, pillar_config["aml"]) %}
        {%- set rtkey = thumbnail_key(rp.title) %}
        <a href="/{{ rp.slug }}/" class="block rounded-lg overflow-hidden transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border);text-decoration:none">
          <div class="aspect-[600/340] bg-gray-800 overflow-hidden">
            <img src="{{ thumbnail_base }}/thumb_{{ rtkey }}.svg" alt="" class="w-full h-full object-cover" loading="lazy">
          </div>
          <div class="p-3">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded {{ rpc.badge_color }}">{{ rpc.emoji }} {{ rpc.label }}</span>
            <span class="block mt-2 text-sm font-semibold" style="color:var(--color-text)">{{ rp.title | striptags }}</span>
            {%- if rp.date_str %}
            <span class="block mt-1 text-xs" style="color:var(--color-text-muted)">{{ rp.date_str }}</span>
            {%- endif %}
          </div>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if prev_post or next_post %}
    <nav class="mt-12 pt-6 border-t border-gray-200 grid grid-cols-2 gap-4" aria-label="Post navigation">
      {%- if prev_post %}
      <a href="/{{ prev_post.slug }}/" class="group">
        <span class="text-xs text-gray-500">&larr; Previous</span>
        <span class="block text-sm font-medium text-gray-900 group-hover:text-blue-600 truncate">{{ prev_post.title | striptags }}</span>
      </a>
      {%- endif %}
      {%- if next_post %}
      <a href="/{{ next_post.slug }}/" class="group text-right">
        <span class="text-xs text-gray-500">Next &rarr;</span>
        <span class="block text-sm font-medium text-gray-900 group-hover:text-blue-600 truncate">{{ next_post.title | striptags }}</span>
      </a>
      {%- endif %}
    </nav>
    {%- endif %}
  </article>
</div>

<script>
(function(){
  var bar = document.getElementById('reading-progress');
  if (bar) {
    window.addEventListener('scroll', function() {
      var h = document.documentElement;
      var pct = (h.scrollTop || document.body.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
      bar.style.width = Math.min(pct, 100) + '%';
    }, {passive: true});
  }

  var tocLinks = document.querySelectorAll('.toc-link');
  if (tocLinks.length) {
    var headings = [];
    tocLinks.forEach(function(link) {
      var id = link.getAttribute('href').slice(1);
      var el = document.getElementById(id);
      if (el) headings.push({el: el, link: link});
    });
    window.addEventListener('scroll', function() {
      var scrollY = window.scrollY + 120;
      var current = null;
      for (var i = headings.length - 1; i >= 0; i--) {
        if (headings[i].el.offsetTop <= scrollY) { current = headings[i]; break; }
      }
      tocLinks.forEach(function(l) { l.style.background = ''; l.style.color = ''; });
      if (current) {
        current.link.style.background = 'var(--color-bg)';
        current.link.style.color = 'var(--color-accent)';
      }
    }, {passive: true});
  }

  var focusBtn = document.getElementById('focus-toggle');
  if (focusBtn) {
    focusBtn.addEventListener('click', function() {
      document.body.classList.toggle('focus-mode');
    });
  }
})();
</script>
{% endblock %}
