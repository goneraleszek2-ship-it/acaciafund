{% extends "layout.j2" %}
{% from "macros/pillar_badge.html" import pillar_badge %}
{% from "macros/breadcrumbs.html" import breadcrumbs %}
{% block main_content %}
{{ breadcrumbs(page_path, content.title) }}
<div id="reading-progress" style="position:fixed;top:0;left:0;height:3px;z-index:9999;width:0%;background:var(--color-accent)"></div>

<div class="flex gap-8 {% if toc_items %}md:flex-row{% endif %} flex-col">
  {%- if toc_items %}
  <aside class="toc-sidebar shrink-0 order-last md:order-first md:sticky md:top-20 md:self-start md:max-h-[calc(100vh-6rem)] md:overflow-y-auto md:w-52">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-text-muted)">On this page</h2>
      <button id="focus-toggle" class="text-xs px-2 py-1 rounded" style="color:var(--color-text-muted);background:var(--color-bg)" title="Focus mode" aria-label="Toggle focus mode">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4h4M6 20h4M18 4h-4M18 20h-4M4 6v4M4 18v4M20 6v4M20 18v4"/></svg>
      </button>
    </div>
    <nav aria-label="Table of contents">
      <ul class="space-y-1 text-sm">
        {%- for item in toc_items %}
        <li>
          <a href="#{{ item.id }}" class="toc-link block py-1 {% if item.tag == 'h3' %}pl-4 text-xs{% endif %} rounded px-2 transition" style="color:var(--color-text-muted)">
            {{ item.text }}
          </a>
        </li>
        {%- endfor %}
      </ul>
    </nav>
  </aside>
  {%- endif %}

  <article class="min-w-0 flex-1">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs" style="color:var(--color-text-muted)">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-accent)] transition">Home</a></li>
        <li aria-hidden="true">/</li>
        {%- set pillar_key = content.pillar or "aml" %}
        {%- set pc = pillar_config.get(pillar_key, pillar_config["aml"]) %}
        <li><a href="/{{ pillar_key }}/" class="hover:text-[var(--color-accent)] transition">{{ pc.label }}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="truncate max-w-[200px]">{{ content.title | striptags }}</li>
      </ol>
    </nav>
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        {{ layer_badge | default("") | safe }}
        {{ pillar_badge(content.pillar, title=content.title) }}
        {%- if topic_icon_html %}
        <span class="article-topic-icon">{{ topic_icon_html | safe }}</span>
        {%- endif %}
        {%- if content.source_breakdown %}
        <span class="text-xs" style="color:var(--color-text-muted)">
          {{ content.source_breakdown.get("hn", 0) }} HN
          {%- if content.source_breakdown.get("arxiv", 0) > 0 %} · {{ content.source_breakdown["arxiv"] }} arXiv{% endif %}
          {%- if content.source_breakdown.get("pubmed", 0) > 0 %} · {{ content.source_breakdown["pubmed"] }} PubMed{% endif %}
        </span>
        {%- endif %}
      </div>
      <div class="flex items-center gap-2 mt-1">
        {{ visual_fingerprint | default("") | safe }}
        <h1 class="text-3xl font-extrabold  leading-tight">{{ content.title | striptags }}</h1>
      </div>
      {%- set sqi_val = content.signals.get("avg_sqi", "") if content.signals else "" %}
      {%- if sqi_val and sqi_val != "0.0" %}
      <div class="mt-2">
        <span class="badge badge-accent font-meta">SQI {{ sqi_val }}</span>
      </div>
      {%- endif %}
      {%- if content.date_str %}
      <div class="mt-2 flex items-center gap-2 text-sm" style="color:var(--color-text-muted)">
        <time datetime="{{ content.date_str }}">{{ content.date_str }}</time>
        <span aria-hidden="true">·</span>
        <span>By {{ content.author | default("Leszek") }} <span style="color:var(--color-text-muted)">&middot; AML Specialist & Data Engineer</span></span>
        {%- if page_body %} · {{ page_body | reading_time }} min read{% endif %}
      </div>
      {%- endif %}
      {%- if content.tags and content.tags | length > 0 %}
      <div style="display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: var(--pico-spacing);">
        {%- for tag in content.tags %}
        {%- set tag_slug = tag | lower | replace(' ', '-') | replace('_', '-') %}
        <a href="/tags/{{ tag_slug }}/"><kbd>{{ tag }}</kbd></a>
        {%- endfor %}
      </div>
    {%- endif %}

    {%- if quiz_json %}
    <section class="mt-12 pt-8 border-t" style="border-color:var(--color-border)" id="quiz-section" data-quiz='{{ quiz_json }}' data-quiz-lesson="{{ page_path }}">
      <h2 class="text-2xl font-bold mb-4" style="color:var(--color-text)">Knowledge Check</h2>
      <p class="text-sm mb-4" style="color:var(--color-text-muted)">Test your understanding of this article.</p>
      <div id="quiz-score" class="mb-4 text-sm font-semibold" style="color:var(--color-text-secondary)"></div>
      <div id="quiz-container"></div>
      <div id="quiz-summary" class="mt-6 p-4 rounded-lg hidden" style="background:var(--color-surface);border:1px solid var(--color-border)"></div>
      <button id="quiz-retry" class="mt-3 hidden px-4 py-2 text-sm font-semibold rounded-lg transition hover:opacity-80" style="background:var(--color-accent);color:#fff">Retry Quiz</button>
    </section>
    {%- endif %}

    {%- if content.flashcards and content.flashcards | length > 0 %}
    <div class="mt-8 text-center">
      <button id="mark-complete-btn" data-track-lesson="{{ page_path }}" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg transition" style="background:var(--color-accent);color:#fff">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span id="complete-btn-text">Mark Complete</span>
      </button>
    </div>
    {%- endif %}
    </header>

    {%- set share_url = site_url ~ "/" ~ page_path %}
    <div class="flex items-center gap-3 mb-4 text-xs" style="color:var(--color-text-muted)">
      <span>Share:</span>
      <a href="https://twitter.com/intent/tweet?text={{ content.title | striptags | urlencode }}&url={{ share_url | urlencode }}" target="_blank" rel="noopener" class="hover:text-[var(--color-accent)] transition" aria-label="Share on Twitter/X">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url | urlencode }}" target="_blank" rel="noopener" class="hover:text-[var(--color-accent)] transition" aria-label="Share on LinkedIn">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="mailto:?subject={{ content.title | striptags | urlencode }}&body={{ share_url | urlencode }}" target="_blank" rel="noopener" class="hover:text-[var(--color-accent)] transition" aria-label="Share via email">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </a>
    </div>

    {%- if content.quality_metrics and content.quality_metrics.get("avg_source_score") is defined %}
    <div class="mb-6 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-xs font-meta" style="color:var(--color-text-muted)">
      {%- set qm = content.quality_metrics %}
      <span class="inline-flex items-center gap-1">
        <span style="color:var(--color-text-secondary);font-weight:600">Authority</span>
        {{ "%.2f"|format(qm.get("avg_source_score", 0)) }}
      </span>
      <span class="inline-flex items-center gap-1">
        <span style="color:var(--color-text-secondary);font-weight:600">Diversity</span>
        {{ "%.2f"|format(qm.get("source_diversity", 0)) }}
      </span>
      <span class="inline-flex items-center gap-1">
        <span style="color:var(--color-text-secondary);font-weight:600">Sources</span>
        {%- set sb = content.source_breakdown or {} %}
        {%- set total = sb.get("hn", 0) + sb.get("arxiv", 0) + sb.get("pubmed", 0) %}
        {{ total }}
        {%- if sb.get("hn", 0) > 0 or sb.get("arxiv", 0) > 0 or sb.get("pubmed", 0) > 0 %}
        <span style="color:var(--color-text-muted)">
          ({%- if sb.get("hn", 0) > 0 %}{{ sb["hn"] }} HN{% endif %}{% if sb.get("hn", 0) > 0 and sb.get("arxiv", 0) > 0 %} · {% endif %}{%- if sb.get("arxiv", 0) > 0 %}{{ sb["arxiv"] }} arXiv{% endif %}{% if (sb.get("hn", 0) > 0 or sb.get("arxiv", 0) > 0) and sb.get("pubmed", 0) > 0 %} · {% endif %}{%- if sb.get("pubmed", 0) > 0 %}{{ sb["pubmed"] }} PubMed{% endif %})
        </span>
        {%- endif %}
      </span>
    </div>
    {%- endif %}

    {% include 'partials/article_image.html' %}

    <div class="prose prose-lg prose-blue max-w-none">
      {{ page_body | default(content.body_html) | safe }}
    </div>

    {%- if content.bloom_questions and content.bloom_questions | length > 0 %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold  mb-4">Bloom Taxonomy Questions</h2>
      <div class="mb-6 flex flex-wrap items-center gap-2">
        {%- set levels = {"remember":"🔵","understand":"🟢","apply":"🟠","analyze":"🟣","evaluate":"🔴","create":"🟡"} %}
        {%- for l, dot in levels.items() %}
        {%- set count = content.bloom_questions | selectattr("bloom_level", "equalto", l) | list | length %}
        {%- if count > 0 %}
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs" style="background:var(--color-bg);color:var(--color-text-secondary)">
          <span>{{ dot }}</span> {{ count }} {{ l | capitalize }}
        </span>
        {%- endif %}
        {%- endfor %}
      </div>
      <div class="space-y-4">
        {%- for q in content.bloom_questions %}
        <div class="ghost-card p-4">
          <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded" style="
            {%- if q.bloom_level == "remember" %} background:color-mix(in srgb, #3b82f6 15%, transparent);color:#3b82f6
            {%- elif q.bloom_level == "understand" %} background:color-mix(in srgb, #22c55e 15%, transparent);color:#22c55e
            {%- elif q.bloom_level == "apply" %} background:color-mix(in srgb, #f59e0b 15%, transparent);color:#f59e0b
            {%- elif q.bloom_level == "analyze" %} background:color-mix(in srgb, #a855f7 15%, transparent);color:#a855f7
            {%- elif q.bloom_level == "evaluate" %} background:color-mix(in srgb, #ef4444 15%, transparent);color:#ef4444
            {%- elif q.bloom_level == "create" %} background:color-mix(in srgb, #6366f1 15%, transparent);color:#6366f1
            {%- else %} background:var(--color-bg);color:var(--color-text-secondary){% endif %}">
            {{ q.bloom_level | capitalize }}
          </span>
          <p class="mt-2  ">{{ q.question }}</p>
        </div>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if content.flashcards and content.flashcards | length > 0 %}
    <section class="mt-12 pt-8 border-t" style="border-color:var(--color-border)">
      <h2 class="text-2xl font-bold mb-6 inline-flex items-center gap-2" style="color:var(--color-text)">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        Flashcards
      </h2>
      <div class="grid gap-4 sm:grid-cols-2" id="flashcard-grid">
        {%- for fc in content.flashcards[:12] %}
        <div class="ghost-card cursor-pointer" role="button" tabindex="0" aria-label="Flashcard: {{ fc.term }}" onclick="this.classList.toggle('flipped')" onkeydown="if(event.key==='Enter'||event.key===' ')this.classList.toggle('flipped')">
          <div class="flashcard-inner">
            <div class="flashcard-front rounded-lg p-4" style="background:var(--color-surface);border:1px solid var(--color-border)">
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-accent)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                <span class="font-semibold text-sm" style="color:var(--color-text)">{{ fc.term }}</span>
              </div>
              <p class="mt-2 text-[11px]" style="color:var(--color-text-muted)">Tap to reveal definition</p>
            </div>
            <div class="flashcard-back rounded-lg p-4" style="background:var(--color-accent);color:#fff">
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="text-sm">{{ fc.definition[:200] }}</span>
              </div>
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if content.signals and content.signals.get("count", 0) > 0 %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold  mb-4">Signal Analysis</h2>
      {%- set s = content.signals %}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div class="ghost-card p-3">
          <div class="text-xl font-bold ">{{ s.get("count", 0) }}</div>
          <div class="text-xs font-meta" style="color:var(--color-text-muted)">Articles</div>
        </div>
        <div class="ghost-card p-3">
          <div class="text-xl font-bold ">{{ s.get("total_score", 0) }}</div>
          <div class="text-xs font-meta" style="color:var(--color-text-muted)">Total Points</div>
        </div>
        <div class="ghost-card p-3">
          <div class="text-xl font-bold ">{{ "%.2f"|format(s.get("avg_score", 0)) }}</div>
          <div class="text-xs font-meta" style="color:var(--color-text-muted)">Avg Points</div>
        </div>
        <div class="ghost-card p-3">
          <div class="text-xl font-bold ">{{ s.get("domain_diversity", 0) }}</div>
          <div class="text-xs font-meta" style="color:var(--color-text-muted)">Domains</div>
        </div>
      </div>
      {%- set filtered_entities = s["top_entities"] | filter_entities %}
      {%- if filtered_entities %}
      <div class="mt-4">
        <div class="mt-1 flex flex-wrap gap-2">
          {%- for e in filtered_entities %}
          <span class="inline-block px-2 py-0.5 text-xs font-mono rounded" style="background:var(--color-bg);color:var(--color-text-secondary);border:1px solid var(--color-border)">{{ e }}</span>
          {%- endfor %}
        </div>
      </div>
      {%- endif %}
    </section>
    {%- endif %}

    {%- if source_synthesis and source_synthesis | length > 0 %}
    <section class="mt-12 pt-8 border-t" style="border-color:var(--color-border)">
      <h2 class="text-2xl font-bold  mb-4 inline-flex items-center gap-2" style="color:var(--color-text)">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Source Synthesis
      </h2>
      <div class="space-y-3">
        {%- for syn in source_synthesis | sort(attribute='synthesis_score') | reverse %}
        <div class="synthesis-card p-4 rounded-lg transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border)">
          <div class="flex items-start gap-3">
            <div class="synthesis-icon shrink-0" style="color:var(--color-accent)">
              {%- set stype = syn.get('source_type', 'unknown') | lower %}
              {%- if 'arxiv' in stype %}
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              {%- elif 'github' in stype or 'gitlab' in stype %}
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 15.75c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 8.25c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/></svg>
              {%- elif 'pubmed' in stype or 'science' in stype or 'academic' in stype %}
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              {%- else %}
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              {%- endif %}
            </div>
            <div class="synthesis-content flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-text-muted)">{{ syn.get('source_type', 'source') }}</span>
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs" style="background:var(--color-accent);color:#fff">
                    {{ (syn.get('synthesis_score', 0) * 100)|int }}%
                  </span>
                </div>
              </div>
              <h3 class="text-sm font-semibold" style="color:var(--color-text)">
                <a href="{{ syn.get('source_url', '#') }}" target="_blank" rel="noopener" class="hover:text-[var(--color-accent)] transition">
                  {{ syn.get('source_title', 'Source') }}
                </a>
              </h3>
              <p class="mt-1 text-xs" style="color:var(--color-text-secondary)">
                {{ syn.get('synthesis_text', 'Key insights synthesized from this source.') }}
              </p>
              {%- if syn.get('key_insights') %}
              <div class="mt-2 flex flex-wrap gap-1">
                {%- for insight in syn.get('key_insights')[:4] %}
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px]" style="background:var(--color-bg);border:1px solid var(--color-border);color:var(--color-text-secondary)">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  {{ insight }}
                </span>
                {%- endfor %}
              </div>
              {%- endif %}
              <div class="mt-2 flex items-center gap-3 text-[10px]" style="color:var(--color-text-muted)">
                {%- if syn.get('publication_date') %}
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  {{ syn['publication_date'] }}
                </span>
                {%- endif %}
                {%- if syn.get('author_affiliation') %}
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  {{ syn['author_affiliation'] }}
                </span>
                {%- endif %}
              </div>
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
      <div class="mt-4 p-3 rounded" style="background:var(--color-bg);border:1px solid var(--color-border)">
        <p class="text-xs" style="color:var(--color-text-secondary)">
          <strong>Value Add:</strong> This synthesis aggregates insights from authoritative sources to provide comprehensive context and evidence for the analysis presented in this article.
        </p>
      </div>
    </section>
    {%- endif %}

    {%- if related_posts %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold  mb-6">Related</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {%- for rp in related_posts %}
        {%- set rpillar = rp.pillar or "aml" %}
        {%- set rpc = pillar_config.get(rpillar, pillar_config["aml"]) %}
        {%- set rtkey = thumbnail_key(rp.title) %}
        {%- set feat_img = rp.featured_image or "" %}
        {%- set has_feat = feat_img %}
          <a href="/{{ rp.slug }}/" class="ghost-card block text-decoration:none">
            <div class="aspect-[600/340] bg-gray-800 overflow-hidden">
              {%- if has_feat %}
              <img src="{{ resolve_card_image(feat_img) }}" alt="{{ rp.title | striptags | e }}" width="600" height="340" class="w-full h-full object-cover" loading="lazy" decoding="async">
              {%- else %}
              <img src="{{ thumbnail_base }}/thumb_{{ rtkey }}.svg" alt="{{ rp.title | striptags | e }}" width="600" height="340" class="w-full h-full object-cover" loading="lazy" decoding="async">
              {%- endif %}
            </div>
           <div class="p-3">
              {{ pillar_badge(rp.pillar, title=rp.title) }}
              <span class="block mt-2 text-sm font-semibold" style="color:var(--color-text)">{{ rp.title | striptags }}</span>
             {%- if rp.date_str %}
             <span class="block mt-1 text-xs font-meta" style="color:var(--color-text-muted)">{{ rp.date_str }}</span>
             {%- endif %}
           </div>
         </a>
         {%- endfor %}
       </div>
     </section>
     {%- endif %}

     {%- if related_learn %}
     <section class="mt-12 pt-8 border-t">
       <h2 class="text-2xl font-bold  mb-2">Related Lessons</h2>
       <p class="text-sm mb-6" style="color:var(--color-text-muted)">Deepen your understanding of this topic with structured learning lessons.</p>
       <div class="grid gap-4 sm:grid-cols-3">
         {%- for rl in related_learn %}
         {%- set rpillar = rl.pillar or "aml" %}
         {%- set rpc = pillar_config.get(rpillar, pillar_config["aml"]) %}
         {%- set rtkey = thumbnail_key(rl.title) %}
         {%- set feat_img = rl.featured_image or "" %}
         {%- set has_feat = feat_img %}
          <a href="/{{ rl.slug }}/" class="ghost-card block text-decoration:none">
            <div class="aspect-[600/340] bg-gray-800 overflow-hidden">
              {%- if has_feat %}
              <img src="{{ resolve_card_image(feat_img) }}" alt="{{ rl.title | striptags | e }}" width="600" height="340" class="w-full h-full object-cover" loading="lazy" decoding="async">
              {%- else %}
              <img src="{{ thumbnail_base }}/thumb_{{ rtkey }}.svg" alt="{{ rl.title | striptags | e }}" width="600" height="340" class="w-full h-full object-cover" loading="lazy" decoding="async">
              {%- endif %}
            </div>
           <div class="p-3">
              {{ pillar_badge(rl.pillar, title=rl.title) }}
              {%- if rl.difficulty %}<span class="text-xs ml-1" style="color:var(--color-text-muted)">{{ rl.difficulty | capitalize }}</span>{% endif %}
              <span class="block mt-2 text-sm font-semibold" style="color:var(--color-text)">{{ rl.title | striptags }}</span>
             {%- if rl.date_str %}
             <span class="block mt-1 text-xs font-meta" style="color:var(--color-text-muted)">{{ rl.date_str }}</span>
             {%- endif %}
           </div>
         </a>
         {%- endfor %}
       </div>
     </section>
     {%- endif %}

     {%- if prev_post or next_post %}
     <nav class="mt-12 pt-6 border-t grid grid-cols-2 gap-4" aria-label="Post navigation">
       {%- if prev_post %}
       <a href="/{{ prev_post.slug }}/" class="ghost-card group block p-3 text-decoration:none">
         <span class="text-xs" style="color:var(--color-text-muted)">&larr; Previous</span>
         <span class="block text-sm font-medium  group-hover:text-blue-600 truncate">{{ prev_post.title | striptags }}</span>
       </a>
       {%- endif %}
       {%- if next_post %}
       <a href="/{{ next_post.slug }}/" class="ghost-card group block p-3 text-decoration:none">
         <span class="text-xs" style="color:var(--color-text-muted)">Next &rarr;</span>
         <span class="block text-sm font-medium  group-hover:text-blue-600 truncate">{{ next_post.title | striptags }}</span>
       </a>
       {%- endif %}
     </nav>
     {%- endif %}
   </article>
</div>

    <section id="semantic-context-network" class="mt-8 pt-4 border-t">
      <h2 class="text-lg font-semibold mb-3" style="color:var(--color-text)">Related Topics</h2>
      <div class="space-y-2">
        {%- for rel in related_kg if rel.title and rel.title | length > 0 %}
          {%- set rel_slug = rel.slug %}
          {%- set score = rel.score %}
          {%- set rel_title = rel.title | default(rel.slug.split('/')[-1] | replace('-', ' ') | title) | striptags %}
          {%- set rel_pillar = rel.pillar | default("knowledge") %}
          <a href="/{{ rel_slug }}/" class="block p-3 rounded-lg transition hover:bg-gray-50 dark:hover:bg-gray-800/50" style="background:var(--color-surface);border:1px solid var(--color-border)">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <h4 class="text-sm font-semibold truncate" style="color:var(--color-text)">{{ rel_title }}</h4>
                <p class="text-xs mt-0.5" style="color:var(--color-text-muted)">{{ rel_pillar | replace('-', ' ') | capitalize }}</p>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border shrink-0"
                    style="background:rgba(16,185,129,0.1);color:#10b981;border-color:rgba(16,185,129,0.2)">
                {{ (score*100)|round(0) }}% match
              </span>
            </div>
          </a>
        {%- endfor %}
      </div>
    </section>

    <script src="{{ 'js/learning_hub.js' | asset }}" defer></script>

{% include 'partials/newsletter.html' %}

{% endblock %}
