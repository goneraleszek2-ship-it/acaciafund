{% extends "layout.j2" %}
{% block main_content %}
<div id="reading-progress"></div>

<article class="entrance-fade">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover-accent transition">Home</a></li>
        <li aria-hidden="true">/</li>
        {%- set pillar_key = content.pillar or "aml" %}
        {%- set pc = pillar_config.get(pillar_key, pillar_config["aml"]) %}
        <li><a href="/{{ pc.url }}/" class="hover-accent transition">{{ pc.label }}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/{{ pc.url }}/research/" class="hover-accent transition">Research</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="truncate max-w-200px">{{ content.title | striptags }}</li>
      </ol>
    </nav>
    <header class="mb-6 entrance-slide-up">
      <div class="flex items-center gap-2 mb-2">
        {{ layer_badge | default("") | safe }}
        {% set pillar = content.pillar %}
        {% include "macros/pillar_badge.html" %}
      </div>
      {%- if featured_image %}
      {% set base = featured_image.rsplit('.', 1)[0] %}
      {% set ext = featured_image.rsplit('.', 1)[1] %}
      {% set src_400 = base ~ '_400w.' ~ ext %}
      {% set src_800 = base ~ '_800w.' ~ ext %}
      <div class="mb-4">
        <img src="{{ featured_image }}" srcset="{{ src_400 }} 400w, {{ src_800 }} 800w, {{ featured_image }} 1200w" sizes="(max-width: 400px) 400px, (max-width: 800px) 800px, 1200px" alt="{{ content.title | striptags }}" class="w-full rounded-lg img-hero" loading="lazy" decoding="async">
        {%- if image_credit %}
        <span class="block text-xs mt-1 text-muted">{{ image_credit }}</span>
        {%- endif %}
      </div>
      {%- endif %}
      <h1 class="text-3xl font-extrabold leading-tight text-default">{{ content.title | striptags }}</h1>
      {%- if content.date_str or content.source_url %}
      <div class="mt-2 flex items-center gap-2 text-sm flex-wrap text-muted">
        {%- if content.date_str %}
        <time datetime="{{ content.date_str }}">{{ content.date_str | format_date }}</time>
        {%- endif %}
        {%- if content.source_url %}
        {%- if content.date_str %}<span aria-hidden="true"> · </span>{% endif %}
        <a href="{{ content.source_url }}" target="_blank" rel="noopener" class="hover-accent transition">Source &nearr;</a>
        {%- endif %}
      </div>
      {%- endif %}
    </header>

    {% include 'partials/visual_abstract.j2' %}

    {% include 'partials/editor_note.j2' %}

    {% include 'partials/citation_export.j2' %}

    {% include 'partials/extraction_table.j2' %}

    {% include 'partials/edit_on_github.j2' %}

    <div class="prose-body">
      {{ page_body | default(content.body_html) | wrap_prose_sections | safe }}
    </div>

    {% include 'partials/article_metadata.j2' %}

    {%- if cross_pillar_items and cross_pillar_items | length > 0 %}
    <section class="mt-12 pt-8 border-t border-muted entrance-slide-up" style="--stagger-index: 5">
      <h2 class="text-2xl font-bold mb-6">Cross-Pillar Connections</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {%- for cp in cross_pillar_items %}
        {%- set cpp = cp.pillar or "aml" %}
        {%- set cpc = pillar_config.get(cpp, pillar_config["aml"]) %}
        <a href="{{ slug_to_url(cp.slug) }}" class="ghost-card block text-decoration-none hover-lift">
          <div class="p-3">
            {% set pillar = cp.pillar %}
            {% include "macros/pillar_badge.html" %}
            <span class="block mt-2 text-sm font-semibold text-default">{{ cp.title | striptags }}</span>
            {%- if cp.description %}
            <span class="block mt-1 text-xs text-muted">{{ cp.description | truncate(100) }}</span>
            {%- endif %}
          </div>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if source_synthesis and source_synthesis | length > 0 %}
    <section class="mt-12 pt-8 border-t border-muted entrance-slide-up" style="--stagger-index: 6">
      <h2 class="text-2xl font-bold mb-4 inline-flex items-center gap-2 text-default">
        <svg class="section-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Source Synthesis
      </h2>
      <div class="space-y-3">
        {%- for syn in source_synthesis | sort(attribute='synthesis_score') | reverse %}
        <div class="synthesis-card ghost-card p-4 hover-lift">
          <div class="flex items-start gap-3">
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-default">
                <a href="{{ syn.get('source_url', '#') }}" target="_blank" rel="noopener" class="hover-accent transition">{{ syn.get('source_title', 'Source') }}</a>
              </h3>
              <p class="mt-1 text-xs text-secondary">{{ syn.get('synthesis_text', '') }}</p>
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if external_references and external_references | length > 0 %}
    <section class="mt-12 pt-8 border-t border-muted entrance-slide-up" style="--stagger-index: 7">
      <h2 class="text-2xl font-bold mb-4">Further Reading</h2>
      <ul class="space-y-2">
        {%- for ref in external_references %}
        <li>
          <a href="{{ ref.url }}" target="_blank" rel="noopener" class="text-sm hover-accent transition">{{ ref.title }}</a>
          {%- if ref.description %}
          <p class="text-xs mt-0.5 text-muted">{{ ref.description }}</p>
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}

    {%- if related_posts and related_posts | length > 0 %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold mb-6">Related Research</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {%- for rp in related_posts %}
        {%- set rpillar = rp.pillar or "aml" %}
        {%- set rpc = pillar_config.get(rpillar, pillar_config["aml"]) %}
        <a href="{{ slug_to_url(rp.slug) }}" class="ghost-card block text-decoration-none">
          <div class="p-3">
            {% set pillar = rp.pillar %}
            {% include "macros/pillar_badge.html" %}
            <span class="block mt-2 text-sm font-semibold text-default">{{ rp.title | striptags }}</span>
            {%- if rp.date_str %}
            <span class="block mt-1 text-xs font-meta text-muted">{{ rp.date_str | format_date }}</span>
            {%- endif %}
          </div>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if related_learn and related_learn | length > 0 %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold mb-6">Related Lessons</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {%- for rl in related_learn %}
        {%- set rlpillar = rl.pillar or "aml" %}
        {%- set rlpc = pillar_config.get(rlpillar, pillar_config["aml"]) %}
        <a href="{{ slug_to_url(rl.slug) }}" class="ghost-card block text-decoration-none">
          <div class="p-3">
            {% set pillar = rl.pillar %}
            {% include "macros/pillar_badge.html" %}
            <span class="block mt-2 text-sm font-semibold text-default">{{ rl.title | striptags }}</span>
            {%- if rl.description %}
            <span class="block mt-1 text-xs text-muted">{{ rl.description | truncate(80) }}</span>
            {%- endif %}
          </div>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if prev_post or next_post %}
    <nav class="mt-12 pt-6 border-t grid grid-cols-2 gap-4" aria-label="Article navigation">
      {%- if prev_post %}
      <a href="{{ slug_to_url(prev_post.slug) }}" class="ghost-card group block p-3 text-decoration-none">
        <span class="text-xs text-muted">&larr; Previous</span>
        <span class="block text-sm font-medium group-hover-accent truncate">{{ prev_post.title | striptags }}</span>
      </a>
      {%- endif %}
      {%- if next_post %}
      <a href="{{ slug_to_url(next_post.slug) }}" class="ghost-card group block p-3 text-decoration-none">
        <span class="text-xs text-muted">Next &rarr;</span>
        <span class="block text-sm font-medium group-hover-accent truncate">{{ next_post.title | striptags }}</span>
      </a>
      {%- endif %}
    </nav>
    {%- endif %}

    {# MathWorld-inspired sections #}
    {% include 'partials/see_also.j2' %}
    {% include 'partials/explore_tools.j2' %}
    {% include 'partials/contributor.j2' %}
    {% include 'partials/citation.j2' %}
  </article>

{% include 'partials/newsletter.html' %}
{% endblock %}