{% extends "layout.j2" %}
{% from "macros/breadcrumbs.html" import breadcrumbs %}
{% block main_content %}

<nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="hover-accent transition">Home</a></li>
    <li aria-hidden="true">/</li>
    <li aria-current="page">Scholar Console</li>
  </ol>
</nav>

<header class="mb-6">
  <h1 class="text-3xl font-extrabold text-default">Scholar Console</h1>
  <p class="mt-2 text-sm text-muted max-w-prose">Unified knowledge cockpit across all three pillars. Build <code class="text-xs px-1 py-0.5 rounded bg-surface">{{ build_hash }}</code></p>
</header>

<nav class="console-tabs flex flex-wrap gap-1 mb-8 p-1 rounded-lg border border-muted/20" role="tablist">
  <button class="console-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="true" data-tab="overview" style="background:var(--color-surface);color:var(--color-text)">Overview</button>
  <button class="console-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="false" data-tab="ontology" style="color:var(--color-text-muted)">Ontology</button>
  <button class="console-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="false" data-tab="evidence" style="color:var(--color-text-muted)">Evidence</button>
  <button class="console-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="false" data-tab="sources" style="color:var(--color-text-muted)">Sources</button>
  <button class="console-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="false" data-tab="content" style="color:var(--color-text-muted)">Content</button>
  <button class="console-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="false" data-tab="feynman" style="color:var(--color-text-muted)">Feynman</button>
  <button class="console-tab flex-1 px-3 py-2 text-xs font-semibold rounded-md transition" role="tab" aria-selected="false" data-tab="health" style="color:var(--color-text-muted)">Health</button>
</nav>

{# ============================================ OVERVIEW ============================================ #}
<section class="console-panel" data-panel="overview">
  <h2 class="text-xl font-semibold mb-4 text-default font-display">System Overview</h2>

  <div class="grid gap-4 grid-cols-2 lg:grid-cols-4 mb-6">
  {% for p in pillar_data %}
    <div class="ghost-card p-4 text-center">
      <div class="text-2xl mb-1">{{ p.emoji }}</div>
      <div class="text-lg font-bold" style="color:{{ p.color }}">{{ p.label }}</div>
      <p class="text-xs text-muted mt-1">{{ pillar_counts.get(p.key, {}).get("total", 0) }} items &middot; {{ concept_counts.get(p.key, 0) }} concepts</p>
      <div class="flex flex-wrap justify-center gap-1 mt-2">
        <span class="badge-outline text-xs">{{ pillar_counts.get(p.key, {}).get("research", 0) }} R</span>
        <span class="badge-outline text-xs">{{ pillar_counts.get(p.key, {}).get("learn", 0) }} L</span>
        <span class="badge-outline text-xs">{{ pillar_counts.get(p.key, {}).get("knowledge", 0) }} K</span>
      </div>
    </div>
  {% endfor %}
  </div>

  <div class="grid gap-4 grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="ghost-card p-4 text-center">
      <div class="text-3xl font-bold text-accent">{{ items_total }}</div>
      <p class="text-xs text-muted mt-1">Content Items</p>
      <p class="text-[10px] opacity-50">{{ content_type_counts.get("research", 0) }} res / {{ content_type_counts.get("learn", 0) }} learn / {{ content_type_counts.get("knowledge", 0) }} knwl</p>
    </div>
    <div class="ghost-card p-4 text-center">
      <div class="text-3xl font-bold" style="color:#6366f1">{{ concepts_total }}</div>
      <p class="text-xs text-muted mt-1">Ontology Concepts</p>
      <p class="text-[10px] opacity-50">{{ relations_total }} relations</p>
    </div>
    <div class="ghost-card p-4 text-center">
      <div class="text-3xl font-bold" style="color:#22c55e">{{ source_active }}</div>
      <p class="text-xs text-muted mt-1">Active Sources</p>
      <p class="text-[10px] opacity-50"><span style="color:#f59e0b">{{ source_degraded }} degraded</span> &middot; <span style="color:#ef4444">{{ source_error }} down</span></p>
    </div>
    <div class="ghost-card p-4 text-center">
      <div class="text-3xl font-bold text-accent">{{ relations_total }}</div>
      <p class="text-xs text-muted mt-1">Ontology Relations</p>
      <p class="text-[10px] opacity-50">{{ philosophy_metadata_count }} concepts with lineage</p>
    </div>
  </div>

  <h3 class="text-sm font-semibold mb-3 text-default">Signal Quality Index by Pillar</h3>
  <div class="grid gap-4 grid-cols-3 mb-6">
  {% for pkey in ["aml", "stock", "data-engineering"] %}
    {% set pq = pillar_quality.get(pkey, {}) %}
    {% set pc = pillar_config.get(pkey, {}) %}
    <div class="ghost-card p-4">
      <p class="text-xs font-semibold mb-2" style="color:{{ pc.get('color', '#6366f1') }}">{{ pc.get('label', pkey | title) }}</p>
      {% set sqi_pct = (pq.get("avg_sqi", 0) * 100) | round %}
      <div class="flex items-baseline gap-2">
        <span class="text-2xl font-bold">{{ sqi_pct }}</span>
        <span class="text-xs text-muted">avg SQI</span>
      </div>
      <p class="text-[10px] text-muted mt-1">range: {{ (pq.get("min_sqi", 0) * 100) | round }}&#8211;{{ (pq.get("max_sqi", 0) * 100) | round }}</p>
      <div class="h-1.5 rounded-full mt-2 overflow-hidden" style="background:color-mix(in srgb, {{ pc.get('color', '#6366f1') }} 15%, transparent)">
        <div class="h-full rounded-full" style="width:{{ sqi_pct }}%;background:{{ pc.get('color', '#6366f1') }}"></div>
      </div>
    </div>
  {% endfor %}
  </div>

  <h3 class="text-sm font-semibold mb-3 text-default">Epistemic Status Distribution</h3>
  <div class="flex flex-wrap gap-2 mb-4">
  {% for status_type, count in origin_counts.items() %}
    <span class="badge-outline text-xs">{{ status_type | replace('_', ' ') | title }}: {{ count }}</span>
  {% endfor %}
  </div>
</section>

{# ============================================ ONTOLOGY ============================================ #}
<section class="console-panel" data-panel="ontology" style="display:none">
  <h2 class="text-xl font-semibold mb-3 text-default font-display">Ontology Concepts ({{ concepts_total }})</h2>
  <div class="flex flex-wrap gap-2 mb-4">
    <input type="text" id="concept-search" placeholder="Filter concepts…" class="text-sm px-3 py-1.5 rounded-lg border border-muted bg-surface text-default w-full max-w-md">
    <select id="concept-pillar-filter" class="text-sm px-2 py-1.5 rounded-lg border border-muted bg-surface text-default">
      <option value="">All Pillars</option>
      <option value="aml">Compliance</option>
      <option value="stock">Markets</option>
      <option value="data-engineering">Data Engineering</option>
    </select>
  </div>
  <div id="concept-list" class="grid gap-3">
    <p class="text-sm text-muted" data-loading="concepts">Loading concepts…</p>
  </div>
  <p class="text-xs text-muted mt-4">{{ concepts_total }} concepts &middot; {{ relations_total }} relations &middot; {{ philosophy_metadata_count }} with lineage</p>
</section>

{# ============================================ EVIDENCE ============================================ #}
<section class="console-panel" data-panel="evidence" style="display:none">
  <h2 class="text-xl font-semibold mb-3 text-default font-display">Evidence &amp; Contradictions</h2>
  <p class="text-sm text-muted mb-4">GRADE-style evidence grading, source trails, and contradiction detection run at build time across all content with source claims.</p>
  <div class="ghost-card p-4 text-center">
    <p class="text-muted text-sm">Evidence grading and contradiction detection results appear in build logs and are surfaced per-item via <a href="/research/workspace/" class="text-accent">Research Workspace</a> pages. Check build output for &quot;source-trails&quot;, &quot;contradictions&quot;, and &quot;evidence-grades&quot;.</p>
  </div>
  <div class="flex flex-wrap gap-2 mt-4">
    <a href="/research/workspace/" class="btn-ghost-sm text-xs">Open Research Workspace</a>
    <a href="/sources/" class="btn-ghost-sm text-xs">Source Trust Dashboard</a>
  </div>
</section>

{# ============================================ SOURCES ============================================ #}
<section class="console-panel" data-panel="sources" style="display:none">
  <h2 class="text-xl font-semibold mb-3 text-default font-display">Inspiration Sources ({{ source_total }})</h2>
  <p class="text-sm text-muted mb-4">Credit-checked weekly (Monday 04:00 UTC). Active: {{ source_active }} &middot; Degraded: {{ source_degraded }} &middot; Down: {{ source_error }}.</p>
  <div class="grid gap-2">
    {% for src in source_summary %}
    <div class="ghost-card p-3 flex items-center gap-3">
      <div class="w-3 h-3 rounded-full shrink-0"
        {% if src.status == "active" %} style="background:#22c55e"
        {% elif src.status == "degraded" %} style="background:#f59e0b"
        {% else %} style="background:#ef4444"
        {% endif %}
      ></div>
      <div class="flex-1 min-w-0">
        <p class="text-xs font-semibold truncate">{{ src.name }}</p>
        <p class="text-[10px] text-muted">{{ src.key }} &middot; pillar: {{ src.pillar }}</p>
      </div>
      <div class="text-end">
        <p class="text-xs font-bold {% if src.status == 'active' %}text-green-500{% elif src.status == 'degraded' %}text-yellow-500{% else %}text-red-500{% endif %}">{{ src.status | title }}</p>
        <p class="text-[10px] text-muted">HTTP {{ src.http_status }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{# ============================================ CONTENT ° ============================================ #}
<section class="console-panel" data-panel="content" style="display:none">
  <h2 class="text-xl font-semibold mb-3 text-default font-display">Content Index ({{ items_total }})</h2>
  <div class="flex flex-wrap gap-2 mb-4">
    <input type="text" id="item-search" placeholder="Search by title…" class="text-sm px-3 py-1.5 rounded-lg border border-muted bg-surface text-default w-full max-w-md">
    <select id="content-pillar-filter" class="text-sm px-2 py-1.5 rounded-lg border border-muted bg-surface text-default">
      <option value="">All Pillars</option>
      <option value="aml">Compliance</option>
      <option value="stock">Markets</option>
      <option value="data-engineering">Data Engineering</option>
    </select>
    <select id="content-type-filter" class="text-sm px-2 py-1.5 rounded-lg border border-muted bg-surface text-default">
      <option value="">All Types</option>
      <option value="research">Research</option>
      <option value="learn">Learn</option>
      <option value="knowledge">Knowledge</option>
    </select>
  </div>
  <div id="content-list" class="grid gap-2">
    <p class="text-sm text-muted" data-loading="content">Loading content index…</p>
  </div>
</section>

{# ============================================ FEYNMAN ============================================ #}
<section class="console-panel" data-panel="feynman" style="display:none">
  <h2 class="text-xl font-semibold mb-3 text-default font-display">Feynman Learning Quality</h2>
  <p class="text-sm text-muted mb-4">Explanation quality scores for all {{ concepts_total }} concepts with Feynman explanations or analogies.</p>
  <div id="feynman-list" class="grid gap-3 grid-cols-1 sm:grid-cols-2">
    <p class="text-sm text-muted" data-loading="feynman">Loading Feynman explanations…</p>
  </div>
</section>

{# ============================================ HEALTH ============================================ #}
<section class="console-panel" data-panel="health" style="display:none">
  <h2 class="text-xl font-semibold mb-3 text-default font-display">System Health</h2>

  <div class="grid gap-4 grid-cols-3 mb-4">
    <div class="ghost-card p-4 text-center">
      <div class="text-2xl font-bold text-green-500">{{ source_active }}</div>
      <p class="text-xs text-muted">Active Sources</p>
    </div>
    <div class="ghost-card p-4 text-center">
      <div class="text-2xl font-bold text-yellow-500">{{ source_degraded }}</div>
      <p class="text-xs text-muted">Degraded</p>
    </div>
    <div class="ghost-card p-4 text-center">
      <div class="text-2xl font-bold text-red-500">{{ source_error }}</div>
      <p class="text-xs text-muted">Down</p>
    </div>
  </div>

  <div class="ghost-card p-4 mb-4">
    <h3 class="text-xs font-semibold mb-2">Content Freshness Status</h3>
    {% if freshness_summary %}
    <div class="flex flex-wrap gap-3">
      <span class="badge-outline text-xs" style="background:#22c55e20;color:#22c55e">Fresh: {{ freshness_summary.get("fresh", 0) }}</span>
      <span class="badge-outline text-xs" style="background:#f59e0b20;color:#f59e0b">Stale: {{ freshness_summary.get("stale", 0) }}</span>
      <span class="badge-outline text-xs" style="background:#ef444420;color:#ef4444">Outdated: {{ freshness_summary.get("outdated", 0) }}</span>
    </div>
    {% else %}
    <p class="text-xs text-muted">Run scripts/check_entry_freshness.py to generate this data.</p>
    {% endif %}
  </div>

  <p class="text-xs text-muted mt-4">
    Last health check: {{ last_scored or 'not yet' }} &middot;
    Philosophy metadata: {{ philosophy_metadata_count }} concepts &middot;
    {% if payload_hash %}
    Payload: <code class="text-[10px]">{{ payload_hash[:12] }}</code>
    {% endif %}
  </p>
</section>

{# ═══════════════════ ACTION BAR ════════════════ #}
<div class="mt-10 pt-6 border-t border-muted/30">
  <h3 class="text-sm font-semibold mb-3 text-default">Quick Tools</h3>
  <div class="flex flex-wrap gap-2">
    <a href="/review/" class="btn-ghost-sm text-xs">Review Dashboard</a>
    <a href="/graph/" class="btn-ghost-sm text-xs">Knowledge Graph</a>
    <a href="/search/" class="btn-ghost-sm text-xs">Search</a>
    <a href="/admin/" class="btn-ghost-sm text-xs">Admin Panel</a>
    <a href="/letters/" class="btn-ghost-sm text-xs">Alpha Index</a>
    <a href="/sources/" class="btn-ghost-sm text-xs">Source Trust</a>
    <a href="/compliance/synthesis/" class="btn-ghost-sm text-xs">Cross-Pillar Synthesis</a>
  </div>
</div>

<script src="{{ 'js/console.js' | asset }}" defer></script>

{% include 'partials/newsletter.html' %}
{% endblock %}