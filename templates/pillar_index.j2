{% extends "layout.j2" %}
{% from "macros/pillar_badge.html" import pillar_badge %}
{% from "macros/breadcrumbs.html" import breadcrumbs %}
{% block main_content %}
<section>
{{ breadcrumbs(page_path, pconf.heading) }}

  {%- set hero_map = {"aml": "pillar-aml-hero", "stock": "pillar-stock-hero", "data-engineering": "pillar-data-engineering-hero"} %}
  {%- set hero = hero_map.get(pillar, "pillar-aml-hero") %}
  <div class="mb-8 rounded-xl overflow-hidden">
    <img src="/static/images/{{ hero }}.svg" alt="{{ pconf.heading }} illustration" width="600" height="340" class="w-full h-auto" loading="lazy" decoding="async">
  </div>

  <div class="mb-8">
    {{ pillar_badge(pillar) }}
    <h1 class="text-3xl font-extrabold" style="color:var(--color-text)">{{ pconf.heading }}</h1>
    <p class="mt-2 text-sm" style="color:var(--color-text-secondary)">{{ pconf.description }}</p>
    <p class="mt-1 text-sm" style="color:var(--color-text-muted)">{{ posts | length }} posts</p>
    {%- if pillar == "aml" %}
    <a href="/aml/signals/" class="inline-flex items-center gap-1.5 mt-2 px-3 py-1.5 text-xs font-medium rounded transition hover:opacity-80" style="background:rgba(217,119,6,0.1);color:#d97706;border:1px solid rgba(217,119,6,0.2)">
      🛡️ Signals Dashboard →
    </a>
    {%- endif %}
  </div>

  <div class="flex flex-col gap-2">
    {%- for post in posts %}
    {%- set pictogram = post | pictogram %}
    {%- set source_breakdown = post.source_breakdown or {} %}
    {%- set pillar_color = pillar_config.get(pillar, {}).get("color", "#6366f1") %}
    {%- set pillar_icon = pillar_emojis.get(pillar, "") %}
    {%- set risk_count = post.quality_flags | length if post.quality_flags else 0 %}
    <a href="/{{ post.slug }}/" class="card-research" style="text-decoration:none">
      <div class="card-research-left">
        <div class="card-pictogram-wrap">
          <img src="/static/images/{{ pictogram }}" alt="" class="card-pictogram" decoding="async">
        </div>
        <div class="card-research-sources">
        {%- for src, count in source_breakdown.items() if count > 0 %}
        {%- set src_class = "src-hn" if src == "hn" or src == "hackernews" else "src-ar" if src == "arxiv" or src == "ar" else "src-pu" %}
        <span class="card-research-source {{ src_class }}">{{ src[:2].upper() }}</span>
        {%- endfor %}
        </div>
      </div>
      <div class="card-research-body">
        <div class="card-research-meta">
          <span class="card-research-pillar" style="color:{{ pillar_color }}">{{ pillar_icon }} {{ pconf.label }}</span>
          <span class="card-research-meta-right">
            {%- if post.date_str %}
            <time datetime="{{ post.date_str }}">{{ post.date_str }}</time>
            {%- endif %}
            {%- if post.body_html %}
            <span>{{ post.body_html | reading_time }} min</span>
            {%- endif %}
          </span>
        </div>
        <h2 class="card-research-title">{{ post.title | striptags }}</h2>
        {%- if post.description %}
        <p class="card-research-summary">{{ post.description[:200] }}</p>
        {%- endif %}
        {%- if risk_count > 0 %}
        <div class="card-research-risk">&#9888; {{ risk_count }} quality flag(s)</div>
        {%- endif %}
      </div>
    </a>
    {%- endfor %}
  </div>
</section>

{% include 'partials/newsletter.html' %}

{% endblock %}
