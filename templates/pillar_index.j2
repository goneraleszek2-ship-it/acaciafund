{% extends "layout.j2" %}
{% from "macros/pillar_badge.html" import pillar_badge %}
{% from "macros/sqi_chip.html" import sqi_chip %}
{% from "macros/breadcrumbs.html" import breadcrumbs %}
{% block main_content %}
<section>
{{ breadcrumbs(page_path, pconf.heading) }}

  {%- set hero_map = {"aml": "pillar-aml-hero", "stock": "pillar-stock-hero", "data-engineering": "pillar-data-engineering-hero"} %}
  {%- set hero = hero_map.get(pillar, "pillar-aml-hero") %}
  <div class="mb-8 rounded-xl overflow-hidden">
    <img src="/static/images/{{ hero }}.svg" alt="{{ pconf.heading }} illustration" width="600" height="340" class="w-full h-auto" loading="lazy">
  </div>

  <div class="mb-8">
    {{ pillar_badge(pillar) }}
    <h1 class="text-3xl font-extrabold text-gray-900 mt-2">{{ pconf.heading }}</h1>
    <p class="mt-2 text-gray-600">{{ pconf.description }}</p>
    <p class="mt-1 text-sm text-gray-400">{{ posts | length }} posts</p>
    {%- if pillar == "aml" %}
    <a href="/aml/signals/" class="inline-flex items-center gap-1.5 mt-2 px-3 py-1.5 text-xs font-medium rounded transition hover:opacity-80" style="background:rgba(217,119,6,0.1);color:#d97706;border:1px solid rgba(217,119,6,0.2)">
      🛡️ Signals Dashboard →
    </a>
    {%- endif %}
  </div>

  <div class="space-y-4">
    {%- for post in posts %}
    {%- set tkey = thumbnail_key(post.title) %}
    <article class="flex gap-4 rounded-lg p-4 transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border);border-left:3px solid var(--color-{{ pillar }})">
      <div class="shrink-0 w-28 h-20 rounded-md overflow-hidden bg-gray-800 hidden sm:block">
        <img src="{{ thumbnail_base }}/thumb_{{ tkey }}.svg" alt="" width="600" height="340" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h2 class="text-lg font-semibold leading-snug" style="color:var(--color-text)">
              <a href="/{{ post.slug }}/" class="hover:text-blue-600 transition">{{ post.title | striptags }}</a>
            </h2>
            {%- if post.description %}
            <p class="mt-1 text-sm" style="color:var(--color-text-secondary)">{{ post.description[:200] }}</p>
            {%- endif %}
            <div class="mt-2 flex items-center gap-3 text-xs" style="color:var(--color-text-muted)">
              {%- if post.date_str %}
              <time datetime="{{ post.date_str }}">{{ post.date_str }}</time>
              {%- endif %}
              {%- if post.body_html %}
              <span>{{ post.body_html | reading_time }} min</span>
              {%- endif %}
              {%- if post.signals and post.signals.get("avg_sqi") is defined %}
              {{ sqi_chip(post.signals.get("avg_sqi", 0)) }}
              {%- endif %}
              {%- if post.source_breakdown %}
              <span>{{ post.source_breakdown.get("hn", 0) }} HN · {{ post.source_breakdown.get("arxiv", 0) }} arXiv</span>
              {%- endif %}
            </div>
          </div>
          {%- if post.quality_metrics and post.quality_metrics.get("avg_source_score") is defined %}
          <div class="hidden sm:flex flex-col items-end gap-1 text-xs" style="color:var(--color-text-muted)">
            <span>Quality {{ "%.2f"|format(post.quality_metrics.get("avg_source_score", 0)) }}</span>
            <span>Diversity {{ "%.2f"|format(post.quality_metrics.get("source_diversity", 0)) }}</span>
          </div>
          {%- endif %}
        </div>
      </div>
    </article>
    {%- endfor %}
  </div>
</section>

{% include 'partials/newsletter.html' %}

{% endblock %}
