<!DOCTYPE html>
<html lang="{{ content.language | default('en') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title | default(content.title | striptags) }} | AcaciaFund</title>
  <meta name="description" content="{{ content.description | default(site_description | default(content.body_html | striptags | truncate(160))) }}">
  {%- if robots_noindex %}<meta name="robots" content="noindex,follow">{% endif %}
  <meta name="generator" content="AcaciaFund Python-native Pipeline">
  <meta name="theme-color" content="#f5f0eb" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1a1a2e" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href="{{ site_url }}/{{ page_path }}">
  <link rel="icon" href="/static/images/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="AcaciaFund Research" href="/feed.xml">

  <meta property="og:title" content="{{ content.title | striptags }}">
  <meta property="og:site_name" content="AcaciaFund">
  <meta property="og:url" content="{{ site_url }}/{{ page_path }}">
  <meta property="og:image" content="{{ og_image_url | default(site_url + '/static/images/og-card.png') }}">
  <meta property="og:description" content="{{ content.description | default(site_description | default(content.body_html | striptags | truncate(160))) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ content.title | striptags }}">
  <meta name="twitter:description" content="{{ content.description | default(site_description | default(content.body_html | striptags | truncate(160))) }}">
  <meta name="twitter:image" content="{{ og_image_url | default(site_url + '/static/images/og-card.png') }}">

  {%- if content.content_type == "research" or content.category == "blog" %}
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{ content.created_at.isoformat() if content.created_at else '' }}">
  {%- set sqi_val = content.signals.get("avg_sqi", "") if content.signals else "" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ content.title | striptags | tojson }},
    "datePublished": "{{ content.created_at.isoformat() if content.created_at else '' }}",
    "image": "{{ og_image_url | default(site_url + '/static/images/og-card.png') }}",
    "author": { "@type": "Person", "name": "{{ content.author | default('Leszek') }}" },
    "publisher": { "@type": "Organization", "name": "AcaciaFund" }{% if sqi_val %},
    "review": {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "{{ sqi_val }}",
        "bestRating": "1.0"
      }
    }
    {%- endif %}
  }
  </script>
  {%- elif content.content_type == "learn" %}
  <meta property="og:type" content="website">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    "name": {{ content.title | striptags | tojson }},
    "learningResourceType": "Lesson",
    "educationalLevel": "{{ (content.difficulty or 'intermediate') | capitalize }}"
  }
  </script>
  {%- elif content.content_type == "knowledge" or page_type == "index" %}
  <meta property="og:type" content="website">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ content.title | striptags | tojson }},
    "url": "{{ site_url }}/{{ page_path }}",
    "publisher": { "@type": "Organization", "name": "AcaciaFund", "url": "{{ site_url }}" }
  }
  </script>
  {%- endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "AcaciaFund",
    "url": "{{ site_url }}/",
    "description": {{ site_description | tojson }}
  }
  </script>
  {%- if page_path != "" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site_url }}/" },
      { "@type": "ListItem", "position": 2, "name": "{{ content.title | striptags }}", "item": "{{ site_url }}/{{ page_path }}" }
    ]
  }
  </script>
  {%- endif %}

  <script>
    (function(){
      var t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else if (t === 'light') {
        document.documentElement.classList.add('light');
      }
    })();
  </script>
  <link rel="stylesheet" href="/static/css/tailwind.min.css{{ "?v=" + build_hash if build_hash else "" }}">
  <link rel="stylesheet" href="/static/css/custom.css{{ "?v=" + build_hash if build_hash else "" }}">
  <link rel="preload" href="/static/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/Inter-SemiBold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/Inter-Bold.woff2" as="font" type="font/woff2" crossorigin>
  {%- if plausible_domain %}
  <script defer data-domain="{{ plausible_domain }}" src="https://plausible.io/js/script.js"></script>
  {%- endif %}
  {%- block head_extra %}{% endblock %}
</head>
<body class="antialiased">
  <a href="#main" class="skip-link">Skip to content</a>

  <header class="sticky top-0 z-50 backdrop-blur border-b border-b-[var(--color-border)]" style="background:var(--color-header-bg)">
    <nav class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between" aria-label="Main navigation">
      <a href="/" class="text-lg font-bold tracking-tight whitespace-nowrap">
        Acacia<span style="color:var(--color-accent)">Fund</span>
      </a>

      <!-- Desktop nav -->
      <ul class="hidden sm:flex gap-3 lg:gap-5 text-sm font-medium" style="color:var(--color-text-secondary)" role="list">
        <li><a href="/research/" class="nav-link"{% if page_path and page_path.startswith("research/") %} aria-current="page"{% endif %}>Research</a></li>
        <li><a href="/learn/" class="nav-link"{% if page_path and page_path.startswith("learn/") %} aria-current="page"{% endif %}>Learn</a></li>
        <li><a href="/knowledge/" class="nav-link"{% if page_path and page_path.startswith("knowledge/") %} aria-current="page"{% endif %}>Knowledge</a></li>
        <li><span class="nav-sep hidden lg:inline" style="color:var(--color-border);width:1px;height:1em;display:inline-block;margin:0 0.25rem" aria-hidden="true">|</span></li>
        <li><a href="/aml/" class="nav-link flex items-center gap-1"{% if page_path and page_path.startswith("aml/") %} aria-current="page"{% endif %}><span class="w-1.5 h-1.5 rounded-full inline-block" style="background:var(--color-aml,#c97d3e)"></span>AML</a></li>
        <li><a href="/stock/" class="nav-link flex items-center gap-1"{% if page_path and page_path.startswith("stock/") %} aria-current="page"{% endif %}><span class="w-1.5 h-1.5 rounded-full inline-block" style="background:var(--color-markets,#2e7d5b)"></span>Markets</a></li>
        <li><a href="/data-engineering/" class="nav-link flex items-center gap-1"{% if page_path and page_path.startswith("data-engineering/") %} aria-current="page"{% endif %}><span class="w-1.5 h-1.5 rounded-full inline-block" style="background:var(--color-data-engineering,#5a4fcf)"></span>Data</a></li>
        <li><a href="/knowledge/about/" class="nav-link hidden lg:inline">About</a></li>
        <li><a href="/search/" class="nav-link" aria-label="Search">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </a></li>
      </ul>

      <div class="flex items-center gap-2">
        <button id="dark-toggle" class="p-2 rounded-lg transition" style="color:var(--color-text-muted)" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </button>
      </div>

      <!-- Mobile toggle -->
      <button class="sm:hidden mobile-nav-toggle p-2" aria-label="Toggle navigation menu" aria-expanded="false" data-mobile-toggle>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </nav>
  </header>

  <!-- Mobile nav dialog (native <dialog> for focus trap, escape, scrim) -->
  <dialog id="mobile-nav-dialog" class="mobile-nav-dialog">
    <div class="mobile-nav-scroll">
      <div class="mobile-nav-section">
        <div class="mobile-nav-label">Content</div>
        <a href="/research/" class="mobile-nav-item">Research</a>
        <a href="/learn/" class="mobile-nav-item">Learn</a>
        <a href="/knowledge/" class="mobile-nav-item">Knowledge Base</a>
      </div>
      <div class="mobile-nav-section">
        <div class="mobile-nav-label">Pillars</div>
        <a href="/aml/" class="mobile-nav-item mobile-nav-pillar">
          <span class="pillar-dot" style="background:var(--color-aml)"></span>AML
        </a>
        <a href="/stock/" class="mobile-nav-item mobile-nav-pillar">
          <span class="pillar-dot" style="background:var(--color-markets)"></span>Markets
        </a>
        <a href="/data-engineering/" class="mobile-nav-item mobile-nav-pillar">
          <span class="pillar-dot" style="background:var(--color-data-engineering)"></span>Data Engineering
        </a>
      </div>
      <div class="mobile-nav-section">
        <div class="mobile-nav-label">Resources</div>
        <a href="/knowledge/diagrams/" class="mobile-nav-item">Diagrams</a>
        <a href="/knowledge/about/" class="mobile-nav-item">About</a>
        <a href="/knowledge/contact/" class="mobile-nav-item">Contact</a>
      </div>
      <div class="mobile-nav-section">
        <div class="mobile-nav-label">Discover</div>
        <a href="/tags/" class="mobile-nav-item">Tags</a>
        <a href="/search/" class="mobile-nav-item">Search</a>
      </div>
    </div>
    <div class="mobile-nav-close-bar">
      <button class="mobile-nav-close-btn" data-mobile-close aria-label="Close navigation">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        Close
      </button>
    </div>
  </dialog>

  <main id="main" class="max-w-5xl mx-auto px-4 py-8" tabindex="-1">
    {%- block main_content %}{{ content.body_html | safe }}{% endblock %}
  </main>

  <footer class="mt-16 border-t" style="border-color:var(--color-border);background:var(--color-surface)">
    <div class="max-w-5xl mx-auto px-4 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-sm" style="color:var(--color-text-secondary)">
        <div>
          <a href="/" class="text-lg font-bold tracking-tight" style="color:var(--color-text)">
            Acacia<span style="color:var(--color-accent)">Fund</span>
          </a>
          <p class="mt-2 text-xs" style="color:var(--color-text-muted)">Research synthesis &amp; experimental learning platform. Static-first, privacy-preserving.</p>
          <div class="mt-4">
            <div class="pillar-matrix" role="img" aria-label="Color system matrix: 3 pillars × 3 content layers">
              <div></div>
              <div class="pillar-matrix-header">AML</div>
              <div class="pillar-matrix-header">Markets</div>
              <div class="pillar-matrix-header">Data&nbsp;Eng</div>
              <div class="pillar-matrix-label">Research</div>
              <div class="pillar-matrix-cell matrix-tooltip" style="background:var(--matrix-aml-research)" data-label="AML Research"></div>
              <div class="pillar-matrix-cell matrix-tooltip" style="background:var(--matrix-markets-research)" data-label="Markets Research"></div>
              <div class="pillar-matrix-cell matrix-tooltip" style="background:var(--matrix-de-research)" data-label="DE Research"></div>
              <div class="pillar-matrix-label">Knowledge</div>
              <div class="pillar-matrix-cell matrix-tooltip" style="background:var(--matrix-aml-knowledge)" data-label="AML Knowledge"></div>
              <div class="pillar-matrix-cell matrix-tooltip" style="background:var(--matrix-markets-knowledge)" data-label="Markets Knowledge"></div>
              <div class="pillar-matrix-cell matrix-tooltip" style="background:var(--matrix-de-knowledge)" data-label="DE Knowledge"></div>
              <div class="pillar-matrix-label">Learn</div>
              <div class="pillar-matrix-cell matrix-tooltip" style="background:var(--matrix-aml-learn)" data-label="AML Learn"></div>
              <div class="pillar-matrix-cell matrix-tooltip" style="background:var(--matrix-markets-learn)" data-label="Markets Learn"></div>
              <div class="pillar-matrix-cell matrix-tooltip" style="background:var(--matrix-de-learn)" data-label="DE Learn"></div>
            </div>
          </div>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider" style="color:var(--color-text-muted)">Content</h3>
          <ul class="mt-3 space-y-2" role="list">
            <li><a href="/research/" class="hover:opacity-70 transition">Research</a></li>
            <li><a href="/learn/" class="hover:opacity-70 transition">Learn</a></li>
            <li><a href="/knowledge/" class="hover:opacity-70 transition">Knowledge Base</a></li>
            <li><a href="/tags/" class="hover:opacity-70 transition">Tags</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider" style="color:var(--color-text-muted)">Pillars</h3>
          <ul class="mt-3 space-y-2" role="list">
            <li><a href="/aml/" class="hover:opacity-70 transition flex items-center gap-1.5"><span class="w-2 h-2 rounded-full inline-block" style="background:var(--color-aml,#c97d3e)"></span>AML</a></li>
            <li><a href="/stock/" class="hover:opacity-70 transition flex items-center gap-1.5"><span class="w-2 h-2 rounded-full inline-block" style="background:var(--color-markets,#2e7d5b)"></span>Markets</a></li>
            <li><a href="/data-engineering/" class="hover:opacity-70 transition flex items-center gap-1.5"><span class="w-2 h-2 rounded-full inline-block" style="background:var(--color-data-engineering,#5a4fcf)"></span>Data Engineering</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider" style="color:var(--color-text-muted)">Connect</h3>
          <ul class="mt-3 space-y-2" role="list">
            <li><a href="/knowledge/about/" class="hover:opacity-70 transition">About</a></li>
            <li><a href="/feed.xml" class="hover:opacity-70 transition">RSS Feed</a></li>
            <li><a href="/search/" class="hover:opacity-70 transition">Search</a></li>
          </ul>
        </div>
      </div>
      <div class="mt-8 pt-6 border-t text-center text-xs" style="border-color:var(--color-border);color:var(--color-text-muted)">
        <p>&copy; {{ year }} AcaciaFund. All rights reserved.</p>
      </div>
    </div>
  </footer>

  {% include 'partials/search_palette.html' %}

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Dropdown
      document.querySelectorAll('[data-dropdown]').forEach(function(dd) {
        var trigger = dd.querySelector('[data-dropdown-trigger]');
        var menu = dd.querySelector('[data-dropdown-menu]');
        if (!trigger || !menu) return;
        trigger.addEventListener('click', function(e) {
          e.stopPropagation();
          var expanded = trigger.getAttribute('aria-expanded') === 'true';
          trigger.setAttribute('aria-expanded', !expanded);
          menu.classList.toggle('dropdown-menu-open');
        });
        dd.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            trigger.setAttribute('aria-expanded', 'false');
            menu.classList.remove('dropdown-menu-open');
            trigger.focus();
          }
        });
        document.addEventListener('click', function(e) {
          if (!dd.contains(e.target)) {
            trigger.setAttribute('aria-expanded', 'false');
            menu.classList.remove('dropdown-menu-open');
          }
        });
      });
      // Dark mode toggle
      var darkToggle = document.getElementById('dark-toggle');
      if (darkToggle) {
        darkToggle.addEventListener('click', function() {
          if (document.documentElement.classList.contains('dark')) {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.classList.remove('light');
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
        });
      }
      // Mobile nav via native <dialog>
      var mobToggle = document.querySelector('[data-mobile-toggle]');
      var mobDialog = document.getElementById('mobile-nav-dialog');
      var mobClose = document.querySelector('[data-mobile-close]');
      if (mobToggle && mobDialog) {
        mobToggle.addEventListener('click', function() {
          mobDialog.showModal();
        });
        if (mobClose) {
          mobClose.addEventListener('click', function() {
            mobDialog.close();
          });
        }
        mobDialog.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', function() {
            mobDialog.close();
          });
        });
      }
      // Search palette (Cmd+K / Ctrl+K)
      var paletteDialog = document.getElementById('search-palette');
      var paletteInput = document.getElementById('palette-input');
      var paletteResults = document.getElementById('palette-results');
      var paletteIndex = null;
      function loadPaletteIndex() {
        if (paletteIndex) return Promise.resolve(paletteIndex);
        return fetch('/static/search-index.json').then(function(r) { return r.json(); }).then(function(data) {
          paletteIndex = data;
          return data;
        }).catch(function() { return []; });
      }
      function openPalette() {
        if (!paletteDialog) return;
        paletteDialog.showModal();
        if (paletteInput) { paletteInput.value = ''; paletteInput.focus(); }
        if (paletteResults) paletteResults.innerHTML = '<p class="text-sm py-8 text-center" style="color:var(--color-text-muted)">Type at least 2 characters to search.</p>';
      }
      function closePalette() {
        if (paletteDialog) paletteDialog.close();
      }
      function searchPalette(query) {
        if (!paletteResults) return;
        var q = query.trim().toLowerCase();
        if (q.length < 2) {
          paletteResults.innerHTML = '<p class="text-sm py-8 text-center" style="color:var(--color-text-muted)">Type at least 2 characters to search.</p>';
          return;
        }
        loadPaletteIndex().then(function(idx) {
          var hits = idx.filter(function(item) {
            return (item.title && item.title.toLowerCase().includes(q)) ||
                   (item.description && item.description.toLowerCase().includes(q)) ||
                   ((item.tags || []).join(' ').toLowerCase().includes(q));
          }).slice(0, 10);
          if (hits.length === 0) {
            paletteResults.innerHTML = '<p class="text-sm py-8 text-center" style="color:var(--color-text-muted)">No results found.</p>';
            return;
          }
          var html = '';
          hits.forEach(function(h) {
            var slug = h.slug || '';
            var label = h.content_type || 'article';
            var pillar = h.pillar || 'aml';
            html += '<a href="/' + slug + '/" class="palette-result" style="border-left-color:var(--color-' + pillar + ')">' +
              '<div class="palette-result-title">' + escapeHtml(h.title || slug) + '</div>' +
              '<div class="palette-result-meta">' + label + '</div>' +
              '</a>';
          });
          paletteResults.innerHTML = html;
        });
      }
      function escapeHtml(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }
      if (paletteInput) {
        paletteInput.addEventListener('input', function() { searchPalette(paletteInput.value); });
        paletteInput.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') { e.stopPropagation(); closePalette(); }
          if (e.key === 'Enter') {
            var first = paletteResults && paletteResults.querySelector('a');
            if (first) { closePalette(); window.location.href = first.getAttribute('href'); }
          }
        });
      }
      document.addEventListener('keydown', function(e) {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          if (paletteDialog && paletteDialog.open) { closePalette(); } else { openPalette(); }
        }
      });
      // Close palette on backdrop click
      if (paletteDialog) {
        paletteDialog.addEventListener('click', function(e) {
          if (e.target === paletteDialog) closePalette();
        });
      }
    });
  </script>
</body>
</html>
