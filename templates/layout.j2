<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ content.title | default(site_name) }}</title>
    <meta name="description" content="{{ content.description | default(site_description) }}">
    <link rel="icon" href="/favicon.ico">

    <link rel="preload" href="{{ 'fonts/Inter-0.woff2' | asset }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ 'css/design-system.css' | asset }}">

{% if jsonld is defined and jsonld %}
    <script type="application/ld+json">
{{ jsonld | tojson }}
    </script>
{% endif %}

    <script>!function(){var t,d=document.documentElement;try{t=localStorage.getItem('acacia_theme')}catch(e){}if(t){d.classList.add(t);d.setAttribute('data-theme',t)}else if(window.matchMedia('(prefers-color-scheme:dark)').matches){d.classList.add('dark');d.setAttribute('data-theme','dark')}}();</script>
    <style>
        .logo { font-size: 1.2rem; font-weight: 700; text-decoration: none; letter-spacing: -0.02em; }
        .nav-empty { opacity: 0.25; pointer-events: none; width: 1px; }
        .mode-toggle-sm { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.7rem; color: var(--color-text-muted); }
        .mode-toggle-sm select { font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 4px; background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-border); font-family: inherit; cursor: pointer; }
    </style>
{% if plausible_domain %}
    <script defer data-domain="{{ plausible_domain }}" src="https://{{ plausible_domain }}/js/script.js"></script>
{% endif %}
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div id="nav-overlay" class="nav-overlay" aria-hidden="true"></div>
    <header class="container">
        <nav>
            <ul>
                <li><strong><a href="/" class="contrast logo">Acacia</a></strong></li>
            </ul>
            <ul>
                <li><a href="/start-here/" style="font-weight:500">Start Here</a></li>
                <li><a href="/compliance/">Compliance</a></li>
                <li><a href="/markets/">Markets</a></li>
                <li><a href="/data/">Data</a></li>
                <li><span class="nav-empty">|</span></li>
                <li><a href="/review/" style="font-size:0.85rem">Review</a></li>
                <li><a href="/letters/" style="font-size:0.85rem">A-Z</a></li>
                <li><a href="/search/" style="font-size:0.85rem">Search</a></li>
                <li>
                  <span class="mode-toggle-sm">
                    <label for="mode-select" class="sr-only">Mode</label>
                    <select id="mode-select" aria-label="Learning mode">
                      <option value="beginner" selected>Beginner</option>
                      <option value="intermediate">Advanced</option>
                      <option value="expert">Expert</option>
                    </select>
                  </span>
                </li>
                <li>
                  <button id="theme-toggle" type="button" aria-label="Toggle theme" style="background:none;border:none;color:var(--color-text-muted);cursor:pointer;padding:0.25rem;line-height:1;font-size:1rem">
                    <svg id="theme-icon-moon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                    <svg id="theme-icon-sun" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                  </button>
                </li>
            </ul>
        </nav>
    </header>

    <main id="main-content" class="container">
        {% block main_content %}{% endblock %}
    </main>

    <footer class="container">
        <hr>
        <small>&copy; {{ year }} AcaciaFund &middot; Generated by the Acacia pipeline.</small>
    </footer>

    <script src="{{ 'js/app.js' | asset }}" defer></script>

</body>
</html>
