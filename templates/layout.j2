        <li><a href="/aml/" class="nav-link flex items-center gap-1"{% if page_path and page_path.startswith("aml/") %} aria-current="page"{% endif %}><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" class="inline-block"><path d="M12 3L4 7v6c0 5.5 3.4 10.7 8 12 4.6-1.3 8-6.5 8-12V7L12 3z" stroke="#c97d3e" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="14" r="2" fill="#fbbf24"/></svg>AML</a></li>
        <li><a href="/stock/" class="nav-link flex items-center gap-1"{% if page_path and page_path.startswith("stock/") %} aria-current="page"{% endif %}><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" class="inline-block"><polyline points="3,18 7,14 11,16 15,10 19,8 23,5" stroke="#3a7d5c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="23" cy="3" r="1.5" fill="#6ee7b7"/></svg>Markets</a></li>
        <li><a href="/data-engineering/" class="nav-link flex items-center gap-1"{% if page_path and page_path.startswith("data-engineering/") %} aria-current="page"{% endif %}><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" class="inline-block"><circle cx="12" cy="12" r="4" stroke="#6366f1" stroke-width="2"/><circle cx="12" cy="12" r="1.5" fill="#a5b4fc"/><path d="M12 8V3M12 8L9 5M12 8L15 5" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round"/></svg>Data</a></li>
        <li><a href="/knowledge/about/" class="nav-link hidden lg:inline">About</a></li>
        <li><a href="/search/" class="nav-link" aria-label="Search">
