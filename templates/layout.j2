        <li><a href="/research/" class="nav-link{% if layer == 'research' %} nav-active-research{% endif %}">Research</a></li>
        <li><a href="/learn/" class="nav-link{% if layer == 'learn' %} nav-active-learn{% endif %}">Learn</a></li>
        <li><a href="/knowledge/" class="nav-link{% if layer == 'knowledge' %} nav-active-knowledge{% endif %}">Knowledge</a></li>
