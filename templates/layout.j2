          <circle cx="24" cy="36" r="2.5" fill="#c97d3e" stroke="#1a1a2e" stroke-width="1.2"/>
          <circle cx="17" cy="41" r="2" fill="#fbbf24" stroke="#1a1a2e" stroke-width="1.2"/>
          <circle cx="31" cy="41" r="2" fill="#fbbf24" stroke="#1a1a2e" stroke-width="1.2"/>
          <line x1="24" y1="36" x2="17" y2="41" stroke="#c97d3e" stroke-width="1" opacity="0.7"/>
          <line x1="24" y1="36" x2="31" y2="41" stroke="#c97d3e" stroke-width="1" opacity="0.7"/>
        </svg>
        <span>Acacia<span style="color:var(--color-accent)">Fund</span></span>
      </a>

      <!-- Desktop nav -->
