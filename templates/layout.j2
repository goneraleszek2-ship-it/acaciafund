<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ content.title | default(site_name) }}</title>
    <meta name="description" content="{{ content.description | default(site_description) }}">
    <link rel="icon" href="/favicon.ico">
    <link rel="search" type="application/opensearchdescription+xml" title="AcaciaFund Search" href="{{ 'opensearch.xml' | asset }}">

    <link rel="preload" href="{{ 'fonts/Fraunces-var.woff2' | asset }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'fonts/Manrope-var.woff2' | asset }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ 'css/design-system.css' | asset }}">

{% if jsonld is defined and jsonld %}
    <script type="application/ld+json">
{{ jsonld | tojson }}
    </script>
{% endif %}

    <script>!function(){var t,d=document.documentElement;try{d.classList.add('js')}catch(e){}try{t=localStorage.getItem('acacia_theme')}catch(e){}if(t){d.classList.add(t);d.setAttribute('data-theme',t)}else if(window.matchMedia('(prefers-color-scheme:dark)').matches){d.classList.add('dark');d.setAttribute('data-theme','dark')}}();</script>
    <style>
        .logo { font-size: 1.25rem; font-weight: 700; text-decoration: none; letter-spacing: -0.02em; font-family: var(--font-display); }
        .logo .logo-mark { color: var(--color-accent); }
        .nav-empty { opacity: 0.25; pointer-events: none; width: 1px; }
        .mode-toggle-sm { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.7rem; color: var(--color-text-muted); }
        .mode-toggle-sm select { font-size: 1rem; padding: 0.15rem 0.4rem; border-radius: 4px; background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-border); font-family: inherit; cursor: pointer; }
        #settings-toggle, #theme-toggle { min-width: 40px; min-height: 40px; display: inline-flex; align-items: center; justify-content: center; }
    </style>
{% if plausible_domain %}
    <script defer data-domain="{{ plausible_domain }}" src="https://{{ plausible_domain }}/js/script.js"></script>
{% endif %}
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div id="nav-overlay" class="nav-overlay" aria-hidden="true"></div>
    <header class="container">
        <nav aria-label="Main navigation">
            <ul>
                <li><strong><a href="/" class="contrast logo"><span class="logo-mark">Acacia</span>Fund</a></strong></li>
            </ul>
            <button class="nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-menu">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <ul id="primary-menu">
                <li><a href="/start-here/" style="font-weight:500">Start Here</a></li>
                <li><a href="/news/" style="font-weight:500">News</a></li>
                <li><a href="/compliance/">Compliance</a></li>
                <li><a href="/markets/">Markets</a></li>
                <li><a href="/data/">Data</a></li>
                <li><span class="nav-empty">|</span></li>
                <li><a href="/study/" style="font-size:0.85rem" title="Study Queue (due flashcards & concepts)"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="display:inline-block;vertical-align:-2px;margin-right:3px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>Study</a></li>
                <li><a href="/review/" style="font-size:0.85rem">Review</a></li>
                <li><a href="/diagnostic/" style="font-size:0.85rem" title="Diagnostic placement quiz">Diagnostic</a></li>
                <li><a href="/journeys/" style="font-size:0.85rem" title="Cross-pillar learning journeys">Journeys</a></li>
                <li><a href="/scholar/" style="font-size:0.85rem;font-weight:600">Console</a></li>
                <li><a href="/letters/" style="font-size:0.85rem">A-Z</a></li>
                <li><a href="/search/" aria-label="Search" title="Search (press s)" class="btn-search" style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.85rem"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>Search</a></li>
                <li>
                  <span class="mode-toggle-sm">
                    <label for="mode-select" class="sr-only">Mode</label>
                    <select id="mode-select" aria-label="Learning mode">
                      <option value="beginner" selected>Beginner</option>
                      <option value="intermediate">Advanced</option>
                      <option value="expert">Expert</option>
                    </select>
                  </span>
                </li>
                <li>
                  <button id="settings-toggle" type="button" aria-label="Reading settings" class="btn-settings" style="background:none;border:none;color:var(--color-text-muted);cursor:pointer;padding:0.25rem;line-height:1;font-size:1rem" title="Reading preferences">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  </button>
                </li>
                <li>
                  <button id="theme-toggle" type="button" aria-label="Toggle theme" style="background:none;border:none;color:var(--color-text-muted);cursor:pointer;padding:0.25rem;line-height:1;font-size:1rem">
                    <svg id="theme-icon-moon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                    <svg id="theme-icon-sun" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                  </button>
                </li>
            </ul>
        </nav>
    </header>

    <div id="settings-panel" class="settings-panel" aria-hidden="true" role="dialog" aria-label="Reading preferences">
      <div class="settings-panel-inner">
        <button id="settings-close" class="settings-close" aria-label="Close settings">&times;</button>
        <div class="settings-section">
          <h4 class="settings-heading">Reading Flow</h4>
          <label class="settings-row">
            <span>Focus mode</span>
            <input type="checkbox" id="focus-toggle" class="settings-toggle">
          </label>
          <label class="settings-row">
            <span>Reading guide</span>
            <input type="checkbox" id="guide-toggle" class="settings-toggle">
          </label>
        </div>
        <div class="settings-section">
          <h4 class="settings-heading">Information Density</h4>
          <div class="settings-density">
            <button type="button" class="density-btn" data-density="compact">Compact</button>
            <button type="button" class="density-btn active" data-density="standard">Standard</button>
            <button type="button" class="density-btn" data-density="comfortable">Comfortable</button>
          </div>
        </div>
        <div class="settings-section">
          <h4 class="settings-heading">Presentation</h4>
          <p class="settings-hint">Preferred way to absorb content.</p>
          <div class="settings-density" id="modality-options">
            <button type="button" class="density-btn" data-modality="visual">Visual</button>
            <button type="button" class="density-btn active" data-modality="balanced">Balanced</button>
            <button type="button" class="density-btn" data-modality="verbal">Verbal</button>
          </div>
        </div>
        <div class="settings-section">
          <h4 class="settings-heading">Learning Profile</h4>
          <div class="settings-row settings-row-between">
            <span>Difficulty</span>
            <button type="button" id="calibrate-btn" class="settings-mini-btn">Calibrate</button>
          </div>
          <div class="settings-row settings-row-between">
            <span>Interests</span>
            <button type="button" id="interests-btn" class="settings-mini-btn">Choose</button>
          </div>
        </div>
      </div>
    </div>
    <main id="main-content" class="container">
        {% block main_content %}{% endblock %}
    </main>

    <footer class="container">
        <hr>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between">
            <small>&copy; {{ year }} AcaciaFund &middot; Invest in understanding, to build resilience. &middot; <a href="/news/" style="color:inherit;text-decoration:underline">News &amp; signals</a></small>
            <nav style="display:flex;flex-wrap:wrap;gap:1rem;font-size:0.8rem" aria-label="Footer">
                <a href="/graph/" style="color:inherit;text-decoration:none">Knowledge Graph</a>
                <a href="/scholar/" style="color:inherit;text-decoration:none">Console</a>
                <a href="/review/" style="color:inherit;text-decoration:none">Review</a>
                <a href="/letters/" style="color:inherit;text-decoration:none">A-Z Index</a>
                <a href="/design-system/" style="color:inherit;text-decoration:none">Design System</a>
                <a href="/search/" style="color:inherit;text-decoration:none">Search</a>
            </nav>
        </div>
    </footer>

    <nav class="mobile-tabbar" aria-label="Mobile navigation">
        <a href="/" {% if page_title is defined and page_title == "AcaciaFund" %}class="is-active"{% endif %}>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10"/></svg>
            Home
        </a>
        <a href="/journeys/" {% if page_path is defined and page_path == "journeys/" %}class="is-active"{% endif %}>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Paths
        </a>
        <a href="/study/" {% if page_path is defined and page_path == "study/" %}class="is-active"{% endif %}>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            Study
            <span class="tab-badge hidden" data-tab-badge aria-label="Due review cards"></span>
        </a>
        <a href="/scholar/" {% if page_path is defined and page_path == "scholar/" %}class="is-active"{% endif %}>
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Me
        </a>
    </nav>

    <script src="{{ 'js/app.js' | asset }}" defer></script>

</body>
</html>
