<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ content.title | default(site_name) }}</title>
    <meta name="description" content="{{ content.description | default(site_description) }}">
    <link rel="icon" href="/favicon.ico">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link rel="stylesheet" href="{{ 'css/style.css' | asset }}">
    <link rel="stylesheet" href="{{ 'css/theme.css' | asset }}">
    <link rel="stylesheet" href="{{ 'css/custom.css' | asset }}">
    <link rel="stylesheet" href="{{ 'css/feynman.css' | asset }}">

{% if jsonld is defined and jsonld %}
    <script type="application/ld+json">
{{ jsonld | tojson }}
    </script>
{% endif %}

    <style>
        nav { border-bottom: 1px solid var(--pico-muted-border-color); margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; }
        nav ul { margin: 0; padding: 0; }
        footer hr { margin-bottom: var(--pico-spacing); }
        .logo { font-size: 1.25rem; font-weight: 700; text-decoration: none; }
        .nav-subtitle { font-size: 0.65rem; color: var(--color-text-muted); display: block; line-height: 1.2; }
        .nav-start-here { background: var(--color-accent); color: #fff !important; border-radius: 999px; padding: 0.3rem 0.75rem !important; font-weight: 600; }
    </style>
{% if plausible_domain %}
    <script defer data-domain="{{ plausible_domain }}" src="https://{{ plausible_domain }}/js/script.js"></script>
{% endif %}
</head>
<body>
    <header class="container">
        <nav>
            <ul>
                <li><strong><a href="/" class="contrast logo">Acacia</a></strong></li>
            </ul>
            <ul>
                <li><a href="/start-here/" class="nav-start-here">Start Here</a></li>
                <li><a href="/compliance/">Compliance <span class="nav-subtitle">Financial crime</span></a></li>
                <li><a href="/markets/">Markets <span class="nav-subtitle">Trading &amp; microstructure</span></a></li>
                <li><a href="/data/">Data <span class="nav-subtitle">Engineering &amp; pipelines</span></a></li>
                <li><a href="/review/">My Progress</a></li>
                <li><a href="/search/">Search</a></li>
                <li>
                  <div id="learning-mode-toggle" class="mode-toggle">
                    <button data-mode="beginner" class="active" type="button">Beginner</button>
                    <button data-mode="intermediate" type="button">Advanced</button>
                    <button data-mode="expert" type="button">Expert</button>
                  </div>
                </li>
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block main_content %}{% endblock %}
    </main>

    <footer class="container">
        <hr>
        <small>&copy; {{ year }} AcaciaFund &middot; Generated by the Acacia pipeline.</small>
    </footer>

    <script src="{{ 'js/main.js' | asset }}"></script>
    <script src="{{ 'js/search.js' | asset }}"></script>
    <script src="{{ 'js/progressive_disclosure.js' | asset }}"></script>

</body>
</html>
