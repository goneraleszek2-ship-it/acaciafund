{% extends "layout.j2" %}
{% block head_extra %}
<script src="/static/js/search.js" defer></script>
{% endblock %}
{% block main_content %}
<section>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs" style="color:var(--color-text-muted)">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><a href="/" class="hover:text-[var(--color-accent)] transition">Home</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Search</li>
    </ol>
  </nav>
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold" style="color:var(--color-text)">Search</h1>
    <p class="mt-2 text-sm" style="color:var(--color-text-muted)">Search across all research, learn, and knowledge content.</p>
  </div>
  <div class="mb-6">
    <div class="relative">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5" style="color:var(--color-text-muted)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input id="search-input" type="search" autocomplete="off" placeholder="Search articles, lessons, knowledge..." class="w-full pl-10 pr-4 py-3 rounded-lg text-sm transition focus:outline-none focus:ring-2" style="background:var(--color-surface);border:1px solid var(--color-border);color:var(--color-text);focus:ring-[var(--color-accent)]" autofocus>
    </div>
    <div id="search-count" class="mt-2 text-xs" style="color:var(--color-text-muted)"></div>
  </div>
  <div id="search-results" class="space-y-3">
    <p class="text-sm py-8 text-center" style="color:var(--color-text-muted)">Type at least 2 characters to search.</p>
  </div>
</section>
{% endblock %}
