{% from "macros/breadcrumbs.html" import breadcrumbs %}
{% extends "layout.j2" %}
{% block main_content %}
{{ breadcrumbs('search', 'Search') }}
<h1 class="text-center mb-6">Search</h1>

<div class="search-layout">
  <aside class="search-sidebar" id="search-filters" role="complementary" aria-label="Search filters">
    <div class="filter-row">
      <div class="filter-group" id="filter-pillar" role="group" aria-labelledby="filter-pillar-heading">
        <h3 id="filter-pillar-heading">Pillar</h3>
        <label><input type="checkbox" value="aml" class="filter-checkbox" data-group="pillar"><span class="pillar-dot pillar-dot-aml"></span> Compliance <span class="filter-count" data-group="pillar" data-value="aml" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="stock" class="filter-checkbox" data-group="pillar"><span class="pillar-dot pillar-dot-markets"></span> Markets <span class="filter-count" data-group="pillar" data-value="stock" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="data-engineering" class="filter-checkbox" data-group="pillar"><span class="pillar-dot pillar-dot-data"></span> Data <span class="filter-count" data-group="pillar" data-value="data-engineering" aria-hidden="true"></span></label>
      </div>
      <div class="filter-group" id="filter-type" role="group" aria-labelledby="filter-type-heading">
        <h3 id="filter-type-heading">Type</h3>
        <label><input type="checkbox" value="research" class="filter-checkbox" data-group="type"> Research <span class="filter-count" data-group="type" data-value="research" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="learn" class="filter-checkbox" data-group="type"> Learn <span class="filter-count" data-group="type" data-value="learn" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="knowledge" class="filter-checkbox" data-group="type"> Knowledge <span class="filter-count" data-group="type" data-value="knowledge" aria-hidden="true"></span></label>
      </div>
      <div class="filter-group" id="filter-difficulty" role="group" aria-labelledby="filter-difficulty-heading">
        <h3 id="filter-difficulty-heading">Difficulty</h3>
        <label><input type="checkbox" value="beginner" class="filter-checkbox" data-group="difficulty"> Beginner <span class="filter-count" data-group="difficulty" data-value="beginner" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="intermediate" class="filter-checkbox" data-group="difficulty"> Intermediate <span class="filter-count" data-group="difficulty" data-value="intermediate" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="advanced" class="filter-checkbox" data-group="difficulty"> Advanced <span class="filter-count" data-group="difficulty" data-value="advanced" aria-hidden="true"></span></label>
      </div>
      <div class="filter-group" id="filter-bloom" role="group" aria-labelledby="filter-bloom-heading">
        <h3 id="filter-bloom-heading">Bloom Level</h3>
        <label><input type="checkbox" value="remember" class="filter-checkbox" data-group="bloom"> Remember <span class="filter-count" data-group="bloom" data-value="remember" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="understand" class="filter-checkbox" data-group="bloom"> Understand <span class="filter-count" data-group="bloom" data-value="understand" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="apply" class="filter-checkbox" data-group="bloom"> Apply <span class="filter-count" data-group="bloom" data-value="apply" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="analyze" class="filter-checkbox" data-group="bloom"> Analyze <span class="filter-count" data-group="bloom" data-value="analyze" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="evaluate" class="filter-checkbox" data-group="bloom"> Evaluate <span class="filter-count" data-group="bloom" data-value="evaluate" aria-hidden="true"></span></label>
        <label><input type="checkbox" value="create" class="filter-checkbox" data-group="bloom"> Create <span class="filter-count" data-group="bloom" data-value="create" aria-hidden="true"></span></label>
      </div>
      <div class="filter-group" id="filter-technology" role="group" aria-labelledby="filter-technology-heading">
        <h3 id="filter-technology-heading">Technology</h3>
        <div id="tech-filter-list"></div>
      </div>
    </div>
    <button class="reset-btn" id="reset-filters">Reset filters</button>
  </aside>
  <div class="search-main" role="region" aria-label="Search results">
    <div class="search-input-wrap">
      <label for="search-input" class="sr-only">Search query</label>
      <input type="text" id="search-input" placeholder="Search research, learn, knowledge... (press / to focus)" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-suggestions" aria-autocomplete="list" aria-label="Search query">
      <div id="search-suggestions" role="listbox" aria-label="Search suggestions"></div>
    </div>
    <div id="search-stats" role="status" aria-live="polite"></div>
    <div id="search-results" role="region" aria-label="Results" aria-live="polite"></div>
  </div>
</div>

{% endblock %}
