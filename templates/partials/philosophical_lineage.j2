<section class="mt-8 pt-6 border-t" style="border-color:var(--color-border)">
  <details>
    <summary class="text-sm font-bold cursor-pointer" style="color:var(--color-text)">
      <span class="inline-flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        Philosophical Lineage
      </span>
    </summary>
    <div class="mt-3 space-y-3">
      <div class="flex flex-wrap gap-1.5">
        {%- for lineage in concept.philosophical_lineage %}
        {%- set lbl = _lineage_labels.get(lineage, lineage | replace('_', ' ') | title) %}
        <span class="inline-block text-[11px] px-2 py-0.5 rounded-full font-medium" style="background:color-mix(in srgb, var(--color-accent) 10%, transparent);color:var(--color-accent);border:1px solid color-mix(in srgb, var(--color-accent) 20%, transparent)">
          {{ lbl }}
        </span>
        {%- endfor %}
      </div>

      {%- if concept.philosophical_sources and concept.philosophical_sources | length > 0 %}
      <div>
        <h4 class="text-xs font-semibold mb-1.5" style="color:var(--color-text-muted)">Primary Sources</h4>
        <ul class="space-y-1">
          {%- for source in concept.philosophical_sources %}
          <li class="text-xs pl-3 relative" style="color:var(--color-text-secondary)">
            <span class="absolute left-0 top-0" style="color:var(--color-accent)">—</span>
            {{ source }}
          </li>
          {%- endfor %}
        </ul>
      </div>
      {%- endif %}

      {%- if concept.cross_pillar_analogs and concept.cross_pillar_analogs | length > 0 %}
      <div>
        <h4 class="text-xs font-semibold mb-1.5" style="color:var(--color-text-muted)">Same Pattern in Other Pillars</h4>
        <div class="flex flex-wrap gap-1.5">
          {%- for analog in concept.cross_pillar_analogs %}
          <a href="/concepts/{{ analog }}/" class="text-[11px] px-2 py-0.5 rounded-full no-underline font-medium transition hover:shadow-sm" style="background:var(--color-bg);color:var(--color-text-secondary);border:1px solid var(--color-border)">
            {{ analog | replace('-', ' ') | title }}
          </a>
          {%- endfor %}
        </div>
      </div>
      {%- endif %}
    </div>
  </details>
</section>
{%- endif %}
