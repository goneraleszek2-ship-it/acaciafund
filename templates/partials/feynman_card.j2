{%- set diff = concept.feynman_difficulty or 2 %}
{%- set diff_label = "Beginner-friendly" if diff <= 2 else ("Intermediate" if diff == 3 else "Advanced") %}
{%- set diff_class = "beginner" if diff <= 2 else ("intermediate" if diff == 3 else "advanced") %}

{%- set stages = [
  {"key": "eli5", "label": "Explain", "icon": "lightbulb", "color": "#d97706"},
  {"key": "analogy", "label": "Analogize", "icon": "link", "color": "#2563eb"},
  {"key": "example", "label": "Exemplify", "icon": "code", "color": "#16a34a"},
  {"key": "diagram", "label": "Diagram", "icon": "eye", "color": "#7c3aed"},
  {"key": "gaps", "label": "Find Gaps", "icon": "search", "color": "#dc2626"},
  {"key": "teachback", "label": "Teach Back", "icon": "chat", "color": "var(--color-accent)"},
  {"key": "build", "label": "Create", "icon": "wrench", "color": "#ea580c"},
] %}

{%- set stage_icons = {
  "lightbulb": '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>',
  "link": '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>',
  "code": '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>',
  "eye": '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>',
  "search": '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10H7m3-3v6"/></svg>',
  "chat": '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>',
  "wrench": '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
} %}

<div class="feynman-card ghost-card p-5 mb-6" data-concept="{{ concept.id }}">

  <div class="feynman-stages" role="tablist" aria-label="Feynman learning stages">
    {%- for s in stages %}
    <div class="feynman-stage-dot" data-stage="{{ s.key }}" role="tab" aria-selected="false" tabindex="0">
      <div class="dot">{{ stage_icons[s.icon] | safe }}</div>
      <span class="stage-label">{{ s.label }}</span>
    </div>
    {%- if not loop.last %}
    <div class="feynman-stage-connector" data-connector-after="{{ s.key }}"></div>
    {%- endif %}
    {%- endfor %}
  </div>

  {%- set has_next = stages[1:] %}

  {# LAYER 1: ELI5 #}
  <div class="feynman-layer eli5-layer mb-4">
    <div class="quote-eli5">
      <p>{{ concept.eli5_explanation or concept.description or "No simple explanation yet." }}</p>
    </div>
    {%- if has_next and has_next[0] is defined and concept.analogy %}
    <div class="flex items-center justify-end mt-2">
      <button class="next-stage-btn" data-next-stage="analogy" data-target=".analogy-layer-details">
        Next: {{ has_next[0].label }} &rarr;
      </button>
    </div>
    {%- endif %}
  </div>

  {# LAYER 2: ANALOGY #}
  {% if concept.analogy %}
  <details class="feynman-layer analogy-layer analogy-layer-details mb-3 group">
    <summary class="flex items-center gap-2 cursor-pointer py-2 px-3 list-none select-none rounded" style="color:var(--color-text)">
      <span style="color:#2563eb">{{ stage_icons["link"] | safe }}</span>
      <span class="text-xs font-semibold uppercase tracking-wider" style="color:#2563eb">Analogy</span>
    </summary>
    <div class="mt-2 p-3 rounded text-sm ml-2" style="background:color-mix(in srgb, #2563eb 6%, transparent);border:1px solid color-mix(in srgb, #2563eb 15%, transparent);color:var(--color-text-secondary)">
      {{ concept.analogy }}
    </div>
  </details>
  {% endif %}

  {# LAYER 3: EXAMPLE #}
  {% if concept.concrete_example %}
  <details class="feynman-layer example-layer mb-3 group">
    <summary class="flex items-center gap-2 cursor-pointer py-2 px-3 list-none select-none rounded" style="color:var(--color-text)">
      <span style="color:#16a34a">{{ stage_icons["code"] | safe }}</span>
      <span class="text-xs font-semibold uppercase tracking-wider" style="color:#16a34a">Example</span>
    </summary>
    <div class="mt-2 p-3 rounded text-sm ml-2" style="background:color-mix(in srgb, #16a34a 6%, transparent);border:1px solid color-mix(in srgb, #16a34a 15%, transparent);color:var(--color-text-secondary)">
      {{ concept.concrete_example }}
    </div>
  </details>
  {% endif %}

  {# LAYER 4: DIAGRAM #}
  {% if concept.feynman_diagram %}
  <details class="feynman-layer diagram-layer mb-3 group">
    <summary class="flex items-center gap-2 cursor-pointer py-2 px-3 list-none select-none rounded" style="color:var(--color-text)">
      <span style="color:#7c3aed">{{ stage_icons["eye"] | safe }}</span>
      <span class="text-xs font-semibold uppercase tracking-wider" style="color:#7c3aed">Diagram</span>
    </summary>
    <div class="mt-2 p-3 rounded text-sm ml-2" style="background:color-mix(in srgb, #7c3aed 6%, transparent);border:1px solid color-mix(in srgb, #7c3aed 15%, transparent);color:var(--color-text-secondary)">
      {{ concept.feynman_diagram | safe }}
    </div>
  </details>
  {% endif %}

  {# LAYER 5: GAP QUESTIONS #}
  {% if concept.gap_questions and concept.gap_questions | length > 0 %}
  <details class="feynman-layer gaps-layer mb-3 group">
    <summary class="flex items-center gap-2 cursor-pointer py-2 px-3 list-none select-none rounded" style="color:var(--color-text)">
      <span style="color:#dc2626">{{ stage_icons["search"] | safe }}</span>
      <span class="text-xs font-semibold uppercase tracking-wider" style="color:#dc2626">Find Gaps</span>
    </summary>
    <div class="mt-2 ml-2 space-y-2">
      {% for q in concept.gap_questions %}
      <div class="p-2 rounded text-sm" style="background:color-mix(in srgb, #dc2626 6%, transparent);border:1px solid color-mix(in srgb, #dc2626 12%, transparent);color:var(--color-text-secondary)">
        {{ q }}
      </div>
      {% endfor %}
    </div>
  </details>
  {% endif %}

  {# LAYER 6: TEACH BACK #}
  {% if concept.teach_back_prompt %}
  <div class="feynman-layer teachback-layer mb-3 p-4 rounded" style="background:color-mix(in srgb, var(--color-accent) 8%, transparent);border:1px solid color-mix(in srgb, var(--color-accent) 25%, transparent)">
    <div class="flex items-center gap-2 mb-2">
      <span style="color:var(--color-accent)">{{ stage_icons["chat"] | safe }}</span>
      <span class="text-xs font-semibold uppercase tracking-wider" style="color:var(--color-accent)">Teach Back</span>
    </div>
    <p class="text-sm mb-2" style="color:var(--color-text-secondary)">{{ concept.teach_back_prompt }}</p>
    <textarea class="teachback-input w-full min-h-[60px] p-2 text-sm rounded border" placeholder="Write your explanation here..." style="background:var(--color-bg);border-color:var(--color-border);color:var(--color-text);resize:vertical" data-teachback="{{ concept.id }}"></textarea>
    <button class="teachback-submit mt-2 text-xs px-3 py-1.5 rounded font-semibold border-0 cursor-pointer" style="background:var(--color-accent);color:#fff" data-submit-teachback="{{ concept.id }}">Submit Explanation</button>
  </div>
  {% endif %}

  {# LAYER 7: BUILD #}
  {% if concept.build_exercise %}
  <details class="feynman-layer build-layer group">
    <summary class="flex items-center gap-2 cursor-pointer py-2 px-3 list-none select-none rounded" style="color:var(--color-text)">
      <span style="color:#ea580c">{{ stage_icons["wrench"] | safe }}</span>
      <span class="text-xs font-semibold uppercase tracking-wider" style="color:#ea580c">Create</span>
    </summary>
    <div class="mt-2 p-3 rounded text-sm ml-2" style="background:color-mix(in srgb, #ea580c 6%, transparent);border:1px solid color-mix(in srgb, #ea580c 15%, transparent)">
      <p class="font-mono mb-2" style="color:var(--color-text)">{{ concept.build_exercise.prompt }}</p>
      {% if concept.build_exercise.type == "code" %}
      <textarea class="build-exercise-input w-full min-h-[120px] p-2 text-xs font-mono rounded border" placeholder="Write your solution..." style="background:var(--color-bg);border-color:var(--color-border);color:var(--color-text);resize:vertical"></textarea>
      {% endif %}
      <details class="mt-2">
        <summary class="text-xs cursor-pointer select-none" style="color:var(--color-text-muted)">Show solution</summary>
        <pre class="mt-2 p-3 text-xs font-mono rounded overflow-x-auto" style="background:var(--color-bg);border:1px solid var(--color-border);color:var(--color-text-secondary)">{{ concept.build_exercise.solution }}</pre>
      </details>
    </div>
  </details>
  {% endif %}

  {# Footer #}
  {% if concept.feynman_difficulty %}
  <div class="mt-4 pt-3 border-t flex items-center gap-3 text-xs" style="border-color:var(--color-border);color:var(--color-text-muted)">
    <span>Difficulty:</span>
    <span class="difficulty-badge {{ diff_class }}">{{ diff_label }} &mdash; {{ diff }}/5</span>
    <span class="flex gap-0.5 ml-auto">
      {% for i in range(5) %}
      <span class="inline-block w-2 h-2 rounded-full feynman-difficulty-dot {% if i < diff %}" style="background:var(--color-accent){%
        else %}" style="background:var(--color-border){%
        endif %}"></span>
      {% endfor %}
    </span>
  </div>
  {% endif %}
</div>
