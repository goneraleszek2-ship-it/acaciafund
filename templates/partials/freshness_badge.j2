{%- if content and content.freshness_status %}
{%- set _status = content.freshness_status %}
{%- set _tier = content.currency_tier | default('timeless') %}
{%- if _status == 'fresh' %}
{%- set _label = 'Evergreen' if _tier == 'timeless' else 'Fresh' %}
{%- set _color = '#22c55e' %}
{%- elif _status == 'stale' %}
{%- set _label = 'Stale' %}
{%- set _color = '#f59e0b' %}
{%- elif _status == 'outdated' %}
{%- set _label = 'Outdated' %}
{%- set _color = '#ef4444' %}
{%- else %}
{%- set _label = 'Unverified' %}
{%- set _color = '#6b7280' %}
{%- endif %}
<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full" style="background:color-mix(in srgb, {{ _color }} 15%, transparent);color:{{ _color }}" title="Content freshness{% if _tier == 'timeless' %} (evergreen — timeless reference){% endif %}">
  <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
  {{ _label }}
</span>
{%- endif %}
