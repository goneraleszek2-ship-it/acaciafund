{%- if quiz_json %}
<div id="pretest-gate" class="ghost-card p-5 mb-6" style="border-left:4px solid var(--color-accent)">
  <div class="flex items-center gap-2 mb-3">
    <svg class="w-5 h-5" fill="none" stroke="var(--color-accent)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
    <h2 class="text-sm font-bold" style="color:var(--color-text)">Try This First</h2>
  </div>
  <p class="text-sm mb-3" style="color:var(--color-text-secondary)">Test your knowledge before reading. Don't worry if you get it wrong — that's part of learning.</p>
  <div id="pretest-question" class="pretest-form"></div>
  <div id="pretest-feedback" class="hidden mt-3 p-3 rounded text-sm" style="background:color-mix(in srgb, var(--color-accent) 10%, transparent);border:1px solid var(--color-accent);color:var(--color-text)"></div>
  <div class="flex items-center gap-3 mt-3">
    <button id="pretest-reveal" class="text-xs px-3 py-1.5 font-semibold rounded-lg hidden" style="background:var(--color-bg);border:1px solid var(--color-border);color:var(--color-text-muted);cursor:pointer">Reveal Answer</button>
    <button id="pretest-show-content" class="hidden text-xs px-3 py-1.5 font-semibold rounded-lg" style="background:var(--color-accent);color:#fff;border:none;cursor:pointer">Read the Lesson →</button>
  </div>
</div>
{%- endif %}
