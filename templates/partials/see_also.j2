{%- if see_also and see_also | length > 0 %}
<section class="mt-12 pt-8 border-t border-muted">
  <h2 class="text-2xl font-bold mb-4 inline-flex items-center gap-2 text-default">
    <svg class="section-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
    See Also
  </h2>
  <div class="grid gap-2">
    {%- for ref in see_also %}
    {%- set ref_pillar = (ref.slug or '').split('/')[0] %}
    {%- set ref_pc = pillar_config.get(ref_pillar, {}) %}
    <a href="/{{ ref_pc.get('url', ref_pillar) }}/{{ ref.slug.split('/')[1] if ref.slug.split('/') | length > 1 else 'knowledge' }}/{{ ref.slug.split('/')[-1] }}/"
       class="flex items-start gap-3 ghost-card p-3 text-decoration-none transition hover:shadow-md">
      <div class="flex-1 min-w-0">
        <span class="font-semibold text-sm text-default hover-accent">{{ ref.label }}</span>
        {%- if ref.reason %}
        <p class="text-xs text-muted mt-0.5">{{ ref.reason }}</p>
        {%- endif %}
      </div>
      <svg class="icon-inline shrink-0 mt-0.5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
    {%- endfor %}
  </div>
</section>
{%- endif %}
