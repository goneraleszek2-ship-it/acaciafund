{%- set sqi_val = content.sqi or 0 %}
{%- if content.signals and content.signals.avg_sqi %}
  {%- set sqi_val = [sqi_val, content.signals.avg_sqi] | max %}
{%- endif %}
{%- if content.tags or ontology_concepts or sqi_val > 0 %}
<details class="mt-6 ghost-card p-4">
  <summary class="text-sm font-semibold cursor-pointer select-none text-muted">Article Metadata</summary>
  <div class="mt-3 space-y-3">
    {%- if content.tags and content.tags | length > 0 %}
    <div class="flex flex-wrap gap-1.5">
      {%- for tag in content.tags %}
      {%- set tag_slug = tag | lower | replace(' ', '-') | replace('_', '-') %}
      <a href="/tags/{{ tag_slug }}/" class="text-xs px-2 py-0.5 rounded text-decoration-none" style="background:color-mix(in srgb, var(--color-accent) 10%, transparent);color:var(--color-accent)">{{ tag }}</a>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if ontology_concepts and ontology_concepts | length > 0 %}
    <div class="flex flex-wrap gap-1.5">
      {%- for concept in ontology_concepts %}
      <a href="/concepts/{{ concept.id }}/" class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full text-decoration-none" style="background:color-mix(in srgb, var(--color-accent) 12%, transparent);color:var(--color-accent);border:1px solid color-mix(in srgb, var(--color-accent) 25%, transparent)">
        <svg class="badge-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
        {{ concept.name }}
      </a>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if sqi_val > 0 %}
    <div>
      <span class="sqi-badge">SQI {{ "%.3f" | format(sqi_val) }}</span>
    </div>
    {%- endif %}
  </div>
</details>
{%- endif %}