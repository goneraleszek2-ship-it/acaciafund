{%- if contributors and contributors | length > 0 %}
<div class="mt-8 pt-4 border-t border-muted">
  <h3 class="text-xs font-semibold text-muted uppercase tracking-wider mb-2">Contributors</h3>
  <div class="flex flex-wrap gap-3">
    {%- for c in contributors %}
    <div class="flex items-center gap-2 text-sm">
      <span class="w-6 h-6 rounded-full bg-surface border border-muted flex items-center justify-center text-xs font-semibold text-muted">
        {{- (c.name or '?')[:1] -}}
      </span>
      <div>
        <span class="text-default">{{ c.name }}</span>
        {%- if c.role %}
        <span class="text-xs text-muted">({{ c.role }})</span>
        {%- endif %}
      </div>
      {%- if c.url %}
      <a href="{{ c.url }}" class="text-xs hover-accent text-muted">&rarr;</a>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
  {%- if subject_classifications and subject_classifications | length > 0 %}
  <div class="mt-3">
    <h4 class="text-xs font-semibold text-muted uppercase tracking-wider mb-1">Subject Classifications</h4>
    <div class="flex flex-wrap gap-1.5">
      {%- for path in subject_classifications %}
      <span class="text-xs px-2 py-0.5 rounded bg-surface border border-muted text-muted">
        {{ path | join(' > ') }}
      </span>
      {%- endfor %}
    </div>
  </div>
  {%- endif %}
</div>
{%- endif %}
