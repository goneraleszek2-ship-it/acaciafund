{%- if concept.epistemic_status %}
{%- set _epistemic_styles = {
  "constitutive": {"bg": "color-mix(in srgb, #6366f1 10%, transparent)", "fg": "#6366f1", "label": "Constitutive — This concept creates the reality it describes"},
  "regulatory": {"bg": "color-mix(in srgb, #f59e0b 10%, transparent)", "fg": "#f59e0b", "label": "Regulatory — This concept governs behaviour within a framework"},
  "pragmatic": {"bg": "color-mix(in srgb, #22c55e 10%, transparent)", "fg": "#22c55e", "label": "Pragmatic — This concept is useful, not necessarily true"},
  "ontological": {"bg": "color-mix(in srgb, #a855f7 10%, transparent)", "fg": "#a855f7", "label": "Ontological — This concept makes a claim about what exists"},
  "instrumental": {"bg": "color-mix(in srgb, #06b6d4 10%, transparent)", "fg": "#06b6d4", "label": "Instrumental — This concept is a tool, not a truth-claim"},
  "normative": {"bg": "color-mix(in srgb, #f43f5e 10%, transparent)", "fg": "#f43f5e", "label": "Normative — This concept prescribes how things ought to be"},
} %}
{%- set _ep = _epistemic_styles.get(concept.epistemic_status, _epistemic_styles["instrumental"]) %}
<span class="inline-block text-[10px] px-1.5 py-0.5 rounded font-semibold" style="background:{{ _ep['bg'] }};color:{{ _ep['fg'] }}" title="{{ _ep['label'] }}">
  {{ concept.epistemic_status | capitalize }}
</span>
{%- endif %}
