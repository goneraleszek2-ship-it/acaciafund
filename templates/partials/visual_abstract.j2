<div class="visual-abstract ghost-card mb-8 p-5" style="border-left:4px solid {{ pillar_config.get(content.pillar or 'aml', {}).get('color', '#6366f1') }}">
  <div class="flex items-start gap-4">
    <div class="shrink-0 w-12 h-12 flex items-center justify-center rounded-lg" style="background:color-mix(in srgb, {{ pillar_config.get(content.pillar or 'aml', {}).get('color', '#6366f1') }} 12%, transparent)">
      {%- set ctype = (content.content_type or 'research') | lower %}
      {%- if ctype == 'research' %}
      <svg class="w-6 h-6" fill="none" stroke="{{ pillar_config.get(content.pillar or 'aml', {}).get('color', '#6366f1') }}" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      {%- elif ctype == 'learn' %}
      <svg class="w-6 h-6" fill="none" stroke="{{ pillar_config.get(content.pillar or 'aml', {}).get('color', '#6366f1') }}" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-3.42 6.752A15.973 15.973 0 0012 18.333a15.973 15.973 0 003.42 2.419"/></svg>
      {%- else %}
      <svg class="w-6 h-6" fill="none" stroke="{{ pillar_config.get(content.pillar or 'aml', {}).get('color', '#6366f1') }}" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
      {%- endif %}
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color:{{ pillar_config.get(content.pillar or 'aml', {}).get('color', '#6366f1') }}">Key Insights</p>
      <ul class="space-y-1 text-sm" style="color:var(--color-text-secondary)">
        {%- set sentences = (content.description or '').split('.') %}
        {%- for i in range(3) if sentences[i] | trim %}
        <li class="flex items-start gap-2">
          <span class="inline-block w-1.5 h-1.5 rounded-full mt-1.5 shrink-0" style="background:{{ pillar_config.get(content.pillar or 'aml', {}).get('color', '#6366f1') }}"></span>
          <span>{{ sentences[i] | trim | striptags }}.</span>
        </li>
        {%- else %}
        <li class="flex items-start gap-2">
          <span class="inline-block w-1.5 h-1.5 rounded-full mt-1.5 shrink-0" style="background:var(--color-text-muted)"></span>
          <span style="color:var(--color-text-muted)">No summary available...</span>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
  {%- if ontology_concepts %}
  <div class="mt-4 pt-3 border-t" style="border-color:var(--color-border)">
    <div class="flex flex-wrap gap-1.5">
      {%- for oc in ontology_concepts[:8] %}
      <span class="text-xs px-2 py-0.5 rounded" style="background:color-mix(in srgb, {{ pillar_config.get(content.pillar or 'aml', {}).get('color', '#6366f1') }} 12%, transparent);color:{{ pillar_config.get(content.pillar or 'aml', {}).get('color', '#6366f1') }}">{{ oc.name | default(oc.label) | default(oc.id) }}</span>
      {%- endfor %}
    </div>
  </div>
  {%- endif %}
  {%- if content.difficulty %}
  <div class="mt-3 pt-3 border-t flex items-center gap-3 text-xs" style="border-color:var(--color-border);color:var(--color-text-muted)">
    <span>Difficulty: <span class="font-semibold">{{ content.difficulty | capitalize }}</span></span>
    <span class="w-px h-3 inline-block" style="background:var(--color-border)"></span>
    <span>Type: <span class="font-semibold">{{ ctype | capitalize }}</span></span>
  </div>
  {%- endif %}
</div>
