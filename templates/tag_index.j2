{% extends "layout.j2" %}
{% from "macros/pillar_badge.html" import pillar_badge %}
{% from "macros/breadcrumbs.html" import breadcrumbs %}
{% block main_content %}
{%- if tag and items %}
{{ breadcrumbs(page_path, tag) }}
<header class="mb-8">
  <h1 class="text-3xl font-extrabold" style="color:var(--color-text)">
    <span class="inline-flex items-center gap-2">🏷️ {{ tag }}</span>
  </h1>
  <p class="mt-2 text-sm" style="color:var(--color-text-secondary)">{{ items | length }} item{{ 's' if items | length != 1 else '' }}</p>
</header>
<div class="grid gap-4 sm:grid-cols-2">
  {%- for item in items %}
  {%- set p = item.pillar or "aml" %}
  {%- set pc = pillar_config.get(p, pillar_config["aml"]) %}
  <article class="rounded-lg p-4 transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border)">
    <div class="flex items-center gap-2 mb-2">
      {{ pillar_badge(item.pillar) }}
      {%- if item.date_str %}
      <span class="text-xs" style="color:var(--color-text-muted)">{{ item.date_str }}</span>
      {%- endif %}
    </div>
    <h2 class="font-semibold" style="color:var(--color-text)">
      <a href="/{{ item.slug }}/" class="transition hover:text-[var(--color-accent)]" style="color:var(--color-text);text-decoration:none">{{ item.title | striptags }}</a>
    </h2>
    {%- if item.description %}
    <p class="mt-1 text-sm" style="color:var(--color-text-secondary)">{{ item.description[:200] }}</p>
    {%- endif %}
  </article>
  {%- endfor %}
</div>
{%- elif all_tags is defined and all_tags %}
{{ breadcrumbs(page_path, "Tags") }}
<header class="mb-8">
  <h1 class="text-3xl font-extrabold" style="color:var(--color-text)">🏷️ Tags</h1>
  <p class="mt-2 text-sm" style="color:var(--color-text-secondary)">{{ all_tags | length }} tag{{ 's' if all_tags | length != 1 else '' }}</p>
</header>
<div class="flex flex-wrap gap-3">
  {%- for t in all_tags %}
  {%- set slug = t | lower | replace(' ', '-') | replace('_', '-') %}
  <a href="/tags/{{ slug }}/" class="inline-flex items-center gap-1 px-4 py-2 rounded-full text-sm font-medium transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border);color:var(--color-text);text-decoration:none">
    {{ t }}
  </a>
  {%- endfor %}
</div>
{%- else %}
<header class="mb-8">
  <h1 class="text-3xl font-extrabold" style="color:var(--color-text)">🏷️ Tags</h1>
  <p class="mt-2" style="color:var(--color-text-secondary)">No tags yet.</p>
</header>
{%- endif %}
{% endblock %}
