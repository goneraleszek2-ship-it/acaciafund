{% extends "layout.j2" %}
{% block main_content %}
<nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="hover-accent transition">Home</a></li>
    <li aria-hidden="true">/</li>
    <li aria-current="page">Study Queue</li>
  </ol>
</nav>

<header class="mb-6">
  <h1 class="text-2xl font-extrabold text-default">Study Queue</h1>
  <p class="mt-1 text-sm text-muted">Due flashcards and concept reviews, ordered by due date. Space = flip, 1-4 = grade.</p>
</header>

<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
  <div id="queue-progress" class="text-sm font-meta text-muted">0 / 0 reviewed</div>
  <div class="flex items-center gap-4">
    <div class="study-streak-card flex items-center gap-1.5 text-sm" title="Consecutive days with a review">
      <span aria-hidden="true" style="font-size:1.1rem">&#128293;</span>
      <span id="study-streak" class="font-bold text-default">0</span>
      <span class="text-xs text-muted">day streak</span>
    </div>
    <div id="queue-due" class="text-sm font-semibold text-accent">0 due</div>
  </div>
</div>

<div id="study-dashboard" class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 min-w-0">

<div id="queue-empty" class="hidden ghost-card p-8 text-center">
  <svg class="empty-state-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  <p class="text-sm font-semibold text-default">All caught up!</p>
  <p class="text-xs mt-1 text-muted">No cards or concepts due for review right now.</p>
  <div class="flex flex-wrap justify-center gap-2 mt-4">
    <a href="/review/" class="btn btn-primary btn-sm">Back to Dashboard</a>
    <a href="/weekly/" class="btn btn-ghost btn-sm">Weekly Notes</a>
    <a href="/search/" class="btn btn-ghost btn-sm">Browse Content</a>
  </div>
</div>

<div id="queue-active" class="flex flex-col items-center">
  <div id="queue-card-container" class="w-full max-w-lg" role="region" aria-label="Study review" aria-live="polite">
  </div>
  <div id="queue-nav" class="mt-4 flex gap-3 hidden">
    <button id="queue-skip" class="btn btn-ghost" style="min-width:44px;min-height:44px">Skip</button>
    <button id="queue-done" class="btn btn-primary" style="min-width:44px;min-height:44px">Done</button>
  </div>
</div>

  </div>
  <aside class="pillar-rail" aria-label="Study dashboard">
    <div class="ghost-card rail-card">
      <h2 class="rail-title">This Week <span class="rail-count">review days</span></h2>
      <div id="side-week" class="flex items-end justify-between gap-1" style="height:5rem"></div>
    </div>
    <div class="ghost-card rail-card">
      <h2 class="rail-title">Upcoming <span class="rail-count">next 5</span></h2>
      <div id="side-upcoming" class="text-sm text-muted">Loading&hellip;</div>
    </div>
    <div class="ghost-card rail-card">
      <h2 class="rail-title">Weak Cards <span class="rail-count">low ease</span></h2>
      <div id="side-weak" class="text-sm text-muted">Loading&hellip;</div>
    </div>
  </aside>
</div>

<script src="{{ 'js/learning.js' | asset }}" defer></script>
<script src="{{ 'js/retention.js' | asset }}" defer></script>
<script src="{{ 'js/study_dashboard.js' | asset }}" defer></script>
<script>
(function() {
  const flashCards = {{ flashcard_cards | safe }};
  const FLASH_SM2_KEY = 'acacia_sm2';
  const CONCEPT_SM2_KEY = 'acacia_concept_mastery';

  function readStore(key) {
    try { return JSON.parse(localStorage.getItem(key) || '{}'); } catch (_) { return {}; }
  }

  const now = Date.now();
  const dueFlash = flashCards.filter(c => {
    const s = readStore(FLASH_SM2_KEY)[c.id] || { reps: 0, due: 0 };
    return s.due <= now;
  });

  const container = document.getElementById('queue-card-container');
  const emptyEl = document.getElementById('queue-empty');
  const activeEl = document.getElementById('queue-active');
  const progressEl = document.getElementById('queue-progress');
  const dueEl = document.getElementById('queue-due');
  const navEl = document.getElementById('queue-nav');

  function buildQueue(concepts) {
    const conceptMastery = readStore(CONCEPT_SM2_KEY);
    const dueConcepts = (concepts || []).filter(c => {
      const m = conceptMastery[c.id] || { reps: 0, due: 0 };
      return m.reps === 0 || (m.due > 0 && m.due <= now);
    });

    const queue = dueFlash.map(c => ({ kind: 'flash', data: c }));
    queue.push(...dueConcepts.map(c => ({ kind: 'concept', data: c })));

    return queue;
  }

  fetch('/static/review_concepts.json')
    .then(function(r) { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then(function(data) { start(data.concepts || []); })
    .catch(function() { start([]); });

  function start(concepts) {
    const queue = buildQueue(concepts);

    if (!queue.length) {
      emptyEl.classList.remove('hidden');
      activeEl.classList.add('hidden');
      dueEl.textContent = '0 due';
      return;
    }

    dueEl.textContent = queue.length + ' due';
    let idx = 0;
    let reviewed = 0;

    function renderCard() {
      if (idx >= queue.length) {
        container.innerHTML = '<div class="ghost-card p-6 text-center"><p class="text-sm font-semibold text-default">Queue complete!</p></div>';
        navEl.classList.add('hidden');
        container.setAttribute('role', 'region');
        container.removeAttribute('aria-modal');
        return;
      }

      const item = queue[idx];
      container.innerHTML = '';
      progressEl.textContent = `${reviewed} / ${queue.length} reviewed`;
      navEl.classList.remove('hidden');
      container.setAttribute('role', 'dialog');
      container.setAttribute('aria-modal', 'false');
      container.setAttribute('aria-label', 'Study card — review and grade your recall');

      if (item.kind === 'flash') {
        const c = item.data;
        const fc = document.createElement('acacia-flashcard');
        fc.setAttribute('data-term', c.term);
        fc.setAttribute('data-definition', c.definition);
        fc.setAttribute('data-card-id', c.id);
        fc.setAttribute('data-source', c.pillar);
        container.appendChild(fc);
        fc.addEventListener('card-graded', () => advance());
        return;
      }

      const c = item.data;
      const card = document.createElement('div');
      card.className = 'ghost-card p-6';
      card.innerHTML = `
        <p class="text-xs font-meta text-muted mb-1">Concept · ${c.category || 'ontology'}</p>
        <h2 class="text-lg font-extrabold text-default mb-2">${c.label}</h2>
        <p class="text-sm text-muted mb-4">Recall what this concept means, then reveal the definition and grade yourself.</p>
        <details class="mb-4"><summary class="cursor-pointer text-sm font-semibold text-accent">Reveal definition</summary>
          <p class="mt-2 text-sm text-default">${c.definition || c.eli5Explanation || ''}</p>
        </details>
        <div class="flex justify-center gap-2" role="group" aria-label="Grade your recall">
          <button class="btn btn-ghost btn-sm" data-grade="0">Again</button>
          <button class="btn btn-ghost btn-sm" data-grade="1">Hard</button>
          <button class="btn btn-primary btn-sm" data-grade="2">Good</button>
          <button class="btn btn-primary btn-sm" data-grade="3">Easy</button>
        </div>`;
      container.appendChild(card);
      card.querySelectorAll('[data-grade]').forEach(btn => {
        btn.addEventListener('click', () => {
          if (window.AcaciaRetention && typeof window.AcaciaRetention.review === 'function') {
            window.AcaciaRetention.review(c.id, parseInt(btn.getAttribute('data-grade'), 10));
          }
          advance();
        });
      });
    }

    function advance() {
      reviewed++;
      idx++;
      setTimeout(renderCard, 200);
    }

    renderCard();

    document.getElementById('queue-skip').addEventListener('click', () => { idx++; renderCard(); });
    document.getElementById('queue-done').addEventListener('click', () => {
      window.location.href = '/review/';
    });

    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'ArrowRight' || e.key === 'Escape') { idx++; renderCard(); }
    });
  }
})();
</script>

{% include 'partials/newsletter.html' %}
{% endblock %}
