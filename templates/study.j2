{% extends "layout.j2" %}
{% block main_content %}
<nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="hover-accent transition">Home</a></li>
    <li aria-hidden="true">/</li>
    <li aria-current="page">Study Queue</li>
  </ol>
</nav>

<header class="mb-6">
  <h1 class="text-2xl font-extrabold text-default">Study Queue</h1>
  <p class="mt-1 text-sm text-muted">Due flashcards and concept reviews, ordered by due date. Space = flip, 1-4 = grade.</p>
</header>

<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
  <div id="queue-progress" class="text-sm font-meta text-muted">0 / 0 reviewed</div>
  <div class="flex items-center gap-4">
    <div class="study-streak-card flex items-center gap-1.5 text-sm" title="Consecutive days with a review">
      <span aria-hidden="true" style="font-size:1.1rem">&#128293;</span>
      <span id="study-streak" class="font-bold text-default">0</span>
      <span class="text-xs text-muted">day streak</span>
    </div>
    <div id="queue-due" class="text-sm font-semibold text-accent">0 due</div>
  </div>
</div>

<div id="study-dashboard" class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 min-w-0">

<div id="queue-empty" class="hidden ghost-card p-8 text-center">
  <svg class="empty-state-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  <p class="text-sm font-semibold text-default">All caught up!</p>
  <p class="text-xs mt-1 text-muted">No cards or concepts due for review right now.</p>
  <div class="flex flex-wrap justify-center gap-2 mt-4">
    <a href="/review/" class="btn btn-primary btn-sm">Back to Dashboard</a>
    <a href="/weekly/" class="btn btn-ghost btn-sm">Weekly Notes</a>
    <a href="/search/" class="btn btn-ghost btn-sm">Browse Content</a>
  </div>
</div>

<div id="queue-active" class="flex flex-col items-center">
  <div id="queue-card-container" class="w-full max-w-lg" role="region" aria-label="Study review" aria-live="polite">
  </div>
  <div id="queue-nav" class="mt-4 flex gap-3 hidden">
    <button id="queue-skip" class="btn btn-ghost" style="min-width:44px;min-height:44px">Skip</button>
    <button id="queue-done" class="btn btn-primary" style="min-width:44px;min-height:44px">Done</button>
  </div>
</div>

  </div>
  <aside class="pillar-rail" aria-label="Study dashboard">
    <div class="ghost-card rail-card">
      <h2 class="rail-title">This Week <span class="rail-count">review days</span></h2>
      <div id="side-week" class="flex items-end justify-between gap-1" style="height:5rem"></div>
    </div>
    <div class="ghost-card rail-card">
      <h2 class="rail-title">Upcoming <span class="rail-count">next 5</span></h2>
      <div id="side-upcoming" class="text-sm text-muted">Loading&hellip;</div>
    </div>
    <div class="ghost-card rail-card">
      <h2 class="rail-title">Weak Cards <span class="rail-count">low ease</span></h2>
      <div id="side-weak" class="text-sm text-muted">Loading&hellip;</div>
    </div>
  </aside>
</div>

<script src="{{ 'js/learning.js' | asset }}" defer></script>
<script src="{{ 'js/retention.js' | asset }}" defer></script>
<script src="{{ 'js/study_dashboard.js' | asset }}" defer></script>
<script type="application/json" id="study-cards-data">{{ flashcard_cards | tojson }}</script>
<script src="{{ 'js/study_page.js' | asset }}" defer></script>

{% include 'partials/newsletter.html' %}
{% endblock %}
