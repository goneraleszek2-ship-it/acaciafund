{% extends "layout.j2" %}
{% block title %}{{ pillar_name }} — Week {{ week_id }} Notes | AcaciaFund{% endblock %}
{% block description %}Feynman-style weekly notes for {{ pillar_name }} — the most important developments in simple language with analogies, significance, and links to deeper analysis.{% endblock %}

{% block head %}
{{ super() }}
{% endblock %}

{% block main_content %}
{% set data = all_pillars[pillar] %}
{% set pillar_events = data.events | default([]) %}
{% set event_count = pillar_events | length %}
{% set palette = {"aml": {"color": "#f97316", "accent": "#fb923c"}, "markets": {"color": "#34d399", "accent": "#6ee7b7"}, "data-engineering": {"color": "#818cf8", "accent": "#a5b4fc"}} %}
{% set pc = palette.get(pillar, palette["markets"]) %}

<div class="weekly-header">
    <h1>{{ pillar_name }} Weekly Notes</h1>
    <p class="weekly-date">{{ date_range }} · <strong>{{ week_id }}</strong></p>
    {% if event_count > 0 %}
    <p class="weekly-stats">{{ event_count }} event{% if event_count != 1 %}s{% endif %} this week</p>
    {% endif %}
</div>

<div class="pillar-tabs">
    {% for p_id, p_data in all_pillars.items() %}
    {% set p_palette = palette.get(p_id, palette["markets"]) %}
    <a href="/{{ pillar_urls[p_id] }}/weekly/{{ week_id }}/" class="pillar-tab {% if p_id == pillar %}active{% endif %}" {% if p_id == pillar %}style="background:{{ pc.color }};border-color:{{ pc.color }}"{% endif %}>
        {{ p_data.vibe }} {{ p_names[p_id] }}
    </a>
    {% endfor %}
</div>

{% if data.feynman_takeaway %}
<div class="takeaway-box">
    <p><strong>🧠 Feynman Takeaway</strong><br>{{ data.feynman_takeaway }}</p>
</div>
{% endif %}

{% if pillar_events %}
<div class="events-grid">
    {% for event in pillar_events %}
    <div class="event-card" style="border-left:3px solid {{ pc.color }}">
        <div class="event-card-header">
            <div class="event-meta">
                <span class="date-badge">{{ event.date }}</span>
                <span>{{ event.title }}</span>
            </div>
            {% if event.fingerprint_svg %}
            <div class="event-fingerprint">{{ event.fingerprint_svg | safe }}</div>
            {% endif %}
        </div>
        <h3>{{ event.title }}</h3>

        {% if event.feynman %}
        <div class="card-section feynman">
            <strong>In plain English</strong>
            {{ event.feynman }}
        </div>
        {% endif %}

        {% if event.analogy %}
        <div class="card-section analogy">
            <strong>Analogy</strong>
            {{ event.analogy }}
        </div>
        {% endif %}

        {% if event.why_it_matters %}
        <div class="card-section why">
            <strong>Why it matters</strong>
            {{ event.why_it_matters }}
        </div>
        {% endif %}

        {% if event.links %}
        <div class="event-links">
            {% for link in event.links %}
            <a href="{{ link.url }}">{{ link.label }}</a>
            {% endfor %}
        </div>
        {% endif %}
    </div>
    {% endfor %}
</div>
{% else %}
<div class="week-empty">
    <p>No significant {{ pillar_name }} developments recorded for this week.</p>
    <div class="week-empty-actions">
        <a href="/weekly/" class="btn btn-ghost btn-sm">Browse Archive</a>
        <a href="/{{ pillar_urls[pillar] }}/" class="btn btn-ghost btn-sm">Explore {{ pillar_name }}</a>
    </div>
</div>
{% endif %}

<div class="weekly-nav">
    {% if prev_week %}
    <a href="/{{ pillar_urls[pillar] }}/weekly/{{ prev_week }}/">← {{ prev_week }}</a>
    {% else %}
    <span></span>
    {% endif %}
    <span class="nav-center"><a href="/weekly/">📅 All Weeks</a></span>
    {% if next_week %}
    <a href="/{{ pillar_urls[pillar] }}/weekly/{{ next_week }}/">{{ next_week }} →</a>
    {% else %}
    <span></span>
    {% endif %}
</div>
{% endblock %}
