{% extends "layout.j2" %}
{% block main_content %}
<section>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs" style="color:var(--color-text-muted)">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><a href="/" class="hover:text-[var(--color-accent)] transition">Home</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Knowledge Base</li>
    </ol>
  </nav>

  <div class="mb-8">
    <h1 class="text-3xl font-extrabold" style="color:var(--color-text)">Knowledge Base</h1>
    <p class="mt-2 text-sm" style="color:var(--color-text-muted)">{{ items | length }} entries across {{ categories | length }} categories</p>
  </div>

  {%- for cat_id, cat_data in categories.items() %}
  {%- set cat_items = grouped[cat_id] | default([]) %}
  {%- if cat_items | length > 0 %}
  <div id="{{ cat_id }}" class="mb-12 scroll-mt-20">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-2xl">{{ cat_data.icon }}</span>
      <div>
        <h2 class="text-2xl font-bold" style="color:var(--color-text)">{{ cat_data.label }}</h2>
        <p class="text-sm" style="color:var(--color-text-muted)">{{ cat_data.description }}</p>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {%- for item in cat_items %}
      {%- set thumb_key = thumbnail_key(item.title) if thumbnail_key is defined else "" %}
      <a href="/{{ item.slug }}/" class="block rounded-lg overflow-hidden transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border);text-decoration:none">
        {%- if item.thumbnail_svg and thumb_key %}
        <div class="aspect-[3/1] overflow-hidden" style="background:#0f172a">
          <img src="{{ thumbnail_base }}/thumb_{{ thumb_key }}.svg" alt="" class="w-full h-full object-cover" loading="lazy">
        </div>
        {%- endif %}
        <div class="p-4">
          <h3 class="font-semibold" style="color:var(--color-text)">{{ item.title | striptags }}</h3>
          {%- if item.description %}
          <p class="mt-1 text-xs" style="color:var(--color-text-secondary)">{{ item.description[:200] }}</p>
          {%- endif %}
          <div class="mt-3 flex items-center gap-3 text-xs" style="color:var(--color-text-muted)">
            {%- if item.date_str %}
            <time datetime="{{ item.date_str }}">{{ item.date_str }}</time>
            {%- endif %}
            {%- if item.body_html %}
            <span>{{ item.body_html | reading_time }} min</span>
            {%- endif %}
          </div>
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
  {%- endif %}
  {%- endfor %}
</section>
{% endblock %}
