{% extends "layout.j2" %}
{% block main_content %}
<section>
  <h1>{{ page_title }}</h1>
  <div class="knowledge-categories">
    {% for cat, items in grouped.items() %}
    <div class="category">
      <h2>{{ cat | replace('_', ' ') | title }}</h2>
      <ul>
        {% for item in items %}
        <li><a href="/knowledge/{{ item.slug.split('/')[-1] }}/">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
