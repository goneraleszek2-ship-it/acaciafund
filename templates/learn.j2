{% extends "layout.j2" %}
{% from "macros/breadcrumbs.html" import breadcrumbs %}
{% block main_content %}
{{ breadcrumbs(page_path, content.title) }}
<div id="reading-progress"></div>

<article>
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover-accent transition">Home</a></li>
        <li aria-hidden="true">/</li>
        {%- set pillar_key = content.pillar or "aml" %}
        {%- set pc = pillar_config.get(pillar_key, pillar_config["aml"]) %}
        <li><a href="/{{ pc.url }}/" class="hover-accent transition">{{ pc.label }}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="truncate max-w-200px">{{ content.title | striptags }}</li>
      </ol>
    </nav>
    <header class="mb-6">
      <div class="flex items-center gap-2 mb-2">
        {{ layer_badge | default("") | safe }}
        {% set pillar = content.pillar %}
        {% include "macros/pillar_badge.html" %}
        {%- if content.difficulty %}
        <span class="badge-outline">{{ content.difficulty | capitalize }}</span>
        {%- endif %}
      </div>
      <h1 class="text-3xl font-extrabold leading-tight text-default">{{ content.title | striptags }}</h1>
      {%- if content.date_str %}
      <div class="mt-2 flex items-center gap-2 text-sm text-muted">
        <time datetime="{{ content.date_str }}">{{ content.date_str | format_date }}</time>
        {%- if content.reading_time %}<span aria-hidden="true"> · </span><span>{{ content.reading_time }} min read</span>{% endif %}
      </div>
      {%- endif %}
    </header>

    {% include 'partials/pretest_gate.j2' %}

    {% include 'partials/visual_abstract.j2' %}

    <div class="prose-body">
      {{ page_body | default(content.body_html) | wrap_prose_sections | safe }}
    </div>

    {% include 'partials/article_metadata.j2' %}

    {%- if ontology_concepts and ontology_concepts | length > 0 %}
    <section class="mt-12 pt-8 border-t border-muted">
      <h2 class="text-2xl font-bold mb-2 flex items-center gap-2 text-default">
        <svg class="section-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        Feynman Concept Cards
      </h2>
      <p class="text-sm mb-6 text-muted">Master each building block: read the ELI5, explore the analogy, work the example, find your gaps, teach it back, build it.</p>
      <div class="space-y-6" id="feynman-concept-cards">
        {%- for oc in ontology_concepts %}
        {% set concept = oc %}{% include 'partials/feynman_card.j2' %}
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {# End-of-lesson Feynman Synthesis #}
    <section class="mt-12 pt-8 border-t border-muted">
      <h2 class="text-2xl font-bold mb-4 flex items-center gap-2 text-default">
        <svg class="section-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Feynman Synthesis — Prove You Understand
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="ghost-card p-4">
          <h3 class="text-sm font-semibold mb-2 text-default">1. The One-Pager</h3>
          <p class="text-xs mb-3 text-muted">Explain this lesson's core idea to a smart 15-year-old. No jargon allowed.</p>
          <textarea class="w-full min-h-[100px] p-2 text-sm rounded border feynman-synthesis-input bg-surface border-muted text-default" id="feynman-onepager" placeholder="Your explanation..." style="resize:vertical"></textarea>
        </div>
        <div class="ghost-card p-4">
          <h3 class="text-sm font-semibold mb-2 text-default">2. The Gap Map</h3>
          <p class="text-xs mb-3 text-muted">List 3 things you are still unsure about. Be specific.</p>
          <textarea class="w-full min-h-[100px] p-2 text-sm rounded border feynman-synthesis-input bg-surface border-muted text-default" id="feynman-gaps" placeholder="1. ...\n2. ...\n3. ..." style="resize:vertical"></textarea>
        </div>
      </div>
      <div class="mt-4 flex gap-3">
        <button id="save-feynman-synthesis" class="btn-primary-sm">Save My Synthesis</button>
        <button id="submit-feynman-synthesis" class="btn-outline-sm">Submit for Review</button>
      </div>
    </section>

    {%- if quiz_json %}
    <section class="mt-12 pt-8 border-t border-muted" id="quiz-section" data-quiz='{{ quiz_json }}' data-quiz-lesson="{{ page_path }}">
      <h2 class="text-2xl font-bold mb-4 text-default">Knowledge Check</h2>
      <p class="text-sm mb-4 text-muted">Test your understanding of this lesson.</p>
      <div id="quiz-score" class="mb-4 text-sm font-semibold text-secondary"></div>
      <div id="quiz-container"></div>
      <div id="quiz-summary" class="mt-6 p-4 rounded-lg hidden ghost-card"></div>
      <button id="quiz-retry" class="mt-3 hidden btn-primary-sm">Retry Quiz</button>
    </section>
    {%- endif %}

    {%- if content.flashcards and content.flashcards | length > 0 %}
    <section class="mt-12 pt-8 border-t border-muted">
      <h2 class="text-2xl font-bold mb-6 inline-flex items-center gap-2 text-default">
        <svg class="section-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        Flashcards
      </h2>
      <p class="text-xs mb-4 text-muted">Space = flip &middot; 1-4 = grade &middot; Swipe on mobile</p>
      <div class="grid gap-4 sm:grid-cols-2" id="flashcard-grid">
        {%- for fc in content.flashcards[:12] %}
        {%- set fc_term = fc.term | default(fc.front | default("")) %}
        {%- set fc_def = fc.definition | default(fc.back | default("")) %}
        {%- if fc_term and fc_def %}
        <acacia-flashcard
          data-term="{{ fc_term }}"
          data-definition="{{ fc_def[:200] }}"
          data-card-id="{{ page_path }}#{{ loop.index0 }}"
          data-generate></acacia-flashcard>
        {%- endif %}
        {%- endfor %}
      </div>
    </section>
    <div class="mt-8 text-center">
      <button id="mark-complete-btn" data-track-lesson="{{ page_path }}" class="btn-primary-sm inline-flex items-center gap-2">
        <svg class="icon-inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span id="complete-btn-text">Mark Complete</span>
      </button>
    </div>
    {%- endif %}

    {%- if quiz_json %}
    <section class="mt-12 pt-8 border-t border-muted" id="quiz-section" data-quiz='{{ quiz_json }}' data-quiz-lesson="{{ page_path }}">
      <h2 class="text-2xl font-bold mb-4 text-default">Knowledge Check</h2>
      <p class="text-sm mb-4 text-muted">Test your understanding of this lesson.</p>
      <div id="quiz-score" class="mb-4 text-sm font-semibold text-secondary"></div>
      <div id="quiz-container"></div>
      <div id="quiz-summary" class="mt-6 p-4 rounded-lg hidden ghost-card"></div>
      <button id="quiz-retry" class="mt-3 hidden btn-primary-sm">Retry Quiz</button>
    </section>
    {%- endif %}

    {%- if source_synthesis and source_synthesis | length > 0 %}
    <section class="mt-12 pt-8 border-t border-muted">
      <h2 class="text-2xl font-bold mb-4 inline-flex items-center gap-2 text-default">
        <svg class="section-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Source Synthesis
      </h2>
      <div class="space-y-3">
        {%- for syn in source_synthesis | sort(attribute='synthesis_score') | reverse %}
        <div class="ghost-card p-4">
          <div class="flex items-start gap-3">
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-default">
                <a href="{{ syn.get('source_url', '#') }}" target="_blank" rel="noopener" class="hover-accent transition">{{ syn.get('source_title', 'Source') }}</a>
              </h3>
              <p class="mt-1 text-xs text-secondary">{{ syn.get('synthesis_text', '') }}</p>
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if related_research %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold mb-6">Related Research</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {%- for rp in related_research %}
        {%- set rpillar = rp.pillar or "aml" %}
        {%- set rpc = pillar_config.get(rpillar, pillar_config["aml"]) %}
        <a href="{{ slug_to_url(rp.slug) }}" class="ghost-card block text-decoration-none">
          <div class="p-3">
            {% set pillar = rp.pillar %}
            {% include "macros/pillar_badge.html" %}
            <span class="block mt-2 text-sm font-semibold text-default">{{ rp.title | striptags }}</span>
            {%- if rp.date_str %}
            <span class="block mt-1 text-xs font-meta text-muted">{{ rp.date_str | format_date }}</span>
            {%- endif %}
          </div>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if related_knowledge %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold mb-6">Related Knowledge</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {%- for rk in related_knowledge %}
        {%- set rpillar = rk.pillar or "aml" %}
        {%- set rpc = pillar_config.get(rpillar, pillar_config["aml"]) %}
        <a href="{{ slug_to_url(rk.slug) }}" class="ghost-card block text-decoration-none">
          <div class="p-3">
            {% set pillar = rk.pillar %}
            {% include "macros/pillar_badge.html" %}
            <span class="block mt-2 text-sm font-semibold text-default">{{ rk.title | striptags }}</span>
            {%- if rk.date_str %}
            <span class="block mt-1 text-xs font-meta text-muted">{{ rk.date_str | format_date }}</span>
            {%- endif %}
          </div>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if prev_lesson or next_lesson %}
    <nav class="mt-12 pt-6 border-t grid grid-cols-2 gap-4" aria-label="Lesson navigation">
      {%- if prev_lesson %}
      <a href="{{ slug_to_url(prev_lesson.slug) }}" class="ghost-card group block p-3 text-decoration-none">
        <span class="text-xs text-muted">&larr; Previous Lesson</span>
        <span class="block text-sm font-medium group-hover-accent truncate">{{ prev_lesson.title | striptags }}</span>
      </a>
      {%- endif %}
      {%- if next_lesson %}
      <a href="{{ slug_to_url(next_lesson.slug) }}" class="ghost-card group block p-3 text-decoration-none">
        <span class="text-xs text-muted">Next Lesson &rarr;</span>
        <span class="block text-sm font-medium group-hover-accent truncate">{{ next_lesson.title | striptags }}</span>
      </a>
      {%- endif %}
    </nav>
    {%- endif %}

    {# MathWorld-inspired sections #}
    {% include 'partials/see_also.j2' %}
    {% include 'partials/explore_tools.j2' %}
    {% include 'partials/contributor.j2' %}
    {% include 'partials/citation.j2' %}
  </article>

<script src="{{ 'js/learning.js' | asset }}" defer></script>
{% include 'partials/newsletter.html' %}
{% endblock %}