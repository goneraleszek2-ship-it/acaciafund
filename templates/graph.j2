{% extends "layout.j2" %}
{% from "macros/breadcrumbs.html" import breadcrumbs %}
{% block main_content %}
<section>
  {{ breadcrumbs('graph', 'Knowledge Graph') }}
  <hgroup>
    <h1>Knowledge Graph</h1>
    <p>Interactive topology of {{ node_count }} semantic nodes and {{ edge_count }} relationships across the Acacia knowledge repository.</p>
  </hgroup>

  <div class="graph-toolbar">
    <div class="graph-toolbar-group">
      <label>Pillar</label>
      <select id="graph-filter">
        <option value="all">All</option>
        <option value="compliance">Compliance</option>
        <option value="markets">Markets</option>
        <option value="data">Data Engineering</option>
        <option value="ontology">Ontology Only</option>
      </select>
    </div>
    <div class="graph-toolbar-group">
      <label>Relation&nbsp;type</label>
      <select id="graph-relation-filter">
        <option value="all">All</option>
        <option value="part_of">Part of</option>
        <option value="requires">Requires</option>
        <option value="related_to">Related to</option>
        <option value="detects">Detects</option>
        <option value="enables">Enables</option>
        <option value="implements">Implements</option>
        <option value="regulates">Regulates</option>
        <option value="influences">Influences</option>
        <option value="measures">Measures</option>
        <option value="supersedes">Supersedes</option>
      </select>
    </div>
    <div class="graph-toolbar-group">
      <label>Layout</label>
      <select id="graph-layout">
        <option value="cose-bilkent">Force-directed</option>
        <option value="dagre">Hierarchical</option>
        <option value="concentric">Concentric</option>
        <option value="breadthfirst">Breadth-first</option>
      </select>
    </div>
    <div class="graph-toolbar-group">
      <label>Search</label>
      <input type="text" id="graph-search" placeholder="Search nodes..." style="width:140px;font-size:0.8rem;padding:2px 6px;border-radius:4px;background:var(--color-bg);color:var(--color-text);border:1px solid var(--color-border)">
    </div>
    <div class="graph-toolbar-group graph-toolbar-actions">
      <button id="btn-reset" class="outline" style="font-size:0.75rem;padding:2px 8px">Reset</button>
      <button id="btn-download" class="outline" style="font-size:0.75rem;padding:2px 8px">PNG</button>
    </div>
  </div>

  <div id="cy" class="graph-container"></div>

  <div id="graph-detail" class="graph-detail" style="display:none">
    <div class="graph-detail-header">
      <span id="detail-title"></span>
      <button id="detail-close" class="outline" style="font-size:0.7rem;padding:1px 6px">&#x2715;</button>
    </div>
    <div id="detail-body" class="graph-detail-body"></div>
  </div>

  <details class="graph-legend" style="margin-top:0.5rem">
    <summary>Legend</summary>
    <ul class="legend-list">
      <li><span class="legend-dot" style="background:#6366f1"></span> Research</li>
      <li><span class="legend-dot" style="background:#22c55e"></span> Learn</li>
      <li><span class="legend-dot" style="background:#d97706"></span> Knowledge</li>
      <li><span class="legend-dot" style="background:#14b8a6; shape:diamond; border:2px solid #fff"></span> Concept</li>
      <li><span class="legend-dot" style="background:#22c55e"></span> part_of</li>
      <li><span class="legend-dot" style="background:#3b82f6"></span> requires</li>
      <li><span class="legend-dot" style="background:#f59e0b"></span> related_to</li>
      <li><span class="legend-dot" style="background:#ef4444"></span> detects</li>
      <li><span class="legend-dot" style="background:#a855f7"></span> other</li>
    </ul>
    <p><small>Click a node to highlight neighbours and show details. Hover to preview. Drag to rearrange. Scroll to zoom.</small></p>
  </details>
</section>

<script src="{{ 'js/vendor/cytoscape/cytoscape.min.js' | asset }}" defer></script>
<script src="{{ 'js/vendor/cytoscape/cytoscape-cose-bilkent.js' | asset }}" defer></script>
<script src="{{ 'js/vendor/cytoscape/dagre.min.js' | asset }}" defer></script>
<script src="{{ 'js/vendor/cytoscape/cytoscape-dagre.js' | asset }}" defer></script>
<script src="{{ 'js/graph.js' | asset }}" defer></script>

<style>
  .graph-container {
    width: 100%;
    height: 600px;
    border: 1px solid var(--pico-muted-border-color, #334155);
    border-radius: 8px;
    background: #0f172a;
    margin: 0.5rem 0;
    position: relative;
    overflow: hidden;
  }
  .graph-container:empty::after {
    content: 'Loading graph...';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    font-style: italic;
  }
  .graph-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.75rem 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--pico-muted-border-color, #334155);
    border-radius: 6px;
    background: var(--pico-card-background-color, transparent);
    align-items: flex-end;
  }
  .graph-toolbar-group {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .graph-toolbar-group label {
    font-size: 0.7rem;
    color: var(--color-text-muted, #888);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .graph-toolbar-group select,
  .graph-toolbar-group input {
    font-size: 0.8rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border, #334155);
  }
  .graph-toolbar-actions {
    flex-direction: row;
    align-items: flex-end;
    gap: 0.35rem;
    margin-left: auto;
  }
  .graph-detail {
    margin: 0.5rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--pico-muted-border-color, #334155);
    border-radius: 6px;
    background: var(--pico-card-background-color, transparent);
  }
  .graph-detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .graph-detail-body {
    font-size: 0.85rem;
    color: var(--color-text-secondary, #aaa);
    line-height: 1.5;
  }
  .graph-detail-body .detail-badge {
    display: inline-block;
    padding: 1px 8px;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
    margin-right: 0.5rem;
    text-transform: capitalize;
  }
  .graph-detail-body .detail-link {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--color-accent, #818cf8);
    text-decoration: none;
  }
  .graph-detail-body .detail-link:hover {
    text-decoration: underline;
  }
  .graph-detail-body .detail-section {
    margin-top: 0.4rem;
  }
  .graph-detail-body .detail-neighbors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }
  .graph-detail-body .detail-neighbor {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-accent, #818cf8) 8%, transparent);
    cursor: pointer;
    flex: 1 1 auto;
    min-width: 80px;
  }
  .graph-detail-body .detail-neighbor:hover {
    background: color-mix(in srgb, var(--color-accent, #818cf8) 20%, transparent);
  }
  .graph-legend {
    margin: 0.5rem 0;
    padding: 0.5rem 1rem;
    border: 1px solid var(--pico-muted-border-color, #334155);
    border-radius: 6px;
    background: var(--pico-card-background-color, transparent);
  }
  .legend-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
  }
  .legend-list li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
  }
  .legend-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
{% endblock %}
