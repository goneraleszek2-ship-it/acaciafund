{% extends "layout.j2" %}
{% block main_content %}
<section>
  <h1>{{ page_title }}</h1>
  <div class="pillar-groups">
    {% for item in items %}
    <div class="pillar">
      <h2>{{ item.pillar | replace('-', ' ') | title if item.pillar else 'Research' }}</h2>
      <ul>
        <li><a href="{{ slug_to_url(item.slug) }}">{{ item.title }}</a></li>
      </ul>
    </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
