{% extends "layout.j2" %}
{% block main_content %}
<section>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs" style="color:var(--color-text-muted)">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><a href="/" class="hover:text-[var(--color-accent)] transition">Home</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{{ content.title }}</li>
    </ol>
  </nav>

  <div class="mb-8 flex items-center gap-4">
    {%- set icon_map = {"Research": "icon-research", "Learn": "icon-learn", "Knowledge": "icon-knowledge"} %}
    {%- set ct_icon = icon_map.get(content.title, "") %}
    {%- if ct_icon %}
    <img src="/static/images/{{ ct_icon }}.svg" alt="" class="w-10 h-10 shrink-0">
    {%- endif %}
    <div>
      <h1 class="text-3xl font-extrabold" style="color:var(--color-text)">{{ content.title }}</h1>
      <p class="mt-2 text-sm" style="color:var(--color-text-muted)">{{ items | length }} entries</p>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    {%- for item in items %}
    {%- set sqi = (item.signals.get("avg_sqi", 0.0) | float) if item.signals else 0.0 %}
    {%- set pillar = item.pillar or "" %}
    {%- set source_breakdown = item.source_breakdown or {} %}
    {%- set pillar_color = pillar_config.get(pillar, {}).get("color", "#6366f1") %}
    {%- set pillar_icon = pillar_emojis.get(pillar, "") %}
    {%- set risk_count = item.quality_flags | length if item.quality_flags else 0 %}
    <a href="/{{ item.slug }}/" class="card-research" style="text-decoration:none">
      <div class="card-research-left">
        <span class="card-research-sqi">{{ "%.2f"|format(sqi) }}</span>
        <span class="card-research-sqi-label">SQI</span>
        {%- for src, count in source_breakdown.items() if count > 0 %}
        {%- set src_class = "src-hn" if src == "hn" or src == "hackernews" else "src-ar" if src == "arxiv" or src == "ar" else "src-pu" %}
        <span class="card-research-source {{ src_class }}">{{ src[:2].upper() }}</span>
        {%- endfor %}
      </div>
      <div class="card-research-body">
        <div class="card-research-meta">
          <span class="card-research-pillar" style="color:{{ pillar_color }}">{{ pillar_icon }} {{ pillar_names.get(pillar, pillar) | default("Research") }}</span>
          <span class="card-research-meta-right">
            {%- if item.date_str %}
            <time datetime="{{ item.date_str }}">{{ item.date_str }}</time>
            {%- endif %}
            {%- if item.body_html %}
            <span>{{ item.body_html | reading_time }} min</span>
            {%- endif %}
          </span>
        </div>
        <h2 class="card-research-title">{{ item.title | striptags }}</h2>
        {%- if item.description %}
        <p class="card-research-summary">{{ item.description[:200] }}</p>
        {%- endif %}
        {%- if risk_count > 0 %}
        <div class="card-research-risk">&#9888; {{ risk_count }} quality flag(s)</div>
        {%- endif %}
      </div>
    </a>
    {%- endfor %}
  </div>
</section>
{% endblock %}