{% extends "layout.j2" %}
{% block main_content %}
<section class="hero-section">
  <h1>Your learning&nbsp;journey starts here</h1>
  <p class="hero-subtitle">Pick a topic below and start mastering complex concepts through the Feynman Technique — simple explanations, vivid analogies, and active recall.</p>
</section>

<section class="mb-8">
  <h2 class="text-lg font-bold mb-4 text-default">Choose Your Path</h2>
  <div class="grid gap-4 sm:grid-cols-3">
    <a href="/compliance/" class="pillar-card ghost-card p-4 no-underline block card-accent-top" style="--card-color:#f97316">
      <span class="pillar-icon">&127991;</span>
      <h3 class="text-sm font-bold mt-2 text-default">AML &amp; Compliance</h3>
      <p class="text-xs mt-1 text-secondary">Financial crime prevention, KYC, sanctions screening, transaction monitoring.</p>
      <span class="difficulty-badge beginner mt-2 inline-block">Beginner friendly</span>
    </a>
    <a href="/markets/" class="pillar-card ghost-card p-4 no-underline block card-accent-top" style="--card-color:#34d399">
      <span class="pillar-icon">&#128200;</span>
      <h3 class="text-sm font-bold mt-2 text-default">Markets &amp; Trading</h3>
      <p class="text-xs mt-1 text-secondary">Market microstructure, volatility analysis, quantitative methods, trading strategies.</p>
      <span class="difficulty-badge beginner mt-2 inline-block">Beginner friendly</span>
    </a>
    <a href="/data/" class="pillar-card ghost-card p-4 no-underline block card-accent-top" style="--card-color:#818cf8">
      <span class="pillar-icon">&#128421;</span>
      <h3 class="text-sm font-bold mt-2 text-default">Data Engineering</h3>
      <p class="text-xs mt-1 text-secondary">Pipeline architecture, streaming, batch processing, storage formats, data quality.</p>
      <span class="difficulty-badge beginner mt-2 inline-block">Beginner friendly</span>
    </a>
  </div>
</section>

<section class="mb-8">
  <h2 class="text-lg font-bold mb-2 text-default">How Learning Works</h2>
  <div class="grid gap-4 sm:grid-cols-3 text-center">
    <div class="ghost-card p-5">
      <div class="step-circle">1</div>
      <h3 class="text-sm font-bold mb-2 text-default">Pick a Topic</h3>
      <p class="text-xs text-secondary line-height-base">Each pillar is explained from the ground up.</p>
    </div>
    <div class="ghost-card p-5">
      <div class="step-circle">2</div>
      <h3 class="text-sm font-bold mb-2 text-default">Learn Simply</h3>
      <p class="text-xs text-secondary line-height-base">ELI5 first, then analogies, examples, and diagrams.</p>
    </div>
    <div class="ghost-card p-5">
      <div class="step-circle">3</div>
      <h3 class="text-sm font-bold mb-2 text-default">Test Yourself</h3>
      <p class="text-xs text-secondary line-height-base">Teach back, build exercises, spaced repetition.</p>
    </div>
  </div>
  <details class="ghost-card mt-3" style="padding:1rem">
    <summary class="text-sm font-semibold text-default" style="cursor:pointer;user-select:none;list-style:none;display:flex;align-items:center;gap:0.5rem">
      <span style="transition:transform 0.2s">&#9654;</span> About the Feynman Technique
    </summary>
    <div class="mt-3 text-sm text-secondary line-height-relaxed">
      <p class="mb-3"><strong class="text-default">&ldquo;If you can't explain it simply, you don't understand it well enough.&rdquo;</strong> &mdash; Richard Feynman</p>
      <ol class="space-y-2">
        <li><strong class="text-default">Choose a concept</strong> — pick something you want to learn.</li>
        <li><strong class="text-default">Explain it simply</strong> — use plain language, no jargon.</li>
        <li><strong class="text-default">Identify gaps</strong> — where did you struggle? Go back.</li>
        <li><strong class="text-default">Review and simplify</strong> — refine and find better analogies.</li>
      </ol>
      <p class="mt-3">Acacia extends this into six stages: <strong class="text-default">Explain &rarr; Analogize &rarr; Exemplify &rarr; Diagram &rarr; Find Gaps &rarr; Build &rarr; Teach Back</strong>.</p>
    </div>
  </details>
</section>

<section class="mb-8">
  <h2 class="text-lg font-bold mb-4 text-default">Learning Tips</h2>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="ghost-card p-4">
      <h3 class="text-sm font-bold mb-2 text-default">Start with ELI5</h3>
      <p class="text-xs text-secondary line-height-base">Every concept has an "Explain Like I'm 5" section. Read that first. If you can't understand it, find a simpler prerequisite.</p>
    </div>
    <div class="ghost-card p-4">
      <h3 class="text-sm font-bold mb-2 text-default">Use Learning Paths</h3>
      <p class="text-xs text-secondary line-height-base">Each pillar has progressive learning paths. Follow them in order for the best results.</p>
    </div>
    <div class="ghost-card p-4">
      <h3 class="text-sm font-bold mb-2 text-default">Test Yourself Often</h3>
      <p class="text-xs text-secondary line-height-base">Use Teach Back and Build exercises. Writing your own explanation is the best way to find gaps.</p>
    </div>
    <div class="ghost-card p-4">
      <h3 class="text-sm font-bold mb-2 text-default">Track Your Progress</h3>
      <p class="text-xs text-secondary line-height-base">Visit <a href="/review/" class="text-accent">My Progress</a> to see mastery across all concepts and get personalized review recommendations.</p>
    </div>
  </div>
</section>
{% endblock %}