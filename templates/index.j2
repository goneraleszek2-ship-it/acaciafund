{% extends "layout.j2" %}
{% block main_content %}
<section>
  <h1>{{ site_name }}</h1>
  <p>{{ site_description }}</p>
</section>

<section>
  <h2>Recent Research</h2>
  <div class="grid">
    {% for item in recent_posts %}
    <article>
      <hgroup>
        <h3><a href="/{{ item.slug }}/">{{ item.title }}</a></h3>
        <p>{{ item.description }}</p>
      </hgroup>
      <footer>
        <a href="/{{ item.slug }}/" role="button" class="outline">Read more →</a>
      </footer>
    </article>
    {% endfor %}
  </div>
</section>

<section>
  <h2>Explore by Category</h2>
  <div class="grid">
    <a href="/research/" role="button" class="secondary">Research</a>
    <a href="/learn/" role="button" class="secondary">Learn</a>
    <a href="/knowledge/" role="button" class="secondary">Knowledge</a>
  </div>
</section>
{% endblock %}
