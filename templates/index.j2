{% extends "layout.j2" %}
{% block main_content %}
<section class="text-center py-12 sm:py-16" aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
    Research Synthesis &amp;<br>Experimental Learning
  </h1>
  <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
    Automated classification of HackerNews + arXiv content using Bloom taxonomy.
    Static-first, privacy-preserving, zero client-side JavaScript required.
  </p>
  <div class="mt-8 flex flex-wrap justify-center gap-4">
    <a href="/research.html" class="inline-block px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition">Explore Research</a>
    <a href="/aml/" class="inline-block px-6 py-3 border border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 transition">Read Blog</a>
  </div>
</section>

{%- if recent_posts %}
<section class="mt-12" aria-labelledby="latest-heading">
  <h2 id="latest-heading" class="text-2xl font-bold text-gray-900 mb-6">Latest Posts</h2>
  <div class="grid gap-6 md:grid-cols-2">
  {%- for item in recent_posts %}
    {%- set p = item.pillar or "aml" %}
    {%- set pc = pillar_config.get(p, pillar_config["aml"]) %}
    <article class="bg-white rounded-lg border p-5 hover:shadow-md transition" style="border-color:var(--color-border)">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded {{ pc.badge_color }}">
          {{ pc.emoji }} {{ pc.label }}
        </span>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 leading-snug">
        <a href="/{{ item.slug }}/" class="hover:text-blue-600 transition">{{ item.title | striptags }}</a>
      </h3>
      <div class="mt-2 flex items-center gap-3 text-xs text-gray-500">
        {%- if item.date_str %}
        <time datetime="{{ item.date_str }}">{{ item.date_str }}</time>
        {%- endif %}
        {%- if item.body_html %}
        <span>{{ item.body_html | reading_time }} min</span>
        {%- endif %}
        {%- if item.signals and item.signals.get("avg_sqi") is defined %}
        <span class="font-mono">SQI {{ "%.3f"|format(item.signals.get("avg_sqi", 0)) }}</span>
        {%- endif %}
      </div>
      {%- if item.description %}
      <p class="mt-2 text-sm text-gray-600 line-clamp-2">{{ item.description[:160] }}</p>
      {%- endif %}
    </article>
  {%- endfor %}
  </div>
  <div class="mt-6 text-center">
    <a href="/aml/" class="text-sm text-blue-600 hover:underline">View all posts &rarr;</a>
  </div>
</section>
{%- endif %}

{%- if lessons %}
<section class="mt-16" aria-labelledby="learn-heading">
  <h2 id="learn-heading" class="text-2xl font-bold text-gray-900 mb-6">Learning Hub</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {%- for item in lessons[:6] %}
    <a href="/{{ item.slug }}/" class="block bg-white rounded-lg border border-gray-200 p-4 hover:shadow-md transition">
      <h3 class="font-semibold text-gray-900">{{ item.title | striptags }}</h3>
      <p class="mt-1 text-sm text-gray-500 capitalize">{{ item.category }}</p>
    </a>
  {%- endfor %}
  </div>
</section>
{%- endif %}

<section class="mt-16 text-center" aria-labelledby="stack-heading">
  <h2 id="stack-heading" class="text-2xl font-bold text-gray-900 mb-4">Stack</h2>
  <div class="flex flex-wrap justify-center gap-3 text-sm text-gray-600">
    <span class="px-3 py-1 bg-white border rounded-full">Python 3.13</span>
    <span class="px-3 py-1 bg-white border rounded-full">Pydantic</span>
    <span class="px-3 py-1 bg-white border rounded-full">Jinja2</span>
    <span class="px-3 py-1 bg-white border rounded-full">Markdown2</span>
    <span class="px-3 py-1 bg-white border rounded-full">Tailwind CSS</span>
    <span class="px-3 py-1 bg-white border rounded-full">Cloudflare Pages</span>
  </div>
</section>
{% endblock %}
