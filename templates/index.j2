{% extends "layout.j2" %}
{% block main_content %}
<section class="text-center py-8 sm:py-16" aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="text-4xl font-extrabold tracking-tight sm:text-5xl" style="color:var(--color-text)">
    Research Synthesis &amp;<br>Experimental Learning
  </h1>
  <p class="mt-4 text-lg max-w-2xl mx-auto" style="color:var(--color-text-secondary)">
    Automated classification of HackerNews + arXiv content using Bloom taxonomy.
    Static-first, privacy-preserving, zero client-side JavaScript required.
  </p>
  <div class="mt-6 sm:mt-8 flex flex-wrap justify-center gap-2 sm:gap-3">
    <a href="/research/" class="inline-block px-5 py-2.5 sm:px-6 sm:py-3 text-sm sm:text-base font-semibold rounded-lg transition hover:opacity-90 text-center" style="background:var(--color-accent);color:white">Research</a>
    <a href="/learn/" class="inline-block px-5 py-2.5 sm:px-6 sm:py-3 text-sm sm:text-base font-semibold rounded-lg transition hover:opacity-80 text-center" style="border:1px solid var(--color-border);color:var(--color-text)">Learn</a>
    <a href="/knowledge/" class="inline-block px-5 py-2.5 sm:px-6 sm:py-3 text-sm sm:text-base font-semibold rounded-lg transition hover:opacity-80 text-center" style="border:1px solid var(--color-border);color:var(--color-text)">Knowledge</a>
    <a href="/research/" id="surprise-btn" class="inline-flex items-center gap-1.5 px-5 py-2.5 sm:px-6 sm:py-3 text-sm sm:text-base font-semibold rounded-lg transition hover:opacity-80 text-center" style="border:1px solid var(--color-border);color:var(--color-text)" onclick="surpriseMe();return false"><span style="font-size:1.1em;line-height:1">🎲</span> Surprise Me</a>
  </div>
  <script>
  function surpriseMe(){
    var x=new XMLHttpRequest();
    x.open('GET','/static/search-index.json',true);
    x.onload=function(){
      if(x.status===200){
        try {
          var idx=JSON.parse(x.responseText);
          if(idx.length>0){
            var pick=idx[Math.floor(Math.random()*idx.length)];
            window.location.href='/'+pick.slug+'/';
          }
        } catch(e){}
      }
    };
    x.onerror=function(){};
    x.send();
  }
  </script>
</section>

<section id="continue-learning" class="mt-8 hidden" aria-labelledby="continue-heading">
  <h2 id="continue-heading" class="text-2xl font-bold mb-4" style="color:var(--color-text)">Continue Learning</h2>
  <div class="flex flex-wrap items-center gap-4 mb-4 text-sm" style="color:var(--color-text-secondary)">
    <span id="continue-progress">0/0 completed</span>
    <span id="streak-display" class="inline-flex items-center gap-1 text-base" hidden></span>
    <button id="reset-progress-btn" class="text-xs underline hover:no-underline" style="color:var(--color-text-muted)">Reset progress</button>
  </div>
  <div id="continue-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
</section>

<script>
(function(){
  var PROGRESS_KEY = 'acacia_progress_v1';
  function loadProgress(){
    try{ return JSON.parse(localStorage.getItem(PROGRESS_KEY) || '{}'); }catch(e){return {};}
  }
  function computeStreak(p){
    var dates = [];
    Object.keys(p).forEach(function(k){
      var entry = p[k];
      if(entry && entry.ts){
        var d = new Date(entry.ts);
        dates.push(d.toISOString().slice(0,10));
      }
    });
    if(!dates.length) return 0;
    var unique = {};
    dates.forEach(function(d){ unique[d] = true; });
    var sorted = Object.keys(unique).sort().reverse();
    var streak = 0;
    var today = new Date().toISOString().slice(0,10);
    var check = today;
    for(var i = 0; i < sorted.length; i++){
      if(sorted[i] === check){
        streak++;
        var d = new Date(check);
        d.setDate(d.getDate() - 1);
        check = d.toISOString().slice(0,10);
      } else if(sorted[i] < check){
        break;
      }
    }
    return streak;
  }

  var p = loadProgress();
  var totalItems = [{%- for item in learn_items %}{% if item.slug != "learn" %}{slug:"/{{ item.slug }}/",title:"{{ item.title | striptags | e }}",pillar:"{{ item.pillar or "" }}",diff:"{{ item.difficulty or "beginner" }}"}{% if not loop.last %},{% endif %}{% endif %}{%- endfor %}];
  var done = 0;
  var incomplete = [];
  totalItems.forEach(function(it){
    if(p[it.slug] && p[it.slug].done){
      done++;
    } else {
      incomplete.push(it);
    }
  });
  if(totalItems.length > 0){
    var contSec = document.getElementById('continue-learning');
    var contProg = document.getElementById('continue-progress');
    var contList = document.getElementById('continue-list');
    var streakEl = document.getElementById('streak-display');
    if(contSec){
      contSec.classList.remove('hidden');
      if(contProg) contProg.textContent = done + '/' + totalItems.length + ' completed';
      var streak = computeStreak(p);
      if(streak > 0 && streakEl){
        streakEl.removeAttribute('hidden');
        var fire = streak >= 7 ? '🔥' : streak >= 3 ? '✨' : '📖';
        streakEl.innerHTML = fire + ' ' + streak + ' day' + (streak !== 1 ? 's' : '') + ' streak';
      }
      if(incomplete.length > 0){
        var pillarBadgeColors = {aml:{bg:'#fef3c7',text:'#92400e'},stock:{bg:'#dcfce7',text:'#166534'},'data-engineering':{bg:'#e0e7ff',text:'#3730a3'}};
        var dEmoji = {beginner:'🌱', intermediate:'📘', advanced:'🔥'};
        incomplete.slice(0,6).forEach(function(it){
          var bc = pillarBadgeColors[it.pillar] || {bg:'var(--color-bg)',text:'var(--color-text-muted)'};
          var a = document.createElement('a');
          a.href = it.slug + '/';
          a.className = 'block rounded-xl p-4 transition hover:-translate-y-0.5 hover:shadow-md';
          a.style.cssText = 'background:var(--color-surface);border:1px solid var(--color-border);text-decoration:none';
          a.innerHTML = '<div class="flex items-center gap-2 mb-2"><span class="text-xs px-2 py-0.5 font-medium rounded" style="background:' + bc.bg + ';color:' + bc.text + '">' + (it.pillar ? it.pillar.charAt(0).toUpperCase() + it.pillar.slice(1) : '') + '</span><span class="text-xs" style="color:var(--color-text-muted)">' + (dEmoji[it.diff] || '') + ' ' + it.diff.charAt(0).toUpperCase() + it.diff.slice(1) + '</span></div><span class="font-semibold text-sm" style="color:var(--color-text)">' + it.title + '</span>';
          contList.appendChild(a);
        });
      }
    }
  }
  var resetBtn = document.getElementById('reset-progress-btn');
  if(resetBtn){
    resetBtn.addEventListener('click', function(){
      if(confirm('Reset all learning progress?')){
        localStorage.removeItem(PROGRESS_KEY);
        window.location.reload();
      }
    });
  }
})();
</script>

{%- if featured_posts %}
<section class="mt-8" aria-labelledby="featured-heading">
  <h2 id="featured-heading" class="sr-only">Featured Articles</h2>
  <div class="grid gap-6 md:grid-cols-3">
  {%- for item in featured_posts %}
    {%- set p = item.pillar or "aml" %}
    {%- set pc = pillar_config.get(p, pillar_config["aml"]) %}
    {%- set tkey = thumbnail_key(item.title) %}
    <a href="/{{ item.slug }}/" class="group block rounded-xl overflow-hidden transition hover:shadow-lg" style="background:var(--color-surface);border:1px solid var(--color-border);text-decoration:none">
      <div class="aspect-[600/340] overflow-hidden" style="background:var(--color-bg)">
        <img src="{{ thumbnail_base }}/thumb_{{ tkey }}.svg" alt="" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy">
      </div>
      <div class="p-4">
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded {{ pc.badge_color }}">
            {{ pc.emoji }} {{ pc.label }}
          </span>
        </div>
        <h3 class="text-base font-semibold leading-snug" style="color:var(--color-text)">{{ item.title | striptags }}</h3>
        <div class="mt-2 flex items-center gap-3 text-xs" style="color:var(--color-text-secondary)">
          {%- if item.date_str %}
          <time datetime="{{ item.date_str }}">{{ item.date_str }}</time>
          {%- endif %}
          {%- if item.body_html %}
          <span>{{ item.body_html | reading_time }} min</span>
          {%- endif %}
          {%- if item.signals and item.signals.get("avg_sqi") is defined %}
          <span class="font-mono">SQI {{ "%.3f"|format(item.signals.get("avg_sqi", 0)) }}</span>
          {%- endif %}
        </div>
      </div>
    </a>
  {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if recent_posts %}
<section class="mt-12" aria-labelledby="latest-heading">
  <h2 id="latest-heading" class="text-2xl font-bold mb-6" style="color:var(--color-text)">Latest Research</h2>
  <div class="grid gap-5 md:grid-cols-2">
  {%- for item in recent_posts %}
    {%- set p = item.pillar or "aml" %}
    {%- set pc = pillar_config.get(p, pillar_config["aml"]) %}
    {%- set tkey = thumbnail_key(item.title) %}
    <article class="flex gap-4 rounded-lg p-4 transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border)">
      <div class="shrink-0 w-24 h-20 rounded-md overflow-hidden sm:block" style="background:var(--color-bg)">
        <img src="{{ thumbnail_base }}/thumb_{{ tkey }}.svg" alt="" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded {{ pc.badge_color }}">
            {{ pc.emoji }} {{ pc.label }}
          </span>
        </div>
        <h3 class="text-base font-semibold leading-snug" style="color:var(--color-text)">
          <a href="/{{ item.slug }}/" class="transition" style="color:var(--color-text);text-decoration:none">{{ item.title | striptags }}</a>
        </h3>
        <div class="mt-1 flex items-center gap-3 text-xs" style="color:var(--color-text-secondary)">
          {%- if item.date_str %}
          <time datetime="{{ item.date_str }}">{{ item.date_str }}</time>
          {%- endif %}
          {%- if item.body_html %}
          <span>{{ item.body_html | reading_time }} min</span>
          {%- endif %}
          {%- if item.signals and item.signals.get("avg_sqi") is defined %}
          <span class="font-mono">SQI {{ "%.3f"|format(item.signals.get("avg_sqi", 0)) }}</span>
          {%- endif %}
        </div>
      </div>
    </article>
  {%- endfor %}
  </div>
  <div class="mt-6 text-center">
    <a href="/research/" class="text-sm font-medium transition hover:opacity-70" style="color:var(--color-accent)">View all research &rarr;</a>
  </div>
</section>
{%- endif %}

{%- if learn_items %}
<section class="mt-16" aria-labelledby="learn-heading">
  <h2 id="learn-heading" class="text-2xl font-bold mb-6" style="color:var(--color-text)">Learning Hub</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {%- set d_emoji = {"beginner": "🌱", "intermediate": "📘", "advanced": "🔥"} %}
  {%- for item in learn_items[:6] %}
    {%- set p = item.pillar or "" %}
    {%- set pc = pillar_config.get(p, none) %}
    {%- set tkey = thumbnail_key(item.title) %}
    <a href="/{{ item.slug }}/" class="block rounded-lg overflow-hidden transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border);text-decoration:none">
      <div class="aspect-[600/340] overflow-hidden" style="background:var(--color-bg)">
        <img src="{{ thumbnail_base }}/thumb_{{ tkey }}.svg" alt="" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="p-4">
        <div class="flex items-center gap-2 mb-2">
          {%- if pc %}
          <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded {{ pc.badge_color }}">
            {{ pc.emoji }} {{ pc.label }}
          </span>
          {%- endif %}
          {%- if item.difficulty %}
          <span class="text-xs" style="color:var(--color-text-muted)">{{ d_emoji.get(item.difficulty, "📘") }} {{ item.difficulty | capitalize }}</span>
          {%- endif %}
        </div>
        <h3 class="font-semibold" style="color:var(--color-text)">{{ item.title | striptags }}</h3>
        {%- if item.description %}
        <p class="mt-1 text-xs" style="color:var(--color-text-secondary)">{{ item.description[:150] }}</p>
        {%- endif %}
        {%- if item.body_html %}
        <div class="mt-2 text-xs" style="color:var(--color-text-muted)">{{ item.body_html | reading_time }} min</div>
        {%- endif %}
      </div>
    </a>
  {%- endfor %}
  </div>
  <div class="mt-4 text-center">
    <a href="/learn/" class="text-sm font-medium transition hover:opacity-70" style="color:var(--color-accent)">View all lessons &rarr;</a>
  </div>
</section>
{%- endif %}

{%- if knowledge_items %}
<section class="mt-16" aria-labelledby="knowledge-heading">
  <h2 id="knowledge-heading" class="text-2xl font-bold mb-6" style="color:var(--color-text)">Knowledge Base</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {%- for item in knowledge_items[:6] %}
    <a href="/{{ item.slug }}/" class="block rounded-lg p-4 transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border);text-decoration:none">
      <h3 class="font-semibold" style="color:var(--color-text)">{{ item.title | striptags }}</h3>
      <p class="mt-1 text-sm" style="color:var(--color-text-secondary)">{{ item.description | truncate(100) }}</p>
    </a>
  {%- endfor %}
  </div>
  <div class="mt-4 text-center">
    <a href="/knowledge/" class="text-sm font-medium transition hover:opacity-70" style="color:var(--color-accent)">View all knowledge &rarr;</a>
  </div>
</section>
{%- endif %}

<section class="mt-16 text-center" aria-labelledby="stack-heading">
  <h2 id="stack-heading" class="text-2xl font-bold mb-4" style="color:var(--color-text)">Stack</h2>
  <div class="flex flex-wrap justify-center gap-4 text-sm" style="color:var(--color-text-secondary)">
    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full" style="background:var(--color-surface);border:1px solid var(--color-border)">
      <img src="/static/images/tech/python.svg" alt="" class="w-5 h-5"> Python 3.13
    </span>
    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full" style="background:var(--color-surface);border:1px solid var(--color-border)">
      <img src="/static/images/tech/pydantic.svg" alt="" class="w-5 h-5"> Pydantic
    </span>
    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full" style="background:var(--color-surface);border:1px solid var(--color-border)">
      <img src="/static/images/tech/jinja2.svg" alt="" class="w-5 h-5"> Jinja2
    </span>
    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full" style="background:var(--color-surface);border:1px solid var(--color-border)">
      <img src="/static/images/tech/markdown2.svg" alt="" class="w-5 h-5"> Markdown2
    </span>
    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full" style="background:var(--color-surface);border:1px solid var(--color-border)">
      <img src="/static/images/tech/tailwind.svg" alt="" class="w-5 h-5"> Tailwind CSS
    </span>
    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full" style="background:var(--color-surface);border:1px solid var(--color-border)">
      <img src="/static/images/tech/cloudflare.svg" alt="" class="w-5 h-5"> Cloudflare Pages
    </span>
  </div>
</section>
{% endblock %}
