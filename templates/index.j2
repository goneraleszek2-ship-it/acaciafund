{% extends "layout.j2" %}
{% block main_content %}
<section>
  <h1>{{ site_name }}</h1>
  <p>{{ site_description }}</p>
</section>

<section>
  <h2>Recent Research</h2>
  <div class="grid">
    {% for item in recent_posts %}
    <article>
      <hgroup>
        <h3><a href="{{ slug_to_url(item.slug) }}">{{ item.title }}</a></h3>
        <p>{{ item.description }}</p>
      </hgroup>
      <footer>
        {% if item.tags %}
        <div style="margin-bottom: var(--pico-spacing); display: flex; flex-wrap: wrap; gap: 0.25rem;">
          {% for tag in item.tags[:4] %}
          <a href="/tags/{{ tag | lower | replace(' ', '-') }}/"><kbd>{{ tag }}</kbd></a>
          {% endfor %}
        </div>
        {% endif %}
        <a href="{{ slug_to_url(item.slug) }}" role="button" class="outline">Read more →</a>
      </footer>
    </article>
    {% endfor %}
  </div>
</section>

{% endblock %}
