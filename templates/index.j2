            <div class="text-xs text-slate-500">Agents, Workflows</div>
          </div>
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800">
            <div class="text-2xl mb-1">🏗️</div>
            <div class="font-semibold text-sm" style="color:var(--color-text)">Build</div>
            <div class="text-xs text-slate-500">Real Projects</div>
          </div>
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800">
            <div class="text-2xl mb-1">📊</div>
            <div class="font-semibold text-sm" style="color:var(--color-text)">Analyze</div>
            <div class="text-xs text-slate-500">Quality Scores</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Latest Research with Visual Hierarchy -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold mb-0" style="color:var(--color-text)">Latest Research</h2>
      <a href="/research/" class="text-teal-600 hover:text-teal-700 font-semibold flex items-center gap-1 whitespace-nowrap">
        View all
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
    
    <div class="space-y-8">
      {%- if recent_posts and recent_posts[0] %}
        {%- set featured = recent_posts[0] %}
        {%- set picto = featured | pictogram %}
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 bg-slate-50 dark:bg-slate-900 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
          <div class="md:col-span-5 relative min-h-[200px] rounded-lg bg-slate-200 dark:bg-slate-800 flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 opacity-10 bg-center bg-no-repeat bg-contain" style="background-image: url('/static/images/{{ picto }}');"></div>
            <span class="text-xs font-mono px-3 py-1 bg-amber-400 text-slate-900 font-bold rounded-full absolute top-3 left-3 shadow z-10">★ FEATURED</span>
          </div>
          <div class="md:col-span-7 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-extrabold uppercase tracking-wider text-blue-500" style="color:var(--color-{{ featured.pillar or 'aml' }})">{{ pillar_config.get(featured.pillar, {}).get('label', 'Research') }}</span>
                {%- if featured.slug in trending_slugs %}
                  <span class="text-[10px] font-bold uppercase bg-red-100 dark:bg-red-950 text-red-600 dark:text-red-400 px-2 py-0.5 rounded">Trending</span>
                {%- endif %}
              </div>
              <h3 class="text-xl font-bold hover:text-blue-600 transition"><a href="/{{ featured.slug }}/" style="color:var(--color-text);text-decoration:none">{{ featured.title }}</a></h3>
              <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 line-clamp-3">{{ featured.description or '' }}</p>
            </div>
            <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-slate-800">
              <span class="text-xs font-medium text-slate-400">Refined by 6-dim framework</span>
              <button onclick="toggleSaveToLibrary('{{ featured.slug }}', this)" class="p-2 text-slate-400 hover:text-amber-500 transition-colors" title="Save to library">
                <span class="star-icon text-lg">☆</span>
              </button>
            </div>
          </div>
        </div>
      {%- endif %}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {%- for card in recent_posts[1:6] %}
        {%- set picto = card | pictogram %}
        <div class="bg-white dark:bg-slate-950 rounded-xl border border-slate-200 dark:border-slate-800 p-5 flex flex-col justify-between shadow-sm hover:border-slate-400 dark:hover:border-slate-600 transition-all">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-extrabold uppercase tracking-wider text-blue-500 border-l-2 border-blue-500 pl-2" style="color:var(--color-{{ card.pillar or 'aml' }})">{{ pillar_config.get(card.pillar, {}).get('label', 'Research') }}</span>
              <div class="flex gap-1">
                {%- if card.slug in trending_slugs %}
                  <span class="text-[9px] font-bold bg-red-100 dark:bg-red-950 text-red-600 dark:text-red-400 px-1.5 py-0.5 rounded">Trending</span>
                {%- endif %}
              </div>
            </div>
            <h4 class="text-base font-bold hover:text-blue-600 transition"><a href="/{{ card.slug }}/" style="color:var(--color-text);text-decoration:none">{{ card.title }}</a></h4>
          </div>
          
          <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-100 dark:border-slate-900">
            <span class="text-xs text-slate-400">{{ card.body_html | reading_time }} min read</span>
            <button onclick="toggleSaveToLibrary('{{ card.slug }}', this)" class="p-1.5 text-slate-400 hover:text-amber-500 transition-colors">
              <span class="star-icon text-md">☆</span>
            </button>
          </div>
        </div>
      {%- endfor %}
      </div>
    </div>
  </div>
</section>

