{% extends "layout.j2" %}
{% from "macros/pillar_badge.html" import pillar_badge %}
{% from "macros/content_badge.html" import content_badge %}
{% block head_extra %}
  <script src="/static/js/animations.js?v={{ build_hash }}"></script>
  <script src="/static/js/learning_hub.js" defer></script>
  <style>
    /* Carousel Styles */
    .carousel-container {
      position: relative;
      width: 100%;
      overflow: hidden;
    }
    .carousel-track {
      display: flex;
      transition: transform 0.5s ease-in-out;
    }
    .carousel-slide {
      min-width: 100%;
      padding: 0.5rem;
    }
    .carousel-card {
      background: #f9fafb;
      border-radius: 12px;
      overflow: hidden;
      transition: transform 0.3s ease;
      cursor: pointer;
    }
    .carousel-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .carousel-card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }
    .carousel-card-content {
      padding: 1rem;
    }
    .carousel-card-title {
      font-weight: 600;
      font-size: 1.125rem;
      margin-bottom: 0.5rem;
      color: var(--color-text);
    }
    .carousel-card-meta {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }
    .carousel-card-pillar {
      font-weight: 600;
    }
    .carousel-indicators {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
      margin-top: 1rem;
    }
    .carousel-indicator {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #d1d5db;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .carousel-indicator.active {
      background: #14b8a6;
      transform: scale(1.2);
    }

    /* Motto Bar */
    .motto-bar {
      background: linear-gradient(135deg, #14b8a6 0%, #f59e0b 100%);
      color: white;
      padding: 0.75rem 0;
      text-align: center;
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    /* Consolidated Statistics Bar */
    .stats-bar {
      background: #1f2937;
      color: white;
      padding: 0.5rem 0;
      font-size: 0.875rem;
    }
    .stats-bar-inner {
      display: flex;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .stat-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .stat-value {
      font-weight: 700;
      color: #14b8a6;
    }
    .stat-label {
      color: #9ca3af;
    }

    /* Hero Dashboard */
    .hero-dashboard {
      position: relative;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 1.5rem;
      width: 100%;
      max-width: 380px;
    }
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .dashboard-stat {
      background: rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 1rem;
      text-align: center;
    }
    .dashboard-value {
      font-size: 1.75rem;
      font-weight: 700;
      background: linear-gradient(135deg, #ffffff 0%, #e0e0e0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .dashboard-label {
      font-size: 0.75rem;
      color: #a0a0a0;
      margin-top: 0.25rem;
    }
    .hero-gradient {
      background: linear-gradient(135deg, #0B1220 0%, #111827 50%, #1F2937 100%);
      position: relative;
      overflow: hidden;
    }
    .hero-gradient::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: radial-gradient(circle at 30% 70%, rgba(20, 184, 166, 0.15) 0%, transparent 50%),
                  radial-gradient(circle at 70% 30%, rgba(245, 158, 11, 0.1) 0%, transparent 50%);
      animation: gradient-shift 15s ease-in-out infinite;
    }
    @keyframes gradient-shift {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-30px, -30px); }
    }
    .research-card {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-radius: 16px;
      overflow: hidden;
    }
    .research-card:hover {
      transform: translateY(-6px) scale(1.01);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    }
    .learning-path-card {
      position: relative;
      background: linear-gradient(145deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      padding: 1.5rem;
      transition: all 0.3s ease;
    }
    .learning-path-card:hover {
      border-color: rgba(20, 184, 166, 0.3);
      box-shadow: 0 12px 30px rgba(20, 184, 166, 0.1);
    }
    .progress-bar {
      height: 6px;
      background: rgba(255,255,255,0.1);
      border-radius: 3px;
      overflow: hidden;
      margin-top: 0.75rem;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #14B8A6, #10B981);
      border-radius: 3px;
      transition: width 0.5s ease;
    }
    .learning-step {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem;
      background: rgba(255,255,255,0.03);
      border-radius: 8px;
      margin-bottom: 0.5rem;
    }
    .step-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      background: rgba(20, 184, 166, 0.1);
      color: #14B8A6;
    }
    .step-icon.completed {
      background: #10B981;
      color: white;
    }
    .step-icon.current {
      background: #14B8A6;
      color: #0B1220;
      animation: pulse-ring 2s ease-in-out infinite;
    }
    @keyframes pulse-ring {
      0%, 100% { box-shadow: 0 0 0 0 rgba(20, 184, 166, 0.4); }
      50% { box-shadow: 0 0 0 10px rgba(20, 184, 166, 0); }
    }
    .trust-metrics {
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .trust-metric {
      text-align: center;
    }
    .trust-value {
      font-size: 1.75rem;
      font-weight: 700;
      color: #14B8A6;
    }
    .trust-label {
      font-size: 0.875rem;
      color: #a0a0a0;
    }
    .sqi-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.25rem 0.75rem;
      background: rgba(20, 184, 166, 0.1);
      border: 1px solid rgba(20, 184, 166, 0.2);
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      color: #14B8A6;
    }
    .search-instant {
      min-height: 44px;
      transition: border-color 0.15s;
    }
    .search-instant:focus-within {
      border-color: #14B8A6;
      box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.1);
    }
    .search-results {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      background: #111827;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      z-index: 1000;
      max-height: 400px;
      overflow-y: auto;
      display: none;
    }
    .search-results.active {
      display: block;
      animation: slide-down 0.2s ease;
    }
    @keyframes slide-down {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .search-result-item {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      cursor: pointer;
      transition: background 0.15s;
    }
    .search-result-item:hover {
      background: rgba(255,255,255,0.05);
    }
    .search-result-title {
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 0.25rem;
    }
    .search-result-meta {
      font-size: 0.8125rem;
      color: #a0a0a0;
    }
    .search-result-sqi {
      font-size: 0.75rem;
      color: #14B8A6;
    }
  </style>
{% endblock %}

{% block main_content %}

<!-- Hero Section with CTA -->
<section class="hero-gradient py-16 px-6 rounded-2xl mb-12">
