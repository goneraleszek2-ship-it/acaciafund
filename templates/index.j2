        <span class="text-xs uppercase tracking-wider text-slate-300 font-semibold">Trusted Domains</span>
      </div>
      <div class="p-4 bg-white/5 rounded-lg border border-white/5 text-center">
        <span class="block text-3xl font-black text-blue-400">{{ stat_topic_count }}</span>
        <span class="text-xs uppercase tracking-wider text-slate-300 font-semibold">Unique Topics</span>
      </div>
      <div class="p-4 bg-white/5 rounded-lg border border-white/5 text-center">
        <span class="block text-3xl font-black text-purple-400">6-Dim</span>
        <span class="text-xs uppercase tracking-wider text-slate-300 font-semibold">Quality Framework</span>
      </div>
    </div>
  </div>
</section>

<!-- Mission & Vision (First 15-Second Message) -->
