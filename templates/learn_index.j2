{% extends "layout.j2" %}
{% block main_content %}
<section>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs" style="color:var(--color-text-muted)">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><a href="/" class="hover:text-[var(--color-accent)] transition">Home</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Learning Hub</li>
    </ol>
  </nav>

  <div class="mb-8">
    <h1 class="text-3xl font-extrabold" style="color:var(--color-text)">Learning Hub</h1>
    <p class="mt-2 text-sm" style="color:var(--color-text-muted)" id="progress-summary">{{ items | length }} lessons — structured learning across all pillars</p>
    <p class="mt-1 text-xs" style="color:var(--color-text-muted)" id="review-due"></p>
  </div>

  <div class="mb-10 p-4 rounded-lg" style="background:var(--color-surface);border:1px solid var(--color-border)" id="pillar-progress-section">
    <h2 class="text-sm font-semibold mb-3" style="color:var(--color-text)">Progress by Pillar</h2>
    <div class="space-y-3" id="pillar-progress-bars">
      {%- set pillar_icons = {"aml": "🛡️", "stock": "📈", "data-engineering": "⚙️"} %}
      {%- set pillar_names = {"aml": "AML", "stock": "Markets", "data-engineering": "Data Engineering"} %}
      {%- set pillar_bar_colors = {"aml": "#c97d3e", "stock": "#3a7d5c", "data-engineering": "#6366f1"} %}
      {%- for pkey, pinfo in pillar_config.items() %}
      {%- set pcount = items | selectattr("pillar", "equalto", pkey) | list | length %}
      {%- if pcount > 0 %}
      <div class="pillar-progress" data-pillar="{{ pkey }}">
        <div class="flex items-center justify-between text-xs mb-1">
          <span style="color:var(--color-text)">{{ pillar_icons.get(pkey, "") }} {{ pillar_names.get(pkey, pkey | capitalize) }}</span>
          <span class="pillar-count" style="color:var(--color-text-muted)">0/{{ pcount }}</span>
        </div>
        <div class="sqi-bar">
          <div class="sqi-bar-fill pillar-bar-fill" style="width:0%;background:{{ pillar_bar_colors.get(pkey, '#6366f1') }}"></div>
        </div>
      </div>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>

  {%- if grouped and grouped | length > 0 %}
    {%- for group_name, group_items in grouped.items() %}
    <div class="mb-12 scroll-mt-20" id="{{ group_name | lower | replace(' ', '-') }}">
      <div class="flex items-center justify-between mb-1">
        <h2 class="text-2xl font-bold" style="color:var(--color-text)">{{ group_name }}</h2>
        <span class="text-xs group-progress" data-group="{{ group_name | lower }}" style="color:var(--color-text-muted)">0/{{ group_items | length }}</span>
      </div>
      <p class="text-sm mb-4" style="color:var(--color-text-muted)">
        {%- set group_descriptions = {
          "Beginner": "Foundational concepts — no prior knowledge required.",
          "Intermediate": "Deeper dives for those with basic familiarity.",
          "Advanced": "Complex topics for experienced learners.",
        } %}
        {{ group_descriptions.get(group_name, "") }}
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {%- for item in group_items %}
        {%- set p = item.pillar or "" %}
        {%- set pc = pillar_config.get(p, none) %}
        {%- set tkey = thumbnail_key(item.title) %}
        {%- set d_emoji = {"beginner": "🌱", "intermediate": "📘", "advanced": "🔥"} %}
        <a href="/{{ item.slug }}/" class="learn-card block rounded-lg overflow-hidden transition hover:shadow-md" data-learn-slug="/{{ item.slug }}/" style="background:var(--color-surface);border:1px solid var(--color-border);text-decoration:none">
          <div class="aspect-[600/340] overflow-hidden" style="background:var(--color-bg)">
            <img src="{{ thumbnail_base }}/thumb_{{ tkey }}.svg" alt="" class="w-full h-full object-cover" loading="lazy">
          </div>
          <div class="p-4">
            <div class="flex items-center gap-2 mb-2">
              {%- if pc %}
              <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded {{ pc.badge_color }}">
                {{ pc.emoji }} {{ pc.label }}
              </span>
              {%- endif %}
              {%- if item.difficulty %}
              <span class="text-xs" style="color:var(--color-text-muted)">{{ d_emoji.get(item.difficulty, "📘") }} {{ item.difficulty | capitalize }}</span>
              {%- endif %}
              <span class="ml-auto text-xs lesson-status" data-slug="/{{ item.slug }}/" style="color:var(--color-text-muted)">⬜</span>
            </div>
            <h3 class="font-semibold" style="color:var(--color-text)">{{ item.title | striptags }}</h3>
            {%- if item.description %}
            <p class="mt-1 text-xs" style="color:var(--color-text-secondary)">{{ item.description[:200] }}</p>
            {%- endif %}
            <div class="mt-3 flex items-center gap-3 text-xs" style="color:var(--color-text-muted)">
              {%- if item.date_str %}
              <time datetime="{{ item.date_str }}">{{ item.date_str }}</time>
              {%- endif %}
              {%- if item.body_html %}
              <span>{{ item.body_html | reading_time }} min</span>
              {%- endif %}
            </div>
          </div>
        </a>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  {%- endif %}
</section>

<script>
(function(){
  var PROGRESS_KEY = 'acacia_progress_v1';
  var REVIEW_KEY = 'acacia_reviews_v1';
  function loadProgress(){
    try{ return JSON.parse(localStorage.getItem(PROGRESS_KEY) || '{}'); }catch(e){return {};}
  }
  function loadReviews(){
    try{ return JSON.parse(localStorage.getItem(REVIEW_KEY) || '{}'); }catch(e){return {};}
  }
  var p = loadProgress();
  var r = loadReviews();

  function progressKey(dataSlug) {
    return dataSlug.replace(/^\//, '').replace(/\/$/, '') + '/index.html';
  }

  // Lesson completion status
  document.querySelectorAll('.lesson-status').forEach(function(el){
    var slug = progressKey(el.getAttribute('data-slug'));
    if(p[slug] && p[slug].done){
      el.textContent = '✅';
      el.style.color = '#22c55e';
    }
  });

  // Due-for-review badge
  var reviewDue = document.getElementById('review-due');
  if (reviewDue) {
    var now = Date.now();
    var DAY_MS = 86400000;
    var dueCount = 0;
    document.querySelectorAll('.lesson-status').forEach(function(el){
      var dSlug = el.getAttribute('data-slug');
      var slug = progressKey(dSlug);
      if (r[dSlug] && p[slug] && p[slug].done) {
        var elapsed = now - (r[dSlug].lastReview || 0);
        if (elapsed > DAY_MS) dueCount++;
      }
    });
    if (dueCount > 0) {
      reviewDue.innerHTML = '🔄 <strong>' + dueCount + '</strong> lesson' + (dueCount > 1 ? 's' : '') + ' due for review (last studied >24h ago)';
    } else {
      reviewDue.textContent = '✅ All reviewed recently';
    }
  }

  // Group progress
  document.querySelectorAll('.group-progress').forEach(function(el){
    var cards = el.closest('.mb-12').querySelectorAll('.lesson-status');
    var done = 0;
    cards.forEach(function(s){
      var slug = progressKey(s.getAttribute('data-slug'));
      if(p[slug] && p[slug].done) done++;
    });
    el.textContent = done + '/' + cards.length;
    if(done === cards.length && cards.length > 0){
      el.style.color = '#22c55e';
    }
  });

  // Pillar progress bars
  document.querySelectorAll('.pillar-progress').forEach(function(pp){
    var pillar = pp.getAttribute('data-pillar');
    var totalInPillar = 0;
    var doneInPillar = 0;
    document.querySelectorAll('.lesson-status').forEach(function(el){
      var card = el.closest('.learn-card');
      if (card) {
        var pillarEl = card.querySelector('[class*="inline-flex"]');
        if (pillarEl && pillarEl.textContent.indexOf(pillar) > -1) {
          totalInPillar++;
          var slug = progressKey(el.getAttribute('data-slug'));
          if(p[slug] && p[slug].done) doneInPillar++;
        }
      }
    });
    var countEl = pp.querySelector('.pillar-count');
    if (countEl) countEl.textContent = doneInPillar + '/' + totalInPillar;
    var barEl = pp.querySelector('.pillar-bar-fill');
    if (barEl && totalInPillar > 0) {
      barEl.style.width = Math.round(doneInPillar / totalInPillar * 100) + '%';
    }
  });

  // Overall summary
  var total = document.querySelectorAll('.lesson-status').length;
  var completed = 0;
  document.querySelectorAll('.lesson-status').forEach(function(el){
    var slug = progressKey(el.getAttribute('data-slug'));
    if(p[slug] && p[slug].done) completed++;
  });
  var summary = document.getElementById('progress-summary');
  if(summary && total > 0){
    summary.textContent = completed + '/' + total + ' completed — ' + (total - completed) + ' remaining';
  }
})();
</script>
{% endblock %}