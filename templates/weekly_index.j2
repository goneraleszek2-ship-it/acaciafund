{% extends "layout.j2" %}
{% block title %}Weekly Notes Archive | AcaciaFund{% endblock %}
{% block description %}Browse our weekly Feynman-style notes archive — simple explanations of the most important developments across AML/compliance, stock markets, and data engineering.{% endblock %}

{% block head %}
{{ super() }}
{% endblock %}

{% block main_content %}
{% set pillar_keys = {"aml": "Compliance", "markets": "Markets", "data-engineering": "Data Engineering"} %}
{% set pillar_colors = {"aml": "#f97316", "markets": "#34d399", "data-engineering": "#818cf8"} %}

<div class="archive-header">
    <h1>📅 Weekly Notes Archive</h1>
    <p>Feynman-style weekly briefings across all three pillars. Each event is explained with a simple analogy, a plain-English explanation, and why it matters.</p>
</div>

<div class="all-pillar-grid">
    {% for p_id, p_name in pillar_keys.items() %}
    {% set color = pillar_colors[p_id] %}
    <div class="pillar-section">
        <h2>
            <span class="pillar-indicator" style="background:{{ color }}"></span>
            {{ p_name }}
        </h2>
        {% set weeks = weeks_by_pillar.get(p_id, []) %}
        {% if weeks %}
        <div class="week-grid">
            {% for w in weeks %}
            <a href="/{{ pillar_urls[p_id] }}/weekly/{{ w.week_id }}/" class="week-card" style="border-left:3px solid {{ color }}">
                {% if loop.index <= 2 %}
                <span class="latest-badge">Latest</span>
                {% endif %}
                <div class="vibe">{{ w.vibe }}</div>
                <div class="week-id">{{ w.week_id }}</div>
                <div class="date-range">{{ w.date_range }}</div>
                <div class="event-count">{{ w.events_count }} event{% if w.events_count != 1 %}s{% endif %}</div>
                {% if w.tagline %}
                <div class="event-preview">{{ w.tagline }}</div>
                {% endif %}
            </a>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            <p>No weekly notes yet for {{ p_name }}.</p>
            <div class="empty-state-actions">
                <a href="/{{ pillar_urls[p_id] }}/" class="btn btn-ghost btn-sm">Browse {{ p_name }}</a>
                <a href="/search/?f_pillar={{ pillar_urls[p_id] }}" class="btn btn-ghost btn-sm">Search {{ p_name }}</a>
            </div>
        </div>
        {% endif %}
    </div>
    {% endfor %}
</div>
{% endblock %}
