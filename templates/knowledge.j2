{% extends "layout.j2" %}
{% include "macros/pillar_badge.html" %}
{% from "macros/breadcrumbs.html" import breadcrumbs %}
{% block main_content %}
{{ breadcrumbs(page_path, content.title) }}
<div id="reading-progress" style="position:fixed;top:0;left:0;height:3px;z-index:9999;width:0%;background:var(--color-accent)"></div>

<div class="flex gap-8 {% if toc_items %}md:flex-row{% endif %} flex-col">
  {%- if toc_items %}
  <aside class="toc-sidebar shrink-0 order-last md:order-first md:sticky md:top-20 md:self-start md:max-h-[calc(100vh-6rem)] md:overflow-y-auto md:w-52">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-text-muted)">On this page</h2>
      <button id="focus-toggle" class="text-xs px-2 py-1 rounded" style="color:var(--color-text-muted);background:var(--color-bg)" title="Focus mode" aria-label="Toggle focus mode">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4h4M6 20h4M18 4h-4M18 20h-4M4 6v4M4 18v4M20 6v4M20 18v4"/></svg>
      </button>
    </div>
    <nav aria-label="Table of contents">
      <ul class="space-y-1 text-sm">
        {%- for item in toc_items %}
        <li>
          <a href="#{{ item.id }}" class="toc-link block py-1 {% if item.tag == 'h3' %}pl-4 text-xs{% endif %} rounded px-2 transition" style="color:var(--color-text-muted)">
            {{ item.text }}
          </a>
        </li>
        {%- endfor %}
      </ul>
    </nav>
  </aside>
  {%- endif %}

  <article class="min-w-0 flex-1">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs" style="color:var(--color-text-muted)">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-accent)] transition">Home</a></li>
        <li aria-hidden="true">/</li>
        {%- set pillar_key = content.pillar or "aml" %}
        {%- set pc = pillar_config.get(pillar_key, pillar_config["aml"]) %}
        <li><a href="/{{ pc.url }}/" class="hover:text-[var(--color-accent)] transition">{{ pc.label }}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="truncate max-w-[200px]">{{ content.title | striptags }}</li>
      </ol>
    </nav>
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        {{ layer_badge | default("") | safe }}
        {% set pillar = content.pillar %}
        {% include "macros/pillar_badge.html" %}
        {%- if topic_icon_html %}
        <span class="article-topic-icon">{{ topic_icon_html | safe }}</span>
        {%- endif %}
        {%- if kcat %}
        <span class="text-xs px-2 py-0.5 rounded" style="background:var(--color-bg);color:var(--color-text-secondary);border:1px solid var(--color-border)">{{ kcat | capitalize }}</span>
        {%- endif %}
      </div>
      <div class="flex items-center gap-2 mt-1">
        {{ visual_fingerprint | default("") | safe }}
        <h1 class="text-3xl font-extrabold leading-tight">{{ content.title | striptags }}</h1>
      </div>
      {%- if content.date_str %}
      <div class="mt-2 flex items-center gap-2 text-sm" style="color:var(--color-text-muted)">
        <time datetime="{{ content.date_str }}">{{ content.date_str }}</time>
        <span aria-hidden="true">·</span>
        <span>By {{ content.author | default("Leszek") }}</span>
        {%- if content.reading_time %} · {{ content.reading_time }} min read{% endif %}
      </div>
      {%- endif %}
      {%- if content.tags and content.tags | length > 0 %}
      <div style="display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: var(--pico-spacing);">
        {%- for tag in content.tags %}
        {%- set tag_slug = tag | lower | replace(' ', '-') | replace('_', '-') %}
        <a href="/tags/{{ tag_slug }}/"><kbd>{{ tag }}</kbd></a>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if ontology_concepts and ontology_concepts | length > 0 %}
      <div class="mt-3 flex flex-wrap gap-1.5">
        {%- for concept in ontology_concepts %}
        <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full" style="background:color-mix(in srgb, var(--color-accent) 12%, transparent);color:var(--color-accent);border:1px solid color-mix(in srgb, var(--color-accent) 25%, transparent)">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
          {{ concept.name }}
        </span>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- set sqi_val = content.sqi or 0 %}
      {%- if content.signals and content.signals.avg_sqi %}
        {%- set sqi_val = [sqi_val, content.signals.avg_sqi] | max %}
      {%- endif %}
      {%- if sqi_val > 0 %}
      <div class="mt-2">
        <span class="sqi-badge">SQI {{ "%.3f" | format(sqi_val) }}</span>
      </div>
      {%- endif %}
    </header>

    <div class="prose prose-lg prose-blue max-w-none">
      {{ page_body | default(content.body_html) | safe }}
    </div>

    {%- if content.bloom_questions and content.bloom_questions | length > 0 %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold mb-4">Bloom Taxonomy Questions</h2>
      <div class="space-y-4">
        {%- for q in content.bloom_questions %}
        <div class="ghost-card p-4">
          <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded" style="
            {%- if q.level == "remember" %} background:color-mix(in srgb, #3b82f6 15%, transparent);color:#3b82f6
            {%- elif q.level == "understand" %} background:color-mix(in srgb, #22c55e 15%, transparent);color:#22c55e
            {%- elif q.level == "apply" %} background:color-mix(in srgb, #f59e0b 15%, transparent);color:#f59e0b
            {%- elif q.level == "analyze" %} background:color-mix(in srgb, #a855f7 15%, transparent);color:#a855f7
            {%- elif q.level == "evaluate" %} background:color-mix(in srgb, #ef4444 15%, transparent);color:#ef4444
            {%- elif q.level == "create" %} background:color-mix(in srgb, #6366f1 15%, transparent);color:#6366f1
            {%- else %} background:var(--color-bg);color:var(--color-text-secondary){% endif %}">
            {{ q.level | capitalize }}
          </span>
          <p class="mt-2">{{ q.question }}</p>
        </div>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if source_synthesis and source_synthesis | length > 0 %}
    <section class="mt-12 pt-8 border-t" style="border-color:var(--color-border)">
      <h2 class="text-2xl font-bold mb-4 inline-flex items-center gap-2" style="color:var(--color-text)">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Source Synthesis
      </h2>
      <div class="space-y-3">
        {%- for syn in source_synthesis | sort(attribute='synthesis_score') | reverse %}
        <div class="synthesis-card p-4 rounded-lg transition hover:shadow-md" style="background:var(--color-surface);border:1px solid var(--color-border)">
          <div class="flex items-start gap-3">
            <div class="flex-1">
              <h3 class="text-sm font-semibold" style="color:var(--color-text)">
                <a href="{{ syn.get('source_url', '#') }}" target="_blank" rel="noopener" class="hover:text-[var(--color-accent)] transition">{{ syn.get('source_title', 'Source') }}</a>
              </h3>
              <p class="mt-1 text-xs" style="color:var(--color-text-secondary)">{{ syn.get('synthesis_text', '') }}</p>
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if external_references and external_references | length > 0 %}
    <section class="mt-12 pt-8 border-t" style="border-color:var(--color-border)">
      <h2 class="text-2xl font-bold mb-4 inline-flex items-center gap-2" style="color:var(--color-text)">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        Further Reading
      </h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {%- for ref in external_references %}
        <a href="{{ ref.url }}" target="_blank" rel="noopener" class="ghost-card p-4 block transition hover:shadow-md" style="text-decoration:none">
          <div class="flex items-start gap-3">
            <div class="shrink-0 mt-0.5">
              <span class="inline-block text-xs px-2 py-0.5 rounded" style="background:color-mix(in srgb, var(--color-accent) 10%, transparent);color:var(--color-accent)">
                {{ ref.source | default("External") }}
              </span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-semibold truncate" style="color:var(--color-text)">{{ ref.title }}</h3>
              {%- if ref.description %}
              <p class="mt-1 text-xs line-clamp-2" style="color:var(--color-text-secondary)">{{ ref.description }}</p>
              {%- endif %}
            </div>
          </div>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if ontology_concepts and ontology_concepts | length > 1 %}
    <section class="mt-12 pt-8 border-t" style="border-color:var(--color-border)">
      <h2 class="text-2xl font-bold mb-4 inline-flex items-center gap-2" style="color:var(--color-text)">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
        Concept Explorer
      </h2>
      <p class="text-sm mb-4" style="color:var(--color-text-secondary)">Related ontology concepts with definitions and source links.</p>
      <div class="grid gap-3 sm:grid-cols-2">
        {%- for concept in ontology_concepts %}
        <div class="ghost-card p-4 transition hover:shadow-md">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono px-1.5 py-0.5 rounded" style="background:color-mix(in srgb, var(--color-accent) 10%, transparent);color:var(--color-accent)">{{ concept.id }}</span>
            <span class="text-xs" style="color:var(--color-text-muted)">score: {{ concept.score }}</span>
          </div>
          <h3 class="text-sm font-semibold" style="color:var(--color-text)">{{ concept.name }}</h3>
          {%- if concept.description %}
          <p class="mt-1 text-xs" style="color:var(--color-text-secondary)">{{ concept.description }}</p>
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if related_research %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold mb-6">Related Research</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {%- for rp in related_research %}
        {%- set rpillar = rp.pillar or "aml" %}
        {%- set rpc = pillar_config.get(rpillar, pillar_config["aml"]) %}
        <a href="{{ slug_to_url(rp.slug) }}" class="ghost-card block text-decoration:none">
          <div class="p-3">
            {% set pillar = rp.pillar %}
            {% include "macros/pillar_badge.html" %}
            <span class="block mt-2 text-sm font-semibold" style="color:var(--color-text)">{{ rp.title | striptags }}</span>
          </div>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if related_learn %}
    <section class="mt-12 pt-8 border-t">
      <h2 class="text-2xl font-bold mb-6">Related Lessons</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {%- for rl in related_learn %}
        {%- set rpillar = rl.pillar or "aml" %}
        {%- set rpc = pillar_config.get(rpillar, pillar_config["aml"]) %}
        <a href="{{ slug_to_url(rl.slug) }}" class="ghost-card block text-decoration:none">
          <div class="p-3">
            {% set pillar = rl.pillar %}
            {% include "macros/pillar_badge.html" %}
            <span class="block mt-2 text-sm font-semibold" style="color:var(--color-text)">{{ rl.title | striptags }}</span>
          </div>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}
  </article>
</div>

<script src="{{ 'js/learning_hub.js' | asset }}" defer></script>
{% include 'partials/newsletter.html' %}
{% endblock %}