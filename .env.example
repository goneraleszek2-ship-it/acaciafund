# Local development environment template.
# Copy to `.env` and fill in your own values. Never commit real secrets.
# Name: AcaciaFund

# Admin CMS credentials — required at build time when admin pages embed them.
# deploy.yml passes these from GitHub Secrets. Use a strong, unique password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Unsplash API keys — optional. Only used by scripts/fetch_images.py for
# Unsplash image backfill; the pipeline falls back to other backends when
# unset. Generate keys at https://unsplash.com/developers.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APPLICATION_ID=