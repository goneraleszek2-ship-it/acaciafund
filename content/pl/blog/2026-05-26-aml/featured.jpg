<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 420" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">
  <!--
    CYCLE = 7s.
    Timeline (left panel):
      0.0  point A appears
      0.6  point B appears
      1.2  line draws (1.2s)
      2.4  hold
      6.5  fade everything out
      7.0  loop
    Timeline (right panel):
      0.0  the point appears
      0.8..2.0  six dashed candidate lines pop in, 0.2s apart
      2.0  hold
      6.5  fade everything out
      7.0  loop

    Pattern: for each element, animate opacity with values="0;1;1;0" and
    keyTimes that map to its appearance window. repeatCount="indefinite".
  -->
  <defs>
    <style>
      .bg { fill: #0e0e10; }
      .panel-title { fill: #f5f5f5; font-size: 16px; font-weight: 700; }
      .axis { stroke: #3a3a3a; stroke-width: 1; }
      .grid { stroke: #1f1f22; stroke-width: 1; }
      .tick { fill: #7a7a7a; font-size: 11px; }
      .line { stroke: #2ee85c; stroke-width: 3; fill: none; }
      .dash { stroke: #2ee85c; stroke-width: 1.5; fill: none; stroke-dasharray: 5 4; }
      .pt { fill: #ffffff; stroke: #ffffff; }
      .label { fill: #ffffff; font-size: 12px; font-weight: 600; }
    </style>
  </defs>
  <rect class="bg" width="800" height="420" rx="10"/>

  <!-- ============== LEFT PANEL ============== -->
  <!-- Coord system: axis (y=0) at py=330; y=10 at py=80; so 25px per unit, plot top at py=80.
       x=-1 at px=60; x=0 at px=103; 43px per unit. -->
  <g transform="translate(20,20)">
    <text class="panel-title" x="180" y="20" text-anchor="middle">2 points  →  ONE line</text>
    <g>
      <line class="grid" x1="60"  y1="80"  x2="360" y2="80"/>
      <line class="grid" x1="60"  y1="130" x2="360" y2="130"/>
      <line class="grid" x1="60"  y1="180" x2="360" y2="180"/>
      <line class="grid" x1="60"  y1="230" x2="360" y2="230"/>
      <line class="grid" x1="60"  y1="280" x2="360" y2="280"/>
      <line class="grid" x1="60"  y1="330" x2="360" y2="330"/>
      <line class="grid" x1="60"  y1="80" x2="60"  y2="330"/>
      <line class="grid" x1="103" y1="80" x2="103" y2="330"/>
      <line class="grid" x1="146" y1="80" x2="146" y2="330"/>
      <line class="grid" x1="189" y1="80" x2="189" y2="330"/>
      <line class="grid" x1="232" y1="80" x2="232" y2="330"/>
      <line class="grid" x1="275" y1="80" x2="275" y2="330"/>
      <line class="grid" x1="318" y1="80" x2="318" y2="330"/>
    </g>
    <line class="axis" x1="60"  y1="330" x2="360" y2="330"/>
    <line class="axis" x1="103" y1="80"  x2="103" y2="330"/>
    <text class="tick" x="55" y="334" text-anchor="end">0</text>
    <text class="tick" x="55" y="284" text-anchor="end">2</text>
    <text class="tick" x="55" y="234" text-anchor="end">4</text>
    <text class="tick" x="55" y="184" text-anchor="end">6</text>
    <text class="tick" x="55" y="134" text-anchor="end">8</text>
    <text class="tick" x="55" y="84"  text-anchor="end">10</text>
    <text class="tick" x="60"  y="348" text-anchor="middle">-1</text>
    <text class="tick" x="103" y="348" text-anchor="middle">0</text>
    <text class="tick" x="146" y="348" text-anchor="middle">1</text>
    <text class="tick" x="189" y="348" text-anchor="middle">2</text>
    <text class="tick" x="232" y="348" text-anchor="middle">3</text>
    <text class="tick" x="275" y="348" text-anchor="middle">4</text>
    <text class="tick" x="318" y="348" text-anchor="middle">5</text>

    <!-- Point A (1,3): appears at t=0.0, visible through t=6.5, fades out by t=7 -->
    <circle class="pt" cx="146" cy="255" r="5" opacity="0">
      <animate attributeName="opacity"
               values="0;1;1;0;0"
               keyTimes="0;0.05;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </circle>
    <text class="label" x="155" y="272" opacity="0">(1, 3)
      <animate attributeName="opacity"
               values="0;1;1;0;0"
               keyTimes="0;0.07;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </text>

    <!-- Point B (4,9): appears at t=0.6 (=0.086 of 7s) -->
    <circle class="pt" cx="275" cy="105" r="5" opacity="0">
      <animate attributeName="opacity"
               values="0;0;1;1;0;0"
               keyTimes="0;0.086;0.13;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </circle>
    <text class="label" x="225" y="100" text-anchor="end" opacity="0">(4, 9)
      <animate attributeName="opacity"
               values="0;0;1;1;0;0"
               keyTimes="0;0.10;0.14;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </text>

    <!-- The line: draws from (81.5, 330) to (296.5, 80), length ~330
         Starts drawing at t=1.2 (=0.171), draw duration 1.2s (=0.171 of 7s) so ends at t=2.4 (=0.342) -->
    <line class="line" x1="81.5" y1="330" x2="296.5" y2="80"
          stroke-dasharray="330" stroke-dashoffset="330" opacity="0">
      <animate attributeName="opacity"
               values="0;0;1;1;0;0"
               keyTimes="0;0.171;0.18;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
      <animate attributeName="stroke-dashoffset"
               values="330;330;0;0;330"
               keyTimes="0;0.171;0.342;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </line>
  </g>

  <!-- ============== RIGHT PANEL ============== -->
  <g transform="translate(420,20)">
    <text class="panel-title" x="180" y="20" text-anchor="middle">1 point  →  ∞ lines</text>
    <g>
      <line class="grid" x1="60"  y1="80"  x2="360" y2="80"/>
      <line class="grid" x1="60"  y1="130" x2="360" y2="130"/>
      <line class="grid" x1="60"  y1="180" x2="360" y2="180"/>
      <line class="grid" x1="60"  y1="230" x2="360" y2="230"/>
      <line class="grid" x1="60"  y1="280" x2="360" y2="280"/>
      <line class="grid" x1="60"  y1="330" x2="360" y2="330"/>
      <line class="grid" x1="60"  y1="80" x2="60"  y2="330"/>
      <line class="grid" x1="103" y1="80" x2="103" y2="330"/>
      <line class="grid" x1="146" y1="80" x2="146" y2="330"/>
      <line class="grid" x1="189" y1="80" x2="189" y2="330"/>
      <line class="grid" x1="232" y1="80" x2="232" y2="330"/>
      <line class="grid" x1="275" y1="80" x2="275" y2="330"/>
      <line class="grid" x1="318" y1="80" x2="318" y2="330"/>
    </g>
    <line class="axis" x1="60"  y1="330" x2="360" y2="330"/>
    <line class="axis" x1="103" y1="80"  x2="103" y2="330"/>
    <text class="tick" x="55" y="334" text-anchor="end">0</text>
    <text class="tick" x="55" y="284" text-anchor="end">2</text>
    <text class="tick" x="55" y="234" text-anchor="end">4</text>
    <text class="tick" x="55" y="184" text-anchor="end">6</text>
    <text class="tick" x="55" y="134" text-anchor="end">8</text>
    <text class="tick" x="55" y="84"  text-anchor="end">10</text>
    <text class="tick" x="60"  y="348" text-anchor="middle">-1</text>
    <text class="tick" x="103" y="348" text-anchor="middle">0</text>
    <text class="tick" x="146" y="348" text-anchor="middle">1</text>
    <text class="tick" x="189" y="348" text-anchor="middle">2</text>
    <text class="tick" x="232" y="348" text-anchor="middle">3</text>
    <text class="tick" x="275" y="348" text-anchor="middle">4</text>
    <text class="tick" x="318" y="348" text-anchor="middle">5</text>

    <!-- The point (3,5) - appears at t=0.0 -->
    <circle class="pt" cx="232" cy="205" r="5" opacity="0">
      <animate attributeName="opacity"
               values="0;1;1;0;0"
               keyTimes="0;0.05;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </circle>
    <text class="label" x="240" y="200" opacity="0">(3, 5)
      <animate attributeName="opacity"
               values="0;1;1;0;0"
               keyTimes="0;0.07;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </text>

    <!-- Six dashed candidate lines fan in. Each one appears 0.25s after the previous,
         starting at t=1.2s (=0.171 of 7s). Step = 0.25s = 0.036.
         Line N visible from t = 1.2 + N*0.25
         Convert: t/7
           N=0: 1.20 -> 0.171
           N=1: 1.45 -> 0.207
           N=2: 1.70 -> 0.243
           N=3: 1.95 -> 0.279
           N=4: 2.20 -> 0.314
           N=5: 2.45 -> 0.350
    -->
    <line class="dash" x1="60"  y1="319.67" x2="360" y2="119.67" opacity="0">
      <animate attributeName="opacity"
               values="0;0;0.85;0.85;0;0"
               keyTimes="0;0.171;0.20;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </line>
    <line class="dash" x1="60"  y1="205" x2="360" y2="205" opacity="0">
      <animate attributeName="opacity"
               values="0;0;0.85;0.85;0;0"
               keyTimes="0;0.207;0.235;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </line>
    <line class="dash" x1="60"  y1="61.7"  x2="360" y2="311.7" opacity="0">
      <animate attributeName="opacity"
               values="0;0;0.85;0.85;0;0"
               keyTimes="0;0.243;0.27;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </line>
    <line class="dash" x1="60"  y1="276.7" x2="360" y2="151.7" opacity="0">
      <animate attributeName="opacity"
               values="0;0;0.85;0.85;0;0"
               keyTimes="0;0.279;0.31;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </line>
    <line class="dash" x1="60"  y1="130.5" x2="360" y2="260.5" opacity="0">
      <animate attributeName="opacity"
               values="0;0;0.85;0.85;0;0"
               keyTimes="0;0.314;0.345;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </line>
    <line class="dash" x1="60"  y1="44.5"  x2="360" y2="324.5" opacity="0">
      <animate attributeName="opacity"
               values="0;0;0.85;0.85;0;0"
               keyTimes="0;0.350;0.38;0.93;0.97;1"
               dur="7s" repeatCount="indefinite"/>
    </line>
  </g>
</svg>
