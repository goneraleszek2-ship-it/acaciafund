<script>
  // Badge definitions
  const BADGES = [
    {
      id: 'lesson-complete',
      title: 'Lesson Completed',
      description: 'Finished a lesson',
      icon: '📖',
      criteria: (log) => {
        const lessonSlugs = new Set();
        log.forEach(entry => {
          if (entry.type === 'impression' && entry.lessonSlug) {
            lessonSlugs.add(entry.lessonSlug);
          }
        });
        return lessonSlugs.size >= 1;
      }
    },
    {
      id: 'quiz-streak-3',
      title: 'Quiz Streak',
      description: 'Get 3 quiz questions correct in a row',
      icon: '🔥',
      criteria: (log) => {
        // Find longest streak of correct answers in the log
        let streak = 0;
        let maxStreak = 0;
        // We need to look at attempts in chronological order
        const attempts = log.filter(e => e.type === 'attempt').sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp));
        attempts.forEach(a => {
          if (a.correct) {
            streak++;
            maxStreak = Math.max(maxStreak, streak);
          } else {
            streak = 0;
          }
        });
        return maxStreak >= 3;
      }
    },
    {
      id: 'bayes-expert',
      title: 'Bayes Expert',
      description: 'Score perfect on the Bayesian Thinking lesson quiz',
      icon: '🧠',
      criteria: (log) => {
        // Check if user got all questions correct in lesson-02-bayes
        const bayesAttempts = log.filter(e => 
          e.type === 'attempt' && 
          e.lessonSlug === 'lesson-02-bayes'
        );
        if (bayesAttempts.length === 0) return false;
        // Group by attempt session? Simpler: if any attempt exists and all are correct for that lesson
        // Since we don't have session ID, we'll check if there's at least one attempt and no incorrect ones for this lesson
        const hasIncorrect = bayesAttempts.some(a => !a.correct);
        return bayesAttempts.length > 0 && !hasIncorrect;
      }
    },
    {
      id: 'spaced-rep-master',
      title: 'Spaced Rep Master',
      description: 'Complete 5 spaced repetition reviews',
      icon: '⚡',
      criteria: (log) => {
        // Count how many times an item was reviewed due to spacing (simplified: count attempts after first)
        // For now, just count total attempts as a proxy
        const attempts = log.filter(e => e.type === 'attempt');
        return attempts.length >= 5;
      }
    }
  ];

  function getQuizLog() {
    try {
      return JSON.parse(localStorage.getItem('acfQuizLog') || '[]');
    } catch {
      return [];
    }
  }

  function earnBadge(badge, log) {
    // Check if already earned
    const earned = JSON.parse(localStorage.getItem('acfBadges') || '[]');
    if (earned.includes(badge.id)) return false;
    if (badge.criteria(log)) {
      earned.push(badge.id);
      localStorage.setItem('acfBadges', JSON.stringify(earned));
      return true;
    }
    return false;
  }

  function getEarnedBadges() {
    try {
      const earnedIds = JSON.parse(localStorage.getItem('acfBadges') || '[]');
      return BADGES.filter(b => earnedIds.includes(b.id));
    } catch {
      return [];
    }
  }

  // Earn any newly eligible badges on load
  (() => {
    const log = getQuizLog();
    BADGES.forEach(badge => earnBadge(badge, log));
  })();
</script>

<div class="badge-bar" aria-label="Earned badges">
