---
import { estimateReadingTime, generateTagBadgeSVG, generateSimpleSparkline } from '../lib/content.js';
const { post } = Astro.props;
// Determine badge color based on category
const categoryColors = {
  aml: '--accent-2', // blue
  stock: '--accent', // amber/gold
  science: '#9333ea', // violet (not in CSS vars, using direct)
};
const badgeColor = categoryColors[post.category.toLowerCase()] || '--muted';
// Estimate reading time from summary or full content? We'll use summary for card.
const readingTime = estimateReadingTime(post.summary);
// Build thumbnail URL: if post.thumbnail exists, use /blog/{lang}/{slug}/{thumbnail}
const thumbnailUrl = post.thumbnail
  ? `/blog/${post.lang}/${post.slug}/${post.thumbnail}`
  : '';
// Fallback placeholder SVG (simple colored circle) if no thumbnail
const placeholderSvg = `
  <svg width="120" height="120" xmlns="http://www.w3.org/2000/svg">
    <circle cx="60" cy="60" r="50" fill="var(--bg-elev)" stroke="var(--card-border)" stroke-width="2"/>
    <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="var(--muted)" font-size="10">${post.category.toUpperCase()}</text>
  </svg>
`;
const placeholderUrl = `data:image/svg+xml;base64,${btoa(placeholderSvg)}`;
// Optional: generate a simple sparkline from dummy data (e.g., based on post length or arbitrary metric)
// For demonstration, we'll use the length of summary as a pseudo-metric.
const dummyData = [post.summary.length, post.summary.length * 0.8, post.summary.length * 1.2, post.summary.length * 0.9, post.summary.length];
const sparklineSvg = generateSimpleSparkline(dummyData);
// Use first tag for badge, or fallback to category
const tagForBadge = post.tags[0] || post.category;
const tagBadgeSvg = generateTagBadgeSVG(tagForBadge);
---
<article class="card pillar-card">
  {post.thumbnail ? (
    <img src={thumbnailUrl} alt={post.title} loading="lazy" onError={(e) => { e.target.src = placeholderUrl; }} />
  ) : (
    <img src={placeholderUrl} alt={post.title} loading="lazy" />
  )}
  <div style="margin-top: 14px;">
    <div class="meta" style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
      <span>{post.date}</span>
      <span class="badge" style="background: var(--badge-color); color: var(--text);">
        {post.category}
      </span>
      <span class="reading-time">~{readingTime} min czytania</span>
      {tagBadgeSvg && <span dangerouslySetInnerHTML={{ __html: tagBadgeSvg }} />}
      {sparklineSvg && <span dangerouslySetInnerHTML={{ __html: sparklineSvg }} style={{ display: 'inline-block', marginLeft: '8px' }} />}
    </div>
    <h3><a href={`/${post.lang}/blog/${post.slug}/`}>{post.title}</a></h3>
    <p class="muted">{post.summary}</p>
    <a class="button" href={`/${post.lang}/blog/${post.slug}/`}>Read synthesis</a>
  </div>
</article>
