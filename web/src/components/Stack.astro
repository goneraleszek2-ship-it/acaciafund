---
export interface Props {
  spacing?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl';
  direction?: 'vertical' | 'horizontal';
  children: any;
  class?: string;
}
const {
  spacing = 'md',
  direction = 'vertical',
  children,
  class: className = '',
} = Astro.props;

// Map spacing values to CSS variables
const spacingMap: Record<string, string> = {
  xs: 'var(--spacing-xs)',
  sm: 'var(--spacing-sm)',
  md: 'var(--spacing-md)',
  lg: 'var(--spacing-lg)',
  xl: 'var(--spacing-xl)',
  '2xl': 'var(--spacing-2xl)',
  '3xl': 'var(--spacing-3xl)',
  '4xl': 'var(--spacing-4xl)',
};
const gapValue = spacingMap[spacing] || spacingMap['md'];
---

<style>
  .stack {
    display: flex;
    gap: var(--stack-gap, 16px);
  }
  
  .stack.vertical {
    flex-direction: column;
  }
  
  .stack.horizontal {
    flex-direction: row;
    align-items: center;
  }
  
  /* Reverse variants */
  .stack.reverse-vertical {
    flex-direction: column-reverse;
  }
  
  .stack.reverse-horizontal {
    flex-direction: row-reverse;
  }
</style>

<div
  class:stack={true}
  class:vertical={direction === 'vertical'}
  class:horizontal={direction === 'horizontal'}
  class={className}
  style:--stack-gap={gapValue}
>
  {children}
</div>