---
// Static author data - in a real implementation, this would come from content/authors or frontmatter
const author = {
  name: 'AcaciaFund Team',
  avatar: '/avatars/acaciafund.png', // We'll use a placeholder if not exists
	bio: 'The AcaciaFund research team combines expertise in machine learning, finance, and complexity science to transform raw data into accessible research syntheses.',
  social: [
    { platform: 'twitter', url: 'https://twitter.com/acaciafund', icon: 'twitter' },
    { platform: 'github', url: 'https://github.com/acaciafund', icon: 'github' },
    { platform: 'linkedin', url: 'https://linkedin.com/company/acaciafund', icon: 'linkedin' }
  ]
};
---
<section class="author-card">
  <div class="author-avatar">
    <img src={author.avatar} alt={author.name} onError="this.onerror=null;this.src='/avatars/placeholder.png'" />
  </div>
  <div class="author-info">
    <h2>{author.name}</h2>
    <p class="author-bio">{author.bio}</p>
    <div class="author-social">
      {author.social.map(social => (
	<a key={social.platform} href={social.url} target="_blank" rel="noopener noreferrer" aria-label={`Follow on ${social.platform}`} class="social-link">
          {/* Simple placeholder icons - in practice use proper SVG icons */}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            {social.platform === 'twitter' && <path d="M22.46 6c-.77.35-1.6.58-2.46.69a4.3 4.3 0 001.88-2.37 8.56 8.56 0 01-2.7 1.04 4.3 4.3 0 00-7.3 3.92A12.08 12.08 0 012 4.72c-.38.05-.76.07-1.14.07a6.06 6.06 0 004.4 7.49 6.06 6.06 0 01-2.74-.93v.06a6.06 6.06 0 004.83 5.94 6.06 6.06 0 01-2.75.2 6.06 6.06 0 005.59 4.2c6.83 5.15 14.96 4.44 20.88-2.35a6.09 6.09 0 001.56-6" fill="currentColor"/>}
            {social.platform === 'github' && <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.205 11.387.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.41-4.043-1.41-.546-1.388-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.776.418-1.305.762-1.604-2.665-.305-5.466-1.332-5.466-5.933 0-1.311.469-2.381 1.236-3.221-.124-.302-.536-1.521.124-3.171 0 0 1.008-.322 3.3 1.23a9.588 9.588 0 012.84-.392 9.56 9.56 0 012.84.392 2.302 2.302 0 003.3-1.23.18 1.65.148 2.869.124 3.171.768.84 1.235 1.91 1.235 3.221 0 2.64-2.804 5.627-5.475 5.921.343.299.658.894.658 1.804v3.293c0 .316.22.688.826.577a11.915 11.915 0 008.205-11.387C22.374 7.373 18 0 12 0z" fill="currentColor"/>}
            {social.platform === 'linkedin' && <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.851 0-2.136 1.445-2.136 2.939v5.621H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.062-2.062c0-1.138.924-2.062 2.062-2.062s2.062.924 2.062 2.062c0 1.138-.924 2.062-2.062 2.062zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.226.792 24 1.771 24h20.451C23.227 24 24 23.226 24 22.271V1.729C24 .774 23.227 0 22.225 0z" fill="currentColor"/>}
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .author-card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    background: var(--bg-elev);
    border: 1px solid var(--card-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-top: 2.5rem;
  }
  .author-avatar {
    flex-shrink: 0;
  }
  .author-avatar img {
    width: 80px;
    height: 80px;
    border-radius: 0.5rem;
    object-fit: cover;
    border: 2px solid var(--accent-2);
  }
  .author-info {
    flex: 1;
  }
  .author-info h2 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
    color: var(--text);
  }
  .author-bio {
    margin-bottom: 1rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .author-social {
    display: flex;
    gap: 0.75rem;
  }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background: var(--muted);
    color: var(--accent-2);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .social-link:hover {
    background: var(--accent-2);
    color: var(--bg);
  }
  .author-posts {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }
  .author-posts h3 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    color: var(--text);
  }
  .author-posts ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .author-posts li {
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .author-posts li img {
    width: 40px;
    height: 40px;
    border-radius: 0.25rem;
    object-fit: cover;
  }
  .author-posts li .post-info {
    flex: 1;
  }
  .author-posts li .post-info h4 {
    margin: 0 0 0.25rem 0;
    font-size: 1rem;
    color: var(--text);
  }
  .author-posts li .post-info p {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>