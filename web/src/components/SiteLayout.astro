---
import '../styles/global.css';
import ThemeToggle from './ThemeToggle.astro';

const { title = 'AcaciaFund', description = 'Daily research portfolio', section = '', image = '' } = Astro.props;
// Detect language from URL path: if first segment is 'pl' or 'en', use that, else default to 'en'
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const lang = pathSegments.length > 0 && ['pl', 'en'].includes(pathSegments[0]) ? pathSegments[0] : 'en';
const siteUrl = 'https://acaciafund.org';
const ogImage = image ? `${siteUrl}${image}` : `${siteUrl}/images/default-og.jpg`;
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}${Astro.url.search}`} />
    <meta property="og:site_name" content="AcaciaFund" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/images/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Fuse.js for fuzzy search -->
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@6.6.2/dist/fuse.min.js"></script>
  </head>
  <body>
    <!-- Skip to content link -->
    <a href="#main-content" class="skip-to-content">Skip to main content</a>
    <!-- Reading progress bar -->
    <div id="progress-bar"></div>
    <div class="shell page">
       <header class="topbar">
         <div class="theme-toggle">
           <ThemeToggle />
         </div>
        <a class="brand" href={`/${lang}/`} aria-label="AcaciaFund home">
          <span class="brand-mark"></span>
          <span>AcaciaFund</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {/*
            Different sections have different language path structures:
            - Blog: /{lang}/blog/
            - Learn: /{lang}/learn/
            - Course, About, Research, Scholarship: /section/ (no language prefix in path)
          */}
          <a href={`/${lang}/blog/`}>Blog</a>
          <a href={`/${lang}/course/`}>Course</a>
          <a href={`/${lang}/learn/`}>Learn</a>
          <a href={`/${lang}/scholarship/`}>Scholarship</a>
          <a href={`/${lang}/research/`}>Research</a>
          <a href={`/${lang}/about/`}>About</a>
        </nav>
        <!-- Search button -->
        <button id="search-toggle" aria-label="Search" class="nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-search" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <circle cx="10.5" cy="10.5" r="7.5"/>
            <line x1="21" y1="21" x2="15" y2="15"/>
          </svg>
        </button>
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer class="footer">
        <div>AcaciaFund · static-first research and learning platform</div>
        <div class="ai-transparency">Content generated by AcaciaFund NLP system</div>
      </footer>
    </div>

    <!-- Search Overlay -->
    <div id="search-overlay" class="search-overlay" aria-hidden="true">
      <div class="search-overlay-content">
        <button id="search-close" aria-label="Close search" class="search-close">
          <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-x" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
        <div class="search-box">
          <input type="text" id="search-input" placeholder="Search posts..." autocomplete="off" />
        </div>
        <div id="search-results" class="search-results">
          <!-- Results will be injected here -->
        </div>
      </div>
    </div>

    <script>
      const toggle = document.getElementById('theme-toggle');
      const root = document.documentElement;

      // Check for saved theme or use system preference
      const currentTheme = localStorage.getItem('theme');
      const systemTheme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

      const setTheme = (theme) => {
        if (theme === 'light') {
          root.classList.add('light-theme');
        } else {
          root.classList.remove('light-theme');
        }
        localStorage.setItem('theme', theme);
      };

      // Initialize
      const initialTheme = currentTheme || systemTheme;
      setTheme(initialTheme);

      // Toggle event
      toggle.addEventListener('click', () => {
        const newTheme = root.classList.contains('light-theme') ? 'dark' : 'light';
        setTheme(newTheme);
      });
    </script>
    <script>
      // Fade-in on scroll
      const fadeElements = document.querySelectorAll('.fade-in');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1 });
      fadeElements.forEach(el => observer.observe(el));
    </script>
    <script>
      // Search functionality with Fuse.js
      const searchToggle = document.getElementById('search-toggle');
      const searchOverlay = document.getElementById('search-overlay');
      const searchClose = document.getElementById('search-close');
      const searchInput = document.getElementById('search-input');
      const searchResults = document.getElementById('search-results');

      let fuse;

      // Load search index and initialize Fuse
      async function loadSearchIndex() {
        try {
          const response = await fetch('/api/search.json');
          const searchIndex = await response.json();
          
          // Configure Fuse.js with weighted keys
          const fuseOptions = {
            keys: [
              { name: 'title', weight: 0.4 },
              { name: 'tags', weight: 0.3 },
              { name: 'summary', weight: 0.2 },
              { name: 'category', weight: 0.1 }
            ],
            includeScore: true,
            threshold: 0.4, // Adjust for fuzziness (0.0 - exact match, 1.0 - match everything)
            ignoreLocation: true
          };
          
          fuse = new Fuse(searchIndex, fuseOptions);
        } catch (e) {
          console.error('Failed to load search index:', e);
          fuse = null;
        }
      }

      // Show overlay
      function openSearch() {
        searchOverlay.setAttribute('aria-hidden', 'false');
        searchInput.value = '';
        searchResults.innerHTML = '';
        searchInput.focus();
        loadSearchIndex(); // Load index when opening (could be cached)
      }

      // Hide overlay
      function closeSearch() {
        searchOverlay.setAttribute('aria-hidden', 'true');
      }

      // Perform search using Fuse
      function performSearch() {
        const query = searchInput.value.trim();
        if (query.length < 2) {
          searchResults.innerHTML = '<p class="muted">Type at least 2 characters to search</p>';
          return;
        }

        if (!fuse) {
          searchResults.innerHTML = '<p class="muted">Loading search index...</p>';
          return;
        }

        const results = fuse.search(query);
        
        if (results.length === 0) {
          searchResults.innerHTML = '<p class="muted">No results found</p>';
          return;
        }

        // Build results HTML
        let html = '';
        results.forEach(result => {
          const post = result.item;
          html += '<a href="' + post.url + '" class="search-result-item">' +
            '<div class="search-result-title">' + post.title + '</div>' +
            '<div class="search-result-meta">' +
              '<span>' + post.category + '</span>' +
              '<span>' + post.lang.toUpperCase() + '</span>' +
            '</div>' +
            '<div class="search-result-summary">' + post.summary + '</div>' +
          '</a>';
        });
        searchResults.innerHTML = html;
      }

      // Event listeners
      searchToggle.addEventListener('click', (e) => {
        e.preventDefault();
        openSearch();
      });

      searchClose.addEventListener('click', closeSearch);
      searchOverlay.addEventListener('click', (e) => {
        if (e.target === searchOverlay) {
          closeSearch();
        }
      });

      // Close on ESC key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && searchOverlay.getAttribute('aria-hidden') === 'false') {
          closeSearch();
        }
      });

      // Search input debounce
      let debounceTimer;
      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          performSearch();
        }, 300);
      });
    </script>
    <script>
      // Sticky header hide on scroll down & progress bar
      const topbar = document.querySelector('.topbar');
      const progressBar = document.getElementById('progress-bar');
      let lastScrollY = window.pageYOffset;

      function updateScroll() {
        const scrollY = window.pageYOffset;
        const windowHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (scrollY / windowHeight) * 100;
        progressBar.style.width = scrolled + '%';

        if (scrollY > lastScrollY && scrollY > 100) {
          // scrolling down
          topbar.classList.add('hidden');
        } else {
          // scrolling up or at top
          topbar.classList.remove('hidden');
        }
        lastScrollY = scrollY;
      }

      window.addEventListener('scroll', updateScroll);
      // Initialize progress bar on load
      updateScroll();
    </script>
  </body>
</html>