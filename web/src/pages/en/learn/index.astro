---
import SiteLayout from '../components/SiteLayout.astro';
import LessonCard from '../../../components/LessonCard.astro';
import { loadLessons } from '../../../lib/content.js';

const lessons = loadLessons();
---
<SiteLayout title="Learning Hub | AcaciaFund" description="Interactive lessons and quizzes for deeper understanding." lang="en">
  <section class="section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6 order-2 order-md-1">
          <h2 class="section-title">Your personal guide to knowledge</h2>
          <p class="lead">
            Dive deeper into topics that fascinate you. Our interactive learning panel guides you through six levels of understanding—
            from basic fact recall to creative application of knowledge in new contexts. Each synthesis becomes a starting point for your own exploration.
          </p>
          <a href="/en/course/" class="btn btn-primary btn-lg px-5 py-3">Begin exploration</a>
        </div>
        <div class="col-md-6 order-1 order-md-2 mb-4 mb-md-0">
          <div class="feature-card" style="display:flex;align-items:center;justify-content:center;height:340px;">
            <!-- Keep visual element -->
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>