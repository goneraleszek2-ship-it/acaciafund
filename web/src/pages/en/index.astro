---
import SiteLayout from '../../components/SiteLayout.astro';
import PostCard from '../../components/PostCard.astro';
import LessonCard from '../components/LessonCard.astro';
import { loadHomepageData } from '../../lib/content.js';

const { registry, latestPosts, lessons } = loadHomepageData();
const latestPillars = registry.latest_by_pillar || {};
const pillarCards = [
  { id: 'aml', label: 'AML', desc: 'Compliance, financial crime and regulatory intelligence.' },
  { id: 'stock', label: 'Markets', desc: 'Semiconductors, capital markets and supply-chain signals.' },
  { id: 'science', label: 'Science', desc: 'Complex systems, cognition and frontier research.' },
];
---
<SiteLayout title="AcaciaFund | Daily Research Synthesis" description="Deterministic research synthesis and learning on a modern static+edge stack." lang="en">
  <section class="hero">
    <div class="eyebrow">Dataops-first</div>
    <h1 class="title">Your daily journey through knowledge</h1>
    <p class="lede">
      Immerse yourself in the world of discovery, where we process thousands of messages from HackerNews and arXiv daily,
      transforming them into accessible lessons that spark curiosity and inspire action.
    </p>
    <div class="actions">
      <a class="button primary" href="/en/blog/">Begin the adventure</a>
      <a class="button" href="/en/blog/">See the latest discoveries</a>
    </div>
  </section>

  <section class="section pillars">
    {pillarCards.map((pillar) => (
      <article class="card pillar-card">
        <div class="kicker">{pillar.label}</div>
        <h3>{pillar.desc}</h3>
        <p class="muted">Latest bundle: {latestPillars[pillar.id] || 'pending'}</p>
      </article>
    ))}
  </section>

  <section class="section">
    <div class="card">
      <div class="kicker">Latest Insights from the Knowledge Frontier</h2>
      <p class="text-center text-muted mb-5">
        Explore the most recent syntheses that connect insights across disciplines into a coherent narrative about how our world is evolving.
      </p>
      <div class="grid cols-3" style="margin-top: 16px;">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section grid cols-2">
    <div class="card">
      <div class="kicker">Your personal guide to knowledge</h2>
      <p class="lead">
        Dive deeper into topics that fascinate you. Our interactive learning panel guides you through six levels of understanding—
        from basic fact recall to creative application of knowledge in new contexts. Each synthesis becomes a starting point for your own exploration.
      </p>
      <a href="/en/course/" class="btn btn-primary btn-lg px-5 py-3">Begin exploration</a>
    </div>
    <div class="card" style="display:flex;align-items:center;justify-content:center;height:340px;">
      <div class="feature-card" style="display:flex;align-items:center;justify-content:center;height:340px;">
        <!-- We'll keep the image reference for now -->
      </div>
    </div>
  </section>
</SiteLayout>