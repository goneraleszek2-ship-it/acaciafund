---
import SiteLayout from '../components/SiteLayout.astro';
import PostCard from '../components/PostCard.astro';
import LessonCard from '../components/LessonCard.astro';
import { loadHomepageData } from '../lib/content.js';

const { registry, latestPosts, lessons } = loadHomepageData();
const latestPillars = registry.latest_by_pillar || {};
const pillarCards = [
  { id: 'aml', label: 'AML', desc: 'Compliance, financial crime and regulatory intelligence.' },
  { id: 'stock', label: 'Markets', desc: 'Semiconductors, capital markets and supply-chain signals.' },
  { id: 'science', label: 'Science', desc: 'Complex systems, cognition and frontier research.' },
];
---
<SiteLayout title="AcaciaFund | Daily Research Portfolio" description="Deterministic research synthesis and learning on a modern static+edge stack.">
  <section class="hero">
    <div class="eyebrow">Dataops-first</div>
    <h1 class="title">Daily synthesis for AML, markets and science.</h1>
    <p class="lede">AcaciaFund turns HN and arXiv into structured research, with metadata, manifests, and local-first learning. This Astro version is the clean cutover path from Hugo to a smaller, more reliable deployment model.</p>
    <div class="actions">
      <a class="button primary" href="/blog/">Explore synthesis</a>
      <a class="button" href="/learn/">Open learning hub</a>
      <a class="button" href="/course/">See course map</a>
    </div>
  </section>

  <section class="section pillars">
    {pillarCards.map((pillar) => (
      <article class="card pillar-card">
        <div class="kicker">{pillar.label}</div>
        <h3>{pillar.desc}</h3>
        <p class="muted">Latest bundle: {latestPillars[pillar.id] || 'pending'}</p>
      </article>
    ))}
  </section>

  <section class="section">
    <div class="card">
      <div class="kicker">Latest syntheses</div>
      <div class="grid cols-3" style="margin-top: 16px;">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section grid cols-2">
    <div class="card">
      <div class="kicker">Learning</div>
      <h2>Local-first lessons</h2>
      <div class="grid" style="margin-top: 16px;">
        {lessons.slice(0, 3).map((lesson) => <LessonCard lesson={lesson} />)}
      </div>
    </div>
    <div class="card">
      <div class="kicker">Registry</div>
      <h2>Run and content metadata</h2>
      <div class="stacked">
        <div class="list-item">Runs: {registry.counts?.runs || 0}</div>
        <div class="list-item">Pages: {registry.counts?.pages || 0}</div>
        <div class="list-item">Latest run: {registry.latest_run_id || 'n/a'}</div>
      </div>
    </div>
  </section>
</SiteLayout>
