---
import SiteLayout from '../../components/SiteLayout.astro';
import { loadBlogPosts, getBlogPost } from '../../lib/content.js';

export async function getStaticPaths() {
  return loadBlogPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---
<SiteLayout title={`${post.title} | AcaciaFund`} description={post.summary} lang={post.lang}>
  <article class="section article card">
    <div class="eyebrow">{post.category}</div>
    <h1 class="title" style="font-size: clamp(2.2rem, 4vw, 4rem); max-width: 20ch;">{post.title}</h1>
    <div class="meta">
      <span>{post.date}</span>
      <span>{post.category}</span>
      <span>{post.tags.join(' · ')}</span>
    </div>
    {post.imageUrl ? <img src={post.imageUrl} alt={post.title} loading="lazy" /> : null}
    <div class="prose" set:html={post.html} />
  </article>
</SiteLayout>
