---
import SiteLayout from '../../../components/SiteLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { loadBlogPosts } from '../../../lib/content.js';

const posts = loadBlogPosts();
---
<SiteLayout title="Ostatnie syntezy | AcaciaFund" description="Przeglądaj najnowsze badania i analizy." lang="pl">
  <section class="section">
    <div class="container">
      <div class="row align-items-start">
        <div class="col-12">
          <h2 class="section-title">Ostatnie odkrycia z pogranicza wiedzy</h2>
          <p class="text-center text-muted mb-5">
            Przeglądaj najnowsze syntezy, które łączą wiedzę z różnych dziedzin w spójną narrację o tym, jak świat się zmienia.
          </p>
        </div>
      </div>
      <div class="row gy-4">
        {posts.slice(0, 3).map((post) => <PostCard post={post} />)}
      </div>
      <div class="row">
        <div class="col-12 text-center">
          <a href="/pl/blog/" class="btn btn-outline-primary btn-lg px-5 py-3">Zobacz wszystkie odkrycia</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>