{{ $allPosts := where site.RegularPages "Section" "blog" }}
{{ $aml := where $allPosts "Params.categories" "intersect" (slice "AML") }}
{{ $markets := where $allPosts "Params.categories" "intersect" (slice "Markets") }}
{{ $science := where $allPosts "Params.categories" "intersect" (slice "Science") }}
{{ $recent := first 10 $allPosts.ByDate.Reverse }}
{
  "site": {
    "title": {{ site.Title | jsonify }},
    "url": {{ site.BaseURL | jsonify }},
    "language": {{ site.Language.Lang | jsonify }},
    "buildDate": {{ now.Format "2006-01-02T15:04:05Z07:00" | jsonify }}
  },
  "stats": {
    "totalPosts": {{ len $allPosts }},
    "pillars": {
      "AML": { "count": {{ len $aml }} },
      "Markets": { "count": {{ len $markets }} },
      "Science": { "count": {{ len $science }} }
    }
  },
  "recentPosts": [
    {{ range $i, $p := $recent }}{{ if $i }},{{ end }}
    {
      "title": {{ $p.Title | jsonify }},
      "url": {{ $p.RelPermalink | jsonify }},
      "date": {{ $p.PublishDate.Format "2006-01-02" | jsonify }},
      "category": {{ with $p.Params.categories }}{{ (index . 0) | jsonify }}{{ else }}""{{ end }},
      "sqi": {{ $p.Params.sqi | default 0 | jsonify }}
    }
    {{ end }}
  ]
}
