[{{ range $i, $p := (where site.RegularPages "Type" "post") }}{{ if $i }},{{ end }}
{
  "title": {{ $p.Title | jsonify }},
  "url": {{ $p.Permalink | jsonify }},
  "date": {{ $p.PublishDate.Format "2006-01-02" | jsonify }},
  "category": {{ with $p.Params.categories }}{{ (index . 0) | jsonify }}{{ else }}""{{ end }},
  "description": {{ $p.Params.description | default "" | jsonify }},
  "content": {{ $p.Plain | truncate 500 | jsonify }}
}{{ end }}]
